# Phase 9.2b: the object store's write-ahead log persisted on the Incudela partition. The log is one Incudela FS
# file, objects.log (OD_NB blocks, reserved zero-filled); each commit writes the log blocks it dirtied and
# flushes before returning, so a returned commit is durable. Mount replays the log (obj.cudi ob_replay),
# drops a torn or corrupt tail and zeroes it on disk so later appends can never revive stale records.
# Only Incudela FS calls are used, so every write stays inside the explicitly created Incudela partition.
# Phase 10.1: every log block is encrypted at rest and authenticated, encrypt-then-MAC: ChaCha20 under the
# enc key with nonce = (64-bit write counter, block number), then a full 256-bit HMAC-SHA256 under the
# separate MAC key over (block, counter, ciphertext), compared in constant time (crypt.cudi ct_eq4). Enc and
# MAC keys are HMAC-derived from the random per-user data key, which is stored only wrapped by the user
# key (objects.key). The write counter is never reused, across reboots, torn writes, rewinds and
# tampering: it only grows, and a high-water mark reserved ahead of use is made durable in objects.ctr
# (two HMAC-tagged slots) before any counter beyond it is used. Each logical block alternates between two
# physical slots so a torn write never destroys the previous contents. See docs/privacy.md.
OD_PW = 507  # payload words per logical log block; word 507 = write counter, 508..511 = HMAC-SHA256 tag
OD_WRES = 4096  # counters reserved per objects.ctr update
OD_CMAGIC = 0x52544345474F46  # "FOGECTR"
OD_NB = (OB_NL + OD_PW - 1) / OD_PW  # logical log blocks; each has two physical slots (A/B)
OD_UID = 1000  # the store owner (one user per store)
OD_KMAGIC = 0x59454B4547524F46  # "FORGEKEY"
# key slot v2 (inv228), objects.key words 16..19: OD_KVER, the 128-bit KDF salt, the iteration count. A v1 slot
# (made before inv228) has zeros there and the unsalted KEK; it still unlocks (od_kek_legacy).
OD_KVER = 2
OD_KDF_ITERS = 20000  # PBKDF2 iterations for a new slot (stored in the slot, so a later raise keeps old slots)
OD_KDF_MAX = 0x1000000  # a slot asking for more (or 0) is refused as damaged
od_uk: u8[64]  # the passphrase from fw_cfg, wiped once od_kek is derived
od_ukn: u64
od_nk: u8[64]  # a new passphrase from fw_cfg opt/forge/newkey (inv229), wiped with od_uk
od_nkn: u64
od_kchg: u64  # the last open changed the passphrase (inv229)
od_kg0: u64  # generation of the slot the last open unlocked
od_kc0: u64  # the copy it was in (0 = objects.key, 1 = objects.keyb)
od_kv0: u64  # its slot version (1 legacy, 2 PBKDF2)
od_kup: u64  # the last open upgraded a v1 slot to v2 (inv229)
od_kver: u64  # key slot version of the last create or unlock (1 legacy, 2 PBKDF2)
od_kiter: u64  # its PBKDF2 iterations
od_kdf_tsc: u64  # TSC ticks the last PBKDF2 took
od_st: u64
od_synced: u64
od_torn: u64
od_commits: u64
od_wc: u64  # last write counter used (never reused: it is part of every block's nonce)
od_cs: u8[OD_NB]  # current valid slot per logical block
od_kek: u64[8]  # key-encryption key (the platform key; TPM sealing is not implemented; never stored)
od_dk: u64[8]  # the store's data key (random, stored only wrapped by od_kek)
od_ek: u64[8]  # ChaCha20 key derived from od_dk
od_mk: u64[8]  # tag key derived from od_dk
od_t: u64[8]  # kdf output
od_pool: u64[8]  # od_key_new: the entropy pool digest (a PRF key, wiped after use)
od_ksrc: u64  # 0 none, 1 TPM, 2 fw_cfg platform key
od_badtag: u64  # slots rejected (torn, never written, or tampered) at the last open
od_hwm: u64  # durable counter high-water mark: no counter above it has been used
od_cst: u64  # objects.ctr first block
od_hs: u64  # current objects.ctr slot
od_rawmax: u64  # highest counter seen in any slot at open, verified or not
od_tv: u64[4]  # computed tag
od_tr: u64[4]  # stored tag

# ---- user key: TPM-sealed when a TPM is present, else QEMU fw_cfg "opt/forge/userkey" ----
def od_tpm_present() -> u64:
# TPM 2.0 sealing is not implemented: no TPM device is attached in any test configuration
    return 0

def od_fwcfg_key(w: u64) -> u64:
# w = 0: read fw_cfg file opt/forge/userkey (8..64 bytes) into od_uk; 0 if absent. od_kek is derived from it once
# the key slot (new or on disk) gives the KDF: od_kek_pbkdf2, or od_kek_legacy for a v1 slot.
# w = 1 (inv229): opt/forge/newkey into od_nk, the new passphrase of a passphrase change
# w = 2 (inv231): opt/forge/rotatedk into od_rk, a data-key rotation request
    pio_add(0x510, 2)
    pio_wr(0x510, 2, 0)
    if pio_rd(0x511, 1) != 81 or pio_rd(0x511, 1) != 69 or pio_rd(0x511, 1) != 77 or pio_rd(0x511, 1) != 85:
        return 0
    pio_wr(0x510, 2, 0x19)
    n: u64 = 0
    i: u64 = 0
    while i < 4:
        n = (n << 8) | pio_rd(0x511, 1)
        i += 1
    nm: u8[56]
    sel: u64 = 0
    sz: u64 = 0
    e: u64 = 0
    while e < n and e < 256:
        es: u64 = 0
        i = 0
        while i < 4:
            es = (es << 8) | pio_rd(0x511, 1)
            i += 1
        ec = (pio_rd(0x511, 1) << 8) | pio_rd(0x511, 1)
        pio_rd(0x511, 1)
        pio_rd(0x511, 1)
        i = 0
        while i < 56:
            nm[i] = u8(pio_rd(0x511, 1))
            i += 1
        v: u64[3]
        v[0] = 0
        v[1] = 0
        v[2] = 0
        i = 0
        while i < 24:
            v[i / 8] = v[i / 8] | (u64(nm[i]) << ((i % 8) * 8))
            i += 1
        same: u64 = 0
        if w == 0 and v[0] == 0x67726F662F74706F and v[1] == 0x656B726573752F65 and v[2] == 0x79:
            same = 1
        if w == 1 and v[0] == 0x67726F662F74706F and v[1] == 0x79656B77656E2F65 and v[2] == 0:
            same = 1
        if w == 2 and v[0] == 0x67726F662F74706F and v[1] == 0x657461746F722F65 and v[2] == 0x6B64:
            same = 1
        if same == 1 and sel == 0:
            sel = ec
            sz = es
        e += 1
    if sel == 0 or sz < 8 or sz > 64:
        return 0
    pio_wr(0x510, 2, sel)
    i = 0
    while i < 64:
        c: u64 = 0
        if i < sz:
            c = pio_rd(0x511, 1)
        if w == 0:
            od_uk[i] = u8(c)
        elif w == 1:
            od_nk[i] = u8(c)
        else:
            od_rk[i] = u8(c)
        i += 1
    if w == 0:
        od_ukn = sz
    elif w == 1:
        od_nkn = sz
    else:
        od_rkn = sz
    return 1

def od_uk_wipe():
# the passphrases are needed only to derive od_kek
    i: u64 = 0
    while i < 64:
        od_uk[i] = u8(0)
        od_nk[i] = u8(0)
        od_rk[i] = u8(0)
        i += 1
    od_ukn = 0
    od_nkn = 0
    od_rkn = 0

def od_kek_legacy():
# key slot v1 (before inv228): KEK = SHA-256("frge-kek" || passphrase), no salt, one hash
    sh_init()
    sh_u64(0x6B656B2D65677266)  # "frge-kek" domain label
    i: u64 = 0
    while i < od_ukn:
        sh_byte(u64(od_uk[i]))
        i += 1
    sh_fin()
    i = 0
    while i < 8:
        od_kek[i] = od_be(sh_h[i])
        i += 1

def od_kek_pbkdf2(ks0: u64, ks1: u64, c: u64):
# key slot v2 (inv228): KEK = PBKDF2-HMAC-SHA256(passphrase, 128-bit salt ks0 || ks1 little-endian, c iterations)
    i: u64 = 0
    while i < 64:
        hm_k[i] = od_uk[i]
        i += 1
    i = 0
    while i < 8:
        pb_s[i] = u8((ks0 >> (i * 8)) & 255)
        pb_s[8 + i] = u8((ks1 >> (i * 8)) & 255)
        i += 1
    pb_sn = 16
    t0 = rdtsc()
    pb_kdf(c)
    od_kdf_tsc = rdtsc() - t0
    i = 0
    while i < 8:
        od_kek[i] = od_be(pb_out[i])
        i += 1
    pb_wipe()

def od_be(v: u64) -> u64:
# a SHA-256 output word (big-endian) as a little-endian key word
    return ((v >> 24) & 255) | (((v >> 16) & 255) << 8) | (((v >> 8) & 255) << 16) | ((v & 255) << 24)

def od_kdf(k: u64[8], label: u64, salt0: u64, salt1: u64):
# od_t = HMAC-SHA256(k, label || salt) (an HKDF-Expand style PRF; distinct labels give independent keys)
    hm_setkey32(k)
    hm_begin()
    sh_u64(label)
    sh_u64(salt0)
    sh_u64(salt1)
    hm_end()
    i: u64 = 0
    while i < 8:
        od_t[i] = od_be(sh_h[i])
        i += 1

def od_kswap():
# exchange the working keys (od_ek, od_mk) with the old ones of a rotation (od_ek1, od_mk1)
    i: u64 = 0
    while i < 8:
        t = od_ek[i]
        od_ek[i] = od_ek1[i]
        od_ek1[i] = t
        t = od_mk[i]
        od_mk[i] = od_mk1[i]
        od_mk1[i] = t
        i += 1

def od_keys_from_dk():
    od_kdf(od_dk, 0x636E65, 0, 0)  # "enc"
    i: u64 = 0
    while i < 8:
        od_ek[i] = od_t[i]
        i += 1
    od_kdf(od_dk, 0x63616D, 0, 0)  # "mac"
    i = 0
    while i < 8:
        od_mk[i] = od_t[i]
        i += 1

# ---- data key entropy (inv228): CPU RNG words mixed into the TSC jitter pool ----
OD_HWN = 32  # RDSEED and RDRAND words each, when the CPU has them
od_rs: u64  # RDSEED words mixed into the last new data key
od_rr: u64  # RDRAND words mixed in
od_rbad: u64  # CPU RNG results refused (no value within hw_rand's retries, 0, all ones, or a repeat)

def od_hw_caps() -> u64:
# bit 0 RDRAND (CPUID.1:ECX[30]), bit 1 RDSEED (CPUID.(7,0):EBX[18])
    cpuid4(1, 0)
    c = (u64(cpuid_out[2]) >> 30) & 1
    return c | (((cpu_feat7b >> 18) & 1) << 1)

def od_hw_mix(kind: u64, site: u64, prev: u64) -> u64:
# one CPU RNG word into the SHA-256 pool (through the nondeterminism hook, like the jitter samples); a missing,
# stuck (0, all ones) or repeated value is refused and counted, never mixed. Returns the value, 0 if refused.
    v = hw_rand(kind)
    if hw_rand_ok == 0 or v == 0 or v == 0xFFFFFFFFFFFFFFFF or v == prev:
        od_rbad += 1
        return 0
    sh_u64(nd_rand(site, v))
    return v

def od_hw_pool():
# up to OD_HWN RDSEED words (conditioned seed, the stronger source) and OD_HWN RDRAND words into the pool
    od_rs = 0
    od_rr = 0
    od_rbad = 0
    caps = od_hw_caps()
    ps: u64 = 0
    pr: u64 = 0
    k: u64 = 0
    while k < OD_HWN:
        if (caps & 2) != 0:
            v = od_hw_mix(1, 5, ps)
            if v != 0:
                od_rs += 1
                ps = v
        if (caps & 1) != 0:
            v = od_hw_mix(0, 6, pr)
            if v != 0:
                od_rr += 1
                pr = v
        k += 1

def od_mkfile(name: ptr[u8], nb: u64) -> u64:
# reserve a zero-filled nb-block Incudela FS file; its first block (0 on failure)
    if ffs_ok == 0 or ffs_find(name) != FFS_NI:
        return 0
    slot: u64 = 0
    while slot < FFS_NI and ffs_it[slot * 8] != 0:
        slot += 1
    if slot == FFS_NI:
        return 0
    st = ffs_alloc(nb)
    if st == 0:
        return 0
    i: u64 = 0
    while i < 512:
        ffs_b[i] = 0
        i += 1
    b: u64 = 0
    while b < nb:
        if ffs_put(st + b, 0) == 0:
            return 0
        b += 1
    if nvme_flush() == 0:
        return 0
    ffs_pack(name)
    k = slot * 8
    i = 0
    while i < 5:
        ffs_it[k + i] = ffs_nm[i]
        i += 1
    ffs_it[k + 5] = nb * 4096
    ffs_it[k + 6] = st
    ffs_it[k + 7] = nb
    if ffs_commit() == 0:
        return 0
    return st

# ---- the key file: two copies (inv229) ----
# objects.key and objects.keyb each hold one copy of the key slot (words 0..27 of their one block). A slot written
# since inv229 carries a generation (word 20) and a SHA-256 of its bytes 0..191 (words 24..27, torn-write and
# corruption detection, not a MAC: the check value authenticates the key). A rewrite goes first to the copy
# that is not current and is flushed before the other copy is touched, so a crash at any point leaves one
# intact copy of either the old or the new slot, never only a torn one. At unlock the intact copy with the
# higher generation is current (an older copy is superseded: its key is not tried), and a missing, torn or
# older other copy is rewritten from it.
OD_KW = 36  # slot words in each copy (28..35: the old data key while a rotation runs, inv231)
OD_KG = 20  # generation word; 0 on slots written before inv229 (words 20..27 zero)
OD_KH = 24  # words 24..27: SHA-256 of slot bytes 0..191
od_ka: u64[36]  # copy A (objects.key) as read at the last open
od_kb: u64[36]  # copy B (objects.keyb)
od_kn: u64[36]  # the current slot (unlocked, or being written)
od_kast: u64  # objects.key block (0 if absent)
od_kbst: u64  # objects.keyb block (0 if absent)
od_kcur: u64  # copy holding the current slot: 0 = objects.key, 1 = objects.keyb
od_krep: u64  # the last open rewrote the other copy: 0 no, 1 it was older or damaged, 2 it was missing
# ---- data-key rotation (inv231) ----
# A rotating slot (word 21 = 1) wraps the NEW data key in words 4..11 and the OLD one in words 28..35
# (DK_old XOR HMAC(KEK, "odk" || wrap salt)); its SHA-256 also covers bytes 224..287. While a slot is rotating,
# a log or counter slot verifies under either data key, and every log block is rewritten under the new one;
# then the slot drops the old key (word 21 = 0). A crash anywhere leaves a store that opens and resumes.
OD_KR = 21  # rotation word: 0 none, 1 rotating
OD_KO = 28  # words 28..35: the old data key, wrapped
od_rot: u64  # the unlocked slot is rotating: od_dk1/od_ek1/od_mk1 hold the old keys
od_dk1: u64[8]
od_ek1: u64[8]
od_mk1: u64[8]
od_lk: u64  # the key the last od_slot_wc verified under: 0 the current (new) one, 1 the old one
od_rk: u8[64]  # fw_cfg opt/forge/rotatedk ("rotate-data-key", optionally ":stop-after:N")
od_rkn: u64
od_rotr: u64  # why the last open rotated: 0 not, 1 operator request, 2 pre-fix data key, 3 resumed
od_rotb: u64  # log blocks it re-encrypted
od_rots: u64  # 1 + the block count it stopped after (rotatedk stop-after), 0 if it did not stop
od_rold: u64  # the last open found a rotating slot
od_wk: u64  # the pre-fix data key check (inv231): 0 not run (rotating slot), 1 independent key, 2 pre-fix key
od_wst: u64  # its detector self-test: 1 passed, 0 failed (then a flagged key is not rotated)

def od_kh(s: u64[36]):
# od_tv = SHA-256 of the slot's bytes 0..191 (words 0..23, little-endian), then bytes 224..287 (the old data
# key) if the slot is rotating, as four words
    sh_init()
    i: u64 = 0
    while i < OD_KH:
        sh_u64(s[i])
        i += 1
    if s[OD_KR] != 0:
        i = OD_KO
        while i < OD_KO + 8:
            sh_u64(s[i])
            i += 1
    sh_fin()
    i = 0
    while i < 8:
        od_t[i] = od_be(sh_h[i])
        i += 1
    i = 0
    while i < 4:
        od_tv[i] = od_t[i * 2] | (od_t[i * 2 + 1] << 32)
        i += 1

def od_kintact(s: u64[36]) -> u64:
# 1 if the copy is a whole slot: magic, owner, and the SHA-256 over its bytes (or words 20..35 all 0 for a
# slot from before inv229, which has no generation or hash)
    if s[0] != OD_KMAGIC or s[1] != OD_UID:
        return 0
    z: u64 = 0
    i: u64 = OD_KG
    while i < OD_KW:
        z = z | s[i]
        i += 1
    if z == 0:
        return 1
    od_kh(s)
    i = 0
    while i < 4:
        od_tr[i] = s[OD_KH + i]
        i += 1
    return ct_eq4(od_tv, od_tr)

def od_kread(name: ptr[u8], w: u64) -> u64:
# the file's block (0 if the file is absent); copy w (0 = od_ka, 1 = od_kb) = its first OD_KW words (all 0 if
# absent or unreadable). (Array parameters are copies, so the copy is named, not passed.)
    i: u64 = 0
    while i < 512:
        ffs_b[i] = 0
        i += 1
    st: u64 = 0
    f = ffs_find(name)
    if f != FFS_NI and ffs_it[f * 8 + 7] >= 1:
        st = ffs_it[f * 8 + 6]
        if ffs_get(st, 0) == 0:
            i = 0
            while i < 512:
                ffs_b[i] = 0
                i += 1
    i = 0
    while i < OD_KW:
        if w == 0:
            od_ka[i] = ffs_b[i]
        else:
            od_kb[i] = ffs_b[i]
        i += 1
    return st

def od_kput(st: u64, s: u64[36]) -> u64:
# write one copy and flush it
    i: u64 = 0
    while i < 512:
        ffs_b[i] = 0
        i += 1
    i = 0
    while i < OD_KW:
        ffs_b[i] = s[i]
        i += 1
    if ffs_put(st, 0) == 0 or nvme_flush() == 0:
        return 0
    return 1

def od_kset(w: u64):
# copy w (0 = od_ka, 1 = od_kb) = od_kn
    i: u64 = 0
    while i < OD_KW:
        if w == 0:
            od_ka[i] = od_kn[i]
        else:
            od_kb[i] = od_kn[i]
        i += 1

def od_kget(w: u64):
# od_kn = copy w
    i: u64 = 0
    while i < OD_KW:
        if w == 0:
            od_kn[i] = od_ka[i]
        else:
            od_kn[i] = od_kb[i]
        i += 1

def od_ksame(a: u64[36], b: u64[36]) -> u64:
    d: u64 = 0
    i: u64 = 0
    while i < OD_KW:
        d = d | (a[i] ^ b[i])
        i += 1
    if d == 0:
        return 1
    return 0

def od_key_store() -> u64:
# make od_kn (its generation already set) current: hash it, write the copy that is not current and flush,
# then the other copy. objects.keyb is created first if it does not exist yet
    od_kh(od_kn)
    i: u64 = 0
    while i < 4:
        od_kn[OD_KH + i] = od_tv[i]
        i += 1
    if od_kbst == 0:
        od_kbst = od_mkfile("objects.keyb", 1)
        if od_kbst == 0:
            return 0
    if od_kcur == 0:
        if od_kput(od_kbst, od_kn) == 0:
            return 0
        od_kset(1)
        od_kcur = 1
        if od_kput(od_kast, od_kn) == 0:
            return 0
        od_kset(0)
    else:
        if od_kput(od_kast, od_kn) == 0:
            return 0
        od_kset(0)
        od_kcur = 0
        if od_kput(od_kbst, od_kn) == 0:
            return 0
        od_kset(1)
    return 1

def od_key_fix() -> u64:
# after an unlock: rewrite the other copy from the current one if it is missing, damaged or older
    od_krep = 0
    if od_kcur == 0:
        if od_kbst != 0 and od_ksame(od_kb, od_kn) != 0:
            return 1
        od_krep = 1
        if od_kbst == 0:
            od_krep = 2
            od_kbst = od_mkfile("objects.keyb", 1)
            if od_kbst == 0:
                return 0
        if od_kput(od_kbst, od_kn) == 0:
            return 0
        od_kset(1)
        return 1
    if od_ksame(od_ka, od_kn) != 0:
        return 1
    od_krep = 1
    if od_kput(od_kast, od_kn) == 0:
        return 0
    od_kset(0)
    return 1

def od_pool_new():
# od_pool = SHA-256 of 512 TSC jitter samples and the CPU RNG words of od_hw_pool (inv228): a PRF key for fresh
# key material, wiped by the caller after use
    sh_init()
    i: u64 = 0
    while i < 512:
        t0 = rdtsc()
        j: u64 = 0
        while j < (t0 & 15):
            j += 1
        sh_u64(nd_rand(4, rdtsc() - t0))
        sh_u64(t0)
        i += 1
    od_hw_pool()
    sh_fin()
    i = 0
    while i < 8:
        od_pool[i] = od_be(sh_h[i])
        i += 1

def od_pool_wipe():
    i: u64 = 0
    while i < 8:
        od_pool[i] = 0
        i += 1

def od_slot_build(gen: u64) -> u64:
# od_kn = a v2 slot of generation gen wrapping od_dk under a passphrase KEK with fresh salts from od_pool
# (od_uk must hold the passphrase); the caller stores it with od_key_store. Returns the KDF salt's first word
    od_kdf(od_pool, 0x746C617377, 0, 0)  # "wsalt"
    s0 = od_t[0] | (od_t[1] << 32)
    s1 = od_t[2] | (od_t[3] << 32)
    od_kdf(od_pool, 0x746C61736B, 0, 0)  # "ksalt": the passphrase KDF salt, independent of DK and the wrap salt
    ks0 = od_t[0] | (od_t[1] << 32)
    ks1 = od_t[2] | (od_t[3] << 32)
    od_kek_pbkdf2(ks0, ks1, OD_KDF_ITERS)
    od_kver = OD_KVER
    od_kiter = OD_KDF_ITERS
    i: u64 = 0
    while i < OD_KW:
        od_kn[i] = 0
        i += 1
    od_kn[0] = OD_KMAGIC
    od_kn[1] = OD_UID
    od_slot_wrap(s0, s1)
    od_kn[16] = OD_KVER
    od_kn[17] = ks0
    od_kn[18] = ks1
    od_kn[19] = OD_KDF_ITERS
    od_kn[OD_KG] = gen
    if od_rot != 0:
        od_slot_rot()
    return ks0

def od_slot_wrap(s0: u64, s1: u64):
# od_kn words 2..15 = wrap salt s0, s1, od_dk wrapped under od_kek with it, and the key check value
    od_kn[2] = s0
    od_kn[3] = s1
    od_kdf(od_kek, 0x70617277, s0, s1)  # "wrap"
    i: u64 = 0
    while i < 8:
        od_kn[4 + i] = od_dk[i] ^ od_t[i]
        i += 1
    od_kdf(od_kek, 0x6B6863, s0, s1)  # "chk": a 256-bit key check value
    i = 0
    while i < 4:
        od_kn[12 + i] = od_t[i * 2] | (od_t[i * 2 + 1] << 32)
        i += 1

def od_slot_rot():
# mark od_kn rotating: words 28..35 = od_dk1 (the old data key) wrapped under od_kek with the slot's wrap salt
    od_kdf(od_kek, 0x6B646F, od_kn[2], od_kn[3])  # "odk"
    i: u64 = 0
    while i < 8:
        od_kn[OD_KO + i] = od_dk1[i] ^ od_t[i]
        i += 1
    od_kn[OD_KR] = 1

def od_key_new() -> u64:
# first mount: a random data key, stored only wrapped by the user key, in both copies of the key file
# (generation 1). The pool digest is only a PRF key: the data key, the wrap salt and the KDF salt are
# independent HMAC outputs of it. (Before inv228 the salt was digest words 0..3 and the data key mixed the same
# words with words 4..7, so the plaintext salt in objects.key left the data key only 128 unknown bits.)
    od_kast = od_mkfile("objects.key", 1)
    if od_kast == 0:
        return 0
    od_kbst = od_mkfile("objects.keyb", 1)
    if od_kbst == 0:
        return 0
    od_pool_new()
    od_kdf(od_pool, 0x79656B64, 0, 0)  # "dkey"
    i: u64 = 0
    while i < 8:
        od_dk[i] = od_t[i]
        i += 1
    od_slot_build(1)
    od_pool_wipe()
    od_kcur = 1
    od_krep = 0
    if od_key_store() == 0:
        return 0
    od_kg0 = od_kn[OD_KG]
    od_kc0 = od_kcur
    od_keys_from_dk()
    return 1

def od_key_load() -> u64:
# 1 = data key unwrapped (and the other copy repaired), 3 = wrong user key / no intact or a bad or unknown
# key slot, 0 = the repair write failed
    od_kast = od_kread("objects.key", 0)
    od_kbst = od_kread("objects.keyb", 1)
    ia: u64 = 0
    ib: u64 = 0
    if od_kast != 0:
        ia = od_kintact(od_ka)
    if od_kbst != 0:
        ib = od_kintact(od_kb)
    if ia == 0 and ib == 0:
        return 3
    od_kcur = 0
    if ib != 0 and (ia == 0 or od_kb[OD_KG] > od_ka[OD_KG]):
        od_kcur = 1
    od_kget(od_kcur)
    # the KDF the slot names: v2 = PBKDF2 with its own salt and iteration count, v1 (all four words 0) = legacy;
    # anything else is a damaged or unknown slot and stays locked
    if od_kn[16] == OD_KVER and od_kn[19] != 0 and od_kn[19] <= OD_KDF_MAX:
        od_kver = OD_KVER
        od_kiter = od_kn[19]
        od_kek_pbkdf2(od_kn[17], od_kn[18], od_kiter)
    elif od_kn[16] == 0 and od_kn[17] == 0 and od_kn[18] == 0 and od_kn[19] == 0:
        od_kver = 1
        od_kiter = 0
        od_kek_legacy()
    else:
        return 3
    s0 = od_kn[2]
    s1 = od_kn[3]
    od_kdf(od_kek, 0x6B6863, s0, s1)
    k: u64 = 0
    while k < 4:
        od_tv[k] = od_t[k * 2] | (od_t[k * 2 + 1] << 32)
        od_tr[k] = od_kn[12 + k]
        k += 1
    if ct_eq4(od_tv, od_tr) == 0:
        return 3
    if od_kn[OD_KR] > 1:
        return 3
    od_rot = od_kn[OD_KR]
    od_rold = od_rot
    if od_rot != 0:
        od_kdf(od_kek, 0x6B646F, s0, s1)  # "odk": the old data key of a rotation in progress
        k = 0
        while k < 8:
            od_dk[k] = od_kn[OD_KO + k] ^ od_t[k]
            od_dk1[k] = od_dk[k]
            k += 1
        od_keys_from_dk()
        od_kswap()
    od_kdf(od_kek, 0x70617277, s0, s1)
    k = 0
    while k < 8:
        od_dk[k] = od_kn[4 + k] ^ od_t[k]
        k += 1
    od_keys_from_dk()
    od_kg0 = od_kn[OD_KG]
    od_kc0 = od_kcur
    od_kv0 = od_kver
    if od_key_fix() == 0:
        return 0
    od_kchg = 0
    od_kup = 0
    # passphrase change: the same data key, wrapped under the new passphrase with fresh salts, as the next
    # generation in both copies; once the first copy is flushed, the old passphrase opens nothing
    if od_fwcfg_key(1) != 0:
        i = 0
        while i < 64:
            od_uk[i] = od_nk[i]
            i += 1
        od_ukn = od_nkn
        od_pool_new()
        od_slot_build(od_kn[OD_KG] + 1)
        od_pool_wipe()
        if od_key_store() == 0:
            return 0
        od_kchg = 1
    elif od_kv0 == 1:
        od_pool_new()  # v1 (unsalted KEK) -> v2 at the first unlock: the same DK, PBKDF2 of the same passphrase
        od_slot_build(od_kn[OD_KG] + 1)
        od_pool_wipe()
        if od_key_store() == 0:
            return 0
        od_kup = 1
    return 1

# ---- encrypted, tagged log blocks ----
def od_mac_end():
# finish the HMAC and leave the 256-bit tag in od_tv
    hm_end()
    i: u64 = 0
    while i < 4:
        od_tv[i] = (sh_h[i * 2] << 32) | sh_h[i * 2 + 1]
        i += 1

def od_tag(b: u64, wc: u64):
# od_tv = HMAC-SHA256(od_mk, block || counter || ciphertext words 0..OD_PW-1 in ffs_b)
    hm_setkey32(od_mk)
    hm_begin()
    sh_u64(b)
    sh_u64(wc)
    i: u64 = 0
    while i < OD_PW:
        sh_u64(ffs_b[i])
        i += 1
    od_mac_end()

def od_tag_ok(at: u64) -> u64:
# constant-time compare of od_tv with the tag stored at ffs_b[at..at+3]
    i: u64 = 0
    while i < 4:
        od_tr[i] = ffs_b[at + i]
        i += 1
    return ct_eq4(od_tv, od_tr)

# ---- objects.ctr: the durable counter high-water mark (two slots, HMAC-tagged, higher valid one wins) ----
def od_ctr_tag(slot: u64, v: u64):
    hm_setkey32(od_mk)
    hm_begin()
    sh_u64(OD_CMAGIC)
    sh_u64(slot)
    sh_u64(v)
    od_mac_end()

def od_ctr_put(v: u64) -> u64:
# make "no counter above v is used" durable (flushed) before any counter up to v is used
    i: u64 = 0
    while i < 512:
        ffs_b[i] = 0
        i += 1
    slot = 1 - od_hs
    od_ctr_tag(slot, v)
    ffs_b[0] = OD_CMAGIC
    ffs_b[1] = v
    i = 0
    while i < 4:
        ffs_b[2 + i] = od_tv[i]
        i += 1
    if ffs_put(od_cst + slot, 0) == 0 or nvme_flush() == 0:
        return 0
    od_hs = slot
    od_hwm = v
    return 1

def od_ctr_load() -> u64:
# od_hwm = the higher verified slot (0 if neither verifies); 0 if objects.ctr is missing
    i = ffs_find("objects.ctr")
    if i == FFS_NI or ffs_it[i * 8 + 7] != 2:
        return 0
    od_cst = ffs_it[i * 8 + 6]
    od_hwm = 0
    od_hs = 1
    slot: u64 = 0
    while slot < 2:
        if ffs_get(od_cst + slot, 0) != 0 and ffs_b[0] == OD_CMAGIC:
            v = ffs_b[1]
            od_ctr_tag(slot, v)
            ok = od_tag_ok(2)
            if ok == 0 and od_rot != 0:
                od_kswap()
                od_ctr_tag(slot, v)
                ok = od_tag_ok(2)
                od_kswap()
            if ok != 0 and v >= od_hwm:
                od_hwm = v
                od_hs = slot
        slot += 1
    return 1

def od_xor(b: u64, wc: u64):
# ffs_b[0..509] ^= ChaCha20(od_ek, nonce = (wc, block b))
    i: u64 = 0
    while i < 8:
        cc_key[i] = od_ek[i]
        i += 1
    j: u64 = 0
    while j * 8 < OD_PW:
        cc_block(j, wc & 0xFFFFFFFF, wc >> 32, b)
        k: u64 = 0
        while k < 8 and j * 8 + k < OD_PW:
            ffs_b[j * 8 + k] = ffs_b[j * 8 + k] ^ cc_word(k)
            k += 1
        j += 1

def od_put(b: u64) -> u64:
# encrypt logical block b into the slot that is not current, so a torn write leaves the old slot intact
    i: u64 = 0
    while i < OD_PW:
        w = b * OD_PW + i
        ffs_b[i] = 0
        if w < OB_NL:
            ffs_b[i] = ob_log[w]
        i += 1
    if od_wc + 1 > od_hwm:
        if od_ctr_put(od_wc + OD_WRES) == 0:
            return 0
        i = 0
        while i < OD_PW:
            w = b * OD_PW + i
            ffs_b[i] = 0
            if w < OB_NL:
                ffs_b[i] = ob_log[w]
            i += 1
    od_wc += 1
    wc = od_wc
    od_xor(b, wc)
    ffs_b[OD_PW] = wc
    od_tag(b, wc)
    i = 0
    while i < 4:
        ffs_b[OD_PW + 1 + i] = od_tv[i]
        i += 1
    slot = 1 - u64(od_cs[b])
    if ffs_put(od_st + b * 2 + slot, 0) == 0:
        return 0
    od_cs[b] = u8(slot)
    return 1

def od_slot_wc(b: u64, slot: u64) -> u64:
# the slot's write counter if its tag verifies, else 0 (ffs_b holds the slot afterwards)
    if ffs_get(od_st + b * 2 + slot, 0) == 0:
        return 0
    wc = ffs_b[OD_PW]
    if wc > od_rawmax and wc < (1 << 62):
        od_rawmax = wc  # even an unverified counter is never reused
    if wc == 0:
        return 0
    od_lk = 0
    od_tag(b, wc)
    if od_tag_ok(OD_PW + 1) != 0:
        return wc
    if od_rot == 0:
        return 0
    # mid-rotation: a block not rewritten yet is still under the old data key
    od_kswap()
    od_tag(b, wc)
    ok = od_tag_ok(OD_PW + 1)
    od_kswap()
    if ok == 0:
        return 0
    od_lk = 1
    return wc

def od_sync() -> u64:
# write every log block touched since the last sync, then flush: the commit is durable on return
    if ob_lp == od_synced:
        return 1
    b = od_synced / OD_PW
    e = (ob_lp - 1) / OD_PW
    while b <= e:
        if od_put(b) == 0:
            return 0
        b += 1
    if nvme_flush() == 0:
        return 0
    od_synced = ob_lp
    od_commits += 1
    return 1

def od_open() -> u64:
# 0 = unavailable, 1 = recovered an existing log, 2 = created an empty one, 3 = locked (no or wrong key),
# 4 = recovered, but a data-key rotation was stopped on request in the middle (inv231)
    od_torn = 0
    od_commits = 0
    od_badtag = 0
    od_ksrc = 0
    b: u64 = 0
    if od_tpm_present() != 0:
        od_ksrc = 1
    elif od_fwcfg_key(0) != 0:
        od_ksrc = 2
    if od_ksrc == 0:
        return 3
    i = ffs_find("objects.log")
    if i == FFS_NI:
        if ffs_find("objects.key") != FFS_NI:
            return 3
        if od_key_new() == 0:
            return 0
        od_st = od_mkfile("objects.log", OD_NB * 2)
        od_cst = od_mkfile("objects.ctr", 2)
        if od_st == 0 or od_cst == 0:
            return 0
        od_hs = 1
        od_hwm = 0
        ob_reset()
        ob_log_clear()
        w: u64 = 0
        while w < OB_NL:
            ob_log[w] = 0
            w += 1
        while b < OD_NB:
            od_cs[b] = 1
            b += 1
        od_wc = 0
        od_synced = 0
        return 2
    if ffs_it[i * 8 + 7] != OD_NB * 2:
        return 0
    od_st = ffs_it[i * 8 + 6]
    kl = od_key_load()
    if kl != 1:
        return kl
    if od_ctr_load() == 0:
        return 0
    od_wc = 0
    od_rawmax = 0
    b = 0
    while b < OD_NB:
        w0 = od_slot_wc(b, 0)
        w1 = od_slot_wc(b, 1)
        if w0 == 0 and w1 == 0:
            od_cs[b] = 1
            od_badtag += 2
            k: u64 = 0
            while k < OD_PW:
                if b * OD_PW + k < OB_NL:
                    ob_log[b * OD_PW + k] = 0
                k += 1
        else:
            slot: u64 = 1
            wc = w1
            if w0 > w1:
                slot = 0
                wc = w0
                od_slot_wc(b, 0)
            if w0 == 0 or w1 == 0:
                od_badtag += 1
            od_cs[b] = u8(slot)
            if wc > od_wc:
                od_wc = wc
            if od_lk != 0:
                od_kswap()
            od_xor(b, wc)
            if od_lk != 0:
                od_kswap()
            k = 0
            while k < OD_PW:
                if b * OD_PW + k < OB_NL:
                    ob_log[b * OD_PW + k] = ffs_b[k]
                k += 1
        b += 1
    # the next counter is above every counter ever made durable or seen on disk
    if od_hwm > od_wc:
        od_wc = od_hwm
    if od_rawmax > od_wc:
        od_wc = od_rawmax
    ob_replay(OB_NL)
    # anything after the last good record is a torn/corrupt tail: zero it in memory and on disk
    last: u64 = 0
    p = ob_lp
    while p < OB_NL:
        if ob_log[p] != 0:
            od_torn += 1
            ob_log[p] = 0
            last = p
        p += 1
    if od_torn != 0:
        b = ob_lp / OD_PW
        while b <= last / OD_PW:
            if od_put(b) == 0:
                return 0
            b += 1
        if nvme_flush() == 0:
            return 0
    od_synced = ob_lp
    return od_rot_maybe()

def od_rkw(o: u64, n: u64) -> u64:
# the n (<= 8) bytes of od_rk from o as a little-endian value
    v: u64 = 0
    i: u64 = 0
    while i < n:
        v = v | (u64(od_rk[o + i]) << (i * 8))
        i += 1
    return v

def od_rk_req() -> u64:
# the rotation request in od_rk: 0 none, 1 rotate; od_rots = 1 + N for ":stop-after:N" (stop after N blocks, to
# test a power loss in the middle of a rotation)
    od_rots = 0
    if od_fwcfg_key(2) == 0 or od_rkn < 15:
        return 0
    # "rotate-d" "ata-key" (15 bytes), then optionally ":" "stop-aft" "er:" and digits
    if od_rkw(0, 8) != 0x642D657461746F72 or od_rkw(8, 7) != 0x79656B2D617461:
        return 0
    if od_rkn == 15:
        return 1
    if od_rkn < 28 or od_rkw(15, 1) != 58 or od_rkw(16, 8) != 0x7466612D706F7473 or od_rkw(24, 3) != 0x3A7265:
        return 0
    n: u64 = 0
    i: u64 = 27
    while i < od_rkn:
        c = u64(od_rk[i])
        if c < 48 or c > 57:
            return 0
        n = n * 10 + c - 48
        i += 1
    od_rots = n + 1
    return 1

def od_dkw(w: u64, i: u64) -> u64:
# word i of od_dk (w = 0) or od_dk1 (w = 1); a u64[8] parameter would be a copy
    if w == 0:
        return od_dk[i]
    return od_dk1[i]

def od_dk_weak(w: u64, s0: u64, s1: u64) -> u64:
# 1 if data key w has the derivation used before the inv228 fix: wrap salt = SHA-256 words h0..h3 and DK word
# i = bswap(h_i) ^ h_(7-i), so DK word 7-i = bswap(DK_i ^ bswap(h_i)) ^ h_i for all four i (2^-128 by chance)
    n: u64 = 0
    i: u64 = 0
    while i < 4:
        h = s0 & 0xFFFFFFFF
        if i == 1:
            h = s0 >> 32
        elif i == 2:
            h = s1 & 0xFFFFFFFF
        elif i == 3:
            h = s1 >> 32
        if od_dkw(w, 7 - i) == od_be(od_dkw(w, i) ^ od_be(h)) ^ h:
            n += 1
        i += 1
    if n == 4:
        return 1
    return 0

def od_wk_h(i: u64) -> u64:
# the SHA-256 output word h_i of the detector self-test's made-up old-derivation key
    return ((i + 1) * 0x9E3779B9 + 0x7F4A7C15) & 0xFFFFFFFF

def od_wk_check():
# od_wk for this store's data key, after a self-test of the detector on a key made the old way in od_dk1: it must be
# flagged, and with one bit changed it must not be
    i: u64 = 0
    while i < 8:
        od_dk1[i] = od_be(od_wk_h(i)) ^ od_wk_h(7 - i)
        i += 1
    s0 = od_wk_h(0) | (od_wk_h(1) << 32)
    s1 = od_wk_h(2) | (od_wk_h(3) << 32)
    od_wst = 0
    if od_dk_weak(1, s0, s1) == 1:
        od_dk1[5] = od_dk1[5] ^ 16
        if od_dk_weak(1, s0, s1) == 0:
            od_wst = 1
    i = 0
    while i < 8:
        od_dk1[i] = 0
        i += 1
    od_wk = 1 + od_dk_weak(0, od_kn[2], od_kn[3])

def od_rot_maybe() -> u64:
# after an open: resume a rotation found on disk, or start one on request. 1 = open (rotated or not),
# 4 = stopped on request in the middle (the store is left rotating, as after a crash), 0 = I/O error
    od_rotr = 0
    od_rotb = 0
    req = od_rk_req()
    od_wk = 0
    if od_rot == 0:
        od_wk_check()
    if od_rot != 0:
        od_rotr = 3
    elif req != 0:
        od_rotr = 1
    elif od_wk == 2 and od_wst == 1:  # a data key made before the inv228 fix: rotate it unasked
        od_rotr = 2
    else:
        return 1
    # begin: a fresh independent data key from a new entropy pool; the old one goes into the slot beside it
    if od_rot == 0:
        i: u64 = 0
        while i < 8:
            od_dk1[i] = od_dk[i]
            od_ek1[i] = od_ek[i]
            od_mk1[i] = od_mk[i]
            i += 1
        od_pool_new()
        od_kdf(od_pool, 0x79656B64, 0, 0)  # "dkey"
        i = 0
        while i < 8:
            od_dk[i] = od_t[i]
            i += 1
        od_kdf(od_pool, 0x746C617377, 0, 0)  # "wsalt": a fresh wrap salt (the KEK and its KDF salt stay)
        s0 = od_t[0] | (od_t[1] << 32)
        s1 = od_t[2] | (od_t[3] << 32)
        od_pool_wipe()
        od_rot = 1
        od_slot_wrap(s0, s1)
        od_slot_rot()
        od_kn[OD_KG] = od_kn[OD_KG] + 1
        if od_key_store() == 0:
            return 0
        od_keys_from_dk()
    # the counter high-water mark under the new MAC key first, then every log block under the new data key
    hw = od_hwm
    if od_wc > hw:
        hw = od_wc
    if od_ctr_put(hw + OD_WRES) == 0:
        return 0
    b: u64 = 0
    while b < OD_NB:
        if od_rots != 0 and b == od_rots - 1:
            if nvme_flush() == 0:
                return 0
            return 4
        if od_put(b) == 0:
            return 0
        b += 1
        od_rotb = b
    if nvme_flush() == 0:
        return 0
    # done: the slot keeps only the new data key
    i = OD_KO
    while i < OD_KO + 8:
        od_kn[i] = 0
        i += 1
    od_kn[OD_KR] = 0
    od_kn[OD_KG] = od_kn[OD_KG] + 1
    if od_key_store() == 0:
        return 0
    od_rot = 0
    i = 0
    while i < 8:
        od_dk1[i] = 0
        od_ek1[i] = 0
        od_mk1[i] = 0
        i += 1
    return 1

def od_fp() -> u64:
    h: u64 = 0xcbf29ce484222325
    o: u64 = 0
    while o < ob_nobj:
        n = obj_read(o)
        if n != OB_ERR:
            i: u64 = 0
            while i < n:
                h = (h ^ ob_out[i]) * 0x100000001b3
                i += 1
        h = (h ^ o) * 0x100000001b3
        o += 1
    return h ^ ob_clock

def od_put3(a: u64, b: u64, c: u64):
    ob_in[0] = a
    ob_in[1] = b
    ob_in[2] = c

def od_commit(o: u64) -> u64:
    if obj_write(o, 3) == OB_ERR or od_sync() == 0:
        panic("objstore: commit failed")
    return ob_clock

# Phase 9.4: whole-system rewind after a bad change. Type 2 objects are the "system configuration"
# (field 0 = slot, field 1 = 100 + slot, field 2 = 1 when healthy). A bad change flips every slot to
# broken, durably; the health check notices, sys_rewind takes every object back to the last good
# clock (each rewind is a new version, so the bad change stays inspectable in history), and the next
# boot finds the rewound state on disk.
OD_NCFG = 8

def od_health() -> u64:
# number of broken configuration slots (OB_ERR if the configuration is missing)
    bad: u64 = 0
    k: u64 = 0
    o = obj_type_first(2)
    while o != OB_ERR:
        if obj_read(o) == OB_ERR or ob_out[1] != 100 + ob_out[0] or ob_out[2] != 1:
            bad += 1
        k += 1
        o = obj_type_next(o)
    if k != OD_NCFG:
        return OB_ERR
    return bad

def od_sfp() -> u64:
# state fingerprint: current payloads of every object (no clock, so a rewind can reproduce it)
    return od_fp() ^ ob_clock

def objrw_test():
    if ob_type_def(2, 3) != 0:
        panic("objstore: config type failed")
    k: u64 = 0
    while k < OD_NCFG:
        o = obj_new(2)
        od_put3(k, 100 + k, 1)
        od_commit(o)
        k += 1
    tg = ob_clock
    fg = od_sfp()
    if od_health() != 0:
        panic("objstore: config unhealthy before the change")
    # the bad change: every slot broken, and object 1 overwritten, each write durable
    o = obj_type_first(2)
    k = 0
    while o != OB_ERR:
        od_put3(k, 7, 0)
        od_commit(o)
        k += 1
        o = obj_type_next(o)
    od_put3(9, 9, 9)
    od_commit(1)
    hb = od_health()
    puts("objstore: bad change committed, health check: ")
    put_u64(hb)
    puts(" broken slots\n")
    if hb != OD_NCFG:
        panic("objstore: bad change not detected")
    n = sys_rewind(tg)
    if od_sync() == 0:
        panic("objstore: rewind commit failed")
    if od_health() != 0 or od_sfp() != fg or n != OD_NCFG + 1:
        panic("objstore: system rewind did not restore the good state")
    puts("objstore: system rewound to clock ")
    put_u64(tg)
    puts(" (")
    put_u64(n)
    puts(" objects restored, bad change still in history), state fingerprint ")
    put_hex(fg)
    putc(10)
    puts("objstore system rewind OK\n")

def objrw_verify():
# boot after the rewind: the rewound state must be what the disk holds
    puts("objstore: after reboot, health check: ")
    put_u64(od_health())
    puts(" broken slots, state fingerprint ")
    put_hex(od_sfp())
    putc(10)
    if od_health() != 0:
        panic("objstore: rewound state lost")
    puts("objstore system rewind persisted OK\n")

def od_keymsg(r: u64):
    puts("objstore: encrypted at rest (ChaCha20, encrypt-then-MAC HMAC-SHA256), uid 1000 data key ")
    if r == 2:
        puts("created, wrapped by the ")
    else:
        puts("unwrapped with the ")
    if od_ksrc == 1:
        puts("TPM-sealed key\n")
    else:
        puts("platform key (no TPM)\n")
    if r == 2 or od_kv0 == OD_KVER:
        puts("objstore: key slot v2: passphrase KDF PBKDF2-HMAC-SHA256, 128-bit salt, ")
        put_u64(od_kiter)
        puts(" iterations (")
        if tsc_per_ms != 0:
            put_u64(od_kdf_tsc / tsc_per_ms)
        else:
            putc(63)
        puts(" ms)\n")
    else:
        puts("objstore: key slot v1 (legacy): passphrase KDF unsalted SHA-256\n")
    puts("objstore: key file: 2 copies, generation ")
    put_u64(od_kg0)
    puts(", current copy objects.key")
    if od_kc0 == 1:
        putc(98)
    if od_krep == 1:
        puts("; the other copy was older or damaged and was rewritten from it")
    elif od_krep == 2:
        puts("; objects.keyb was missing and was written from it")
    putc(10)
    if od_kup != 0:
        puts("objstore: key slot v1 upgraded to v2: PBKDF2-HMAC-SHA256, ")
        put_u64(od_kiter)
        puts(" iterations, fresh salts, key slot generation ")
        put_u64(od_kn[OD_KG])
        puts(", both copies; the unsalted KEK no longer opens the store\n")
    if od_kchg != 0:
        puts("objstore: passphrase changed: the data key is rewrapped under the new passphrase, key slot ")
        puts("generation ")
        put_u64(od_kn[OD_KG])
        puts(", both copies; the old passphrase no longer opens the store\n")
    if r == 2:
        puts("objstore: data key entropy: ")
        put_u64(od_rs)
        puts(" RDSEED + ")
        put_u64(od_rr)
        puts(" RDRAND words mixed with 512 TSC jitter samples (")
        put_u64(od_rbad)
        puts(" CPU RNG results refused)\n")
    if od_rold != 0:
        puts("objstore: key slot is mid-rotation (an interrupted data-key rotation): log and counter slots verified ")
        puts("under the old and the new data key\n")
    if od_wk != 0:
        puts("objstore: pre-fix data key check: detector self-test ")
        if od_wst == 1:
            puts("OK (an old-derivation key is flagged, the same key with one bit changed is not)")
        else:
            puts("FAILED")
        puts("; this store's data key was ")
        if od_wk == 2:
            puts("made by the old derivation\n")
        else:
            puts("independent\n")
    if od_rotr != 0 and r == 1:
        puts("objstore: data key rotated: ")
        put_u64(od_rotb)
        puts(" log blocks re-encrypted under a fresh independent data key (")
        if od_rotr == 1:
            puts("operator request")
        elif od_rotr == 2:
            puts("pre-fix data key")
        else:
            puts("resumed after an interrupted rotation")
        puts("), key slot generation ")
        put_u64(od_kn[OD_KG])
        puts(", both copies; the old data key is gone from the key file\n")
    if r == 4:
        puts("objstore: data key rotation stopped after ")
        put_u64(od_rots - 1)
        puts(" of ")
        put_u64(OD_NB)
        puts(" log blocks (rotatedk stop-after); the store is left mid-rotation, as after a power loss\n")
    if r == 1:
        puts("objstore: ")
        put_u64(OD_NB * 2)
        puts(" log slots read, ")
        put_u64(od_badtag)
        puts(" never written or superseded-and-torn slots rejected by tag\n")

def objstore_test():
    r = od_open()
    od_uk_wipe()
    if r == 0:
        panic("objstore: objects.log unavailable")
    if r == 3:
        if od_ksrc == 0:
            puts("objstore: locked: no user key (no TPM, no platform key), nothing read or written\n")
        else:
            puts("objstore: locked: wrong user key for uid 1000, nothing decrypted or written\n")
        return
    od_keymsg(r)
    if r == 4:
        return
    if r == 1 and ob_tf[2] != 0:
        objrw_verify()
        objfs_verify()
        return
    if r == 2:
        if ob_type_def(1, 3) != 0 or od_sync() == 0:
            panic("objstore: type def failed")
        a = obj_new(1)
        b = obj_new(1)
        od_sync()
        j: u64 = 0
        while j < 50:
            od_put3(j, j * j, 7)
            od_commit(a)
            if j % 5 == 0:
                od_put3(j, 1000 + j, 8)
                od_commit(b)
            j += 1
        puts("objstore: objects.log created on the Incudela partition, ")
        put_u64(od_commits)
        puts(" durable commits, clock ")
        put_u64(ob_clock)
        puts(", fingerprint ")
        put_hex(od_fp())
        putc(10)
        # crash: a version record header reaches the disk without the rest of the record
        p = ob_lp
        ob_log[p] = OB_RV
        ob_log[p + 1] = a
        ob_log[p + 2] = 0
        if od_put(p / 512) == 0 or nvme_flush() == 0:
            panic("objstore: torn write failed")
        puts("objstore: crash simulated (torn record after the last commit)\n")
        return
    puts("objstore: recovered ")
    put_u64(ob_nver)
    puts(" versions of ")
    put_u64(ob_nobj)
    puts(" objects, clock ")
    put_u64(ob_clock)
    puts(", torn tail dropped (")
    put_u64(od_torn)
    puts(" words), fingerprint ")
    put_hex(od_fp())
    putc(10)
    # every committed version must be readable at its timestamp with the values that were written
    bad: u64 = 0
    i: u64 = 0
    t0: u64 = 0
    v: u64 = 0
    while v < ob_nver:
        if ov_obj[v] == 0:
            if i == 0:
                t0 = ov_ts[v]
            obj_read_at(0, ov_ts[v])
            if ob_out[0] != i or ob_out[1] != i * i or ob_out[2] != 7:
                bad += 1
            i += 1
        v += 1
    if bad != 0 or i != 50 or obj_field(1, 1) != 1045:
        panic("objstore: recovered history wrong")
    # keep working after recovery: rewind a to its first version, then new commits
    if obj_rewind(0, t0) == OB_ERR or od_sync() == 0 or obj_field(0, 1) != 0:
        panic("objstore: rewind failed")
    od_put3(1, 2, 3)
    od_commit(1)
    puts("objstore: all 50 committed versions of object 0 read back, rewind + new commit durable\n")
    puts("objstore crash recovery OK\n")
    objrw_test()
    objfs_test()
    puts("objstore: boot done, state fingerprint ")
    put_hex(od_sfp())
    putc(10)

# ---- Phase 9.5: files as objects, read back through the VFS (/obj in proc.cudi) ----
ofs_pth: u8[64]
ofs_pl: u64

def ofs_pa(w: u64):
# append the bytes of a little-endian packed word (up to its first NUL) to ofs_pth
    k: u64 = 0
    while k < 8 and ((w >> (k * 8)) & 255) != 0 and ofs_pl < 63:
        ofs_pth[ofs_pl] = u8((w >> (k * 8)) & 255)
        ofs_pl += 1
        k += 1
    ofs_pth[ofs_pl] = 0

def ofs_pn(v: u64):
    d: u64 = 1
    while d * 10 <= v:
        d *= 10
    while d > 0 and ofs_pl < 63:
        ofs_pth[ofs_pl] = u8(48 + (v / d) % 10)
        ofs_pl += 1
        d /= 10
    ofs_pth[ofs_pl] = 0

def ofs_p0():
    ofs_pl = 0
    ofs_pth[0] = 0

def ofs_fill(n: u64, seed: u64):
    i: u64 = 0
    while i < n:
        ofs_buf[i] = u8((i * 7 + seed) & 255)
        i += 1

def ofs_check(n: u64, seed: u64) -> u64:
    i: u64 = 0
    while i < n:
        if ofs_buf[i] != u8((i * 7 + seed) & 255):
            return 0
        i += 1
    return 1

def ofs_kname(w: u64):
    k: u64 = 0
    while k < 32:
        ofs_nm[k] = 0
        k += 1
    k = 0
    while k < 8:
        ofs_nm[k] = u8((w >> (k * 8)) & 255)
        k += 1

def ofs_kput(w: u64, n: u64, seed: u64):
    mutex_lock(addr(ofs_m))
    ofs_kname(w)
    ofs_fill(n, seed)
    if ofs_put(n) == OB_ERR or od_sync() == 0:
        panic("objfs: write failed")
    mutex_unlock(addr(ofs_m))

def ofs_kopen_p() -> u64:
# what open("<ofs_pth>") would give, read back the way the read/getdents syscalls do it: a file's
# contents go into ofs_buf and its size is returned; a listing returns 1000 + its entry count;
# OB_ERR = not under /obj, 0x7FFF = no such file
    mutex_lock(addr(ofs_m))
    r = ovfs_resolve(ofs_pth[:])
    v: u64 = 0x7FFF
    if r == OB_ERR:
        v = OB_ERR
    if r == 1:
        v = ofs_read_at(ovfs_o, ovfs_ts)
    if r == 2:
        ovfs_pos = 0
        n: u64 = 0
        while odir_next(ovfs_ts) != OB_ERR:
            n += 1
        v = 1000 + n
    mutex_unlock(addr(ofs_m))
    return v

OFS_MOTD = 0x64746F6D  # "motd"
OFS_NOTES = 0x7365746F6E  # "notes"
OFS_PRE = 0x2F6A626F2F  # "/obj/"

def ofs_kopen(w: u64) -> u64:
    ofs_p0()
    ofs_pa(OFS_PRE)
    ofs_pa(w)
    return ofs_kopen_p()

def ofs_klist(ts: u64) -> u64:
    ofs_p0()
    ofs_pa(0x6A626F2F)  # "/obj"
    if ts != OB_ERR:
        ofs_pa(0x402F)  # "/@"
        ofs_pn(ts)
    return ofs_kopen_p()

def objfs_test():
    if ofs_init() != 0 or od_sync() == 0:
        panic("objfs: init failed")
    ofs_kput(OFS_MOTD, 300, 1)
    ofs_kput(OFS_NOTES, 50, 3)
    t1 = ob_clock
    ofs_kput(OFS_MOTD, 200, 2)
    ok: u64 = 1
    if ofs_kopen(OFS_MOTD) != 200 or ofs_check(200, 2) == 0:
        ok = 0
    ofs_p0()
    ofs_pa(OFS_PRE)
    ofs_pa(0x40)
    ofs_pn(t1)
    ofs_pa(0x2F)
    ofs_pa(OFS_MOTD)
    if ofs_kopen_p() != 300 or ofs_check(300, 1) == 0:
        ok = 0
    if ofs_kopen(OFS_NOTES) != 50 or ofs_check(50, 3) == 0:
        ok = 0
    nd = ofs_klist(OB_ERR)
    if nd != 1002 or ofs_klist(0) != 1000 or ofs_kopen(0x68637573) != 0x7FFF:
        ok = 0
    ofs_p0()
    ofs_pa(0x786A626F2F)  # "/objx" is not under /obj
    if ofs_kopen_p() != OB_ERR:
        ok = 0
    puts("objfs: /obj lists ")
    put_u64(nd - 1000)
    puts(" files; /obj/motd reads v2 (200 bytes), /obj/@")
    put_u64(t1)
    puts("/motd reads v1 (300 bytes), /obj/@0 lists 0\n")
    if ok == 0:
        panic("objfs: VFS view wrong")
    puts("objstore VFS view OK\n")

def objfs_verify():
# next boot: the files came back from the log
    if ofs_init() != 0:
        panic("objfs: no file type after reboot")
    sz = ofs_kopen(OFS_MOTD)
    ok = ofs_check(200, 2)
    nd = ofs_klist(OB_ERR) - 1000
    puts("objfs: after reboot /obj lists ")
    put_u64(nd)
    puts(" files, /obj/motd is ")
    put_u64(sz)
    puts(" bytes\n")
    if sz != 200 or ok == 0 or nd != 2:
        panic("objfs: files lost")
    puts("objstore VFS view persisted OK\n")
