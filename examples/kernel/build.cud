# examples/kernel/build.cud: Cuditor port of examples/kernel/build.sh (kept as the reference;
# tests/kernel-build/run.sh checks both give the same build/kernel artifacts, output and exit code).
# Builds the Incudela kernel (ELF64 multiboot2, image KASLR: fld --format kernel lays out the low boot stub at
# 1 MiB and the rest at -2 GiB + phys and writes the .krel self-relocation table), the user programs
# (build/user-build, examples/user/build.cud, which builds BusyBox via build/busybox-build), the test modules
# (build/modules-build), a second kernel with another version string for the kexec test (kernel-next.elf, must
# differ from kernel.elf) and a BIOS+UEFI hybrid GRUB ISO. The script's sed/grep/cmp steps are done in Forge.
# usage: build/kernel-build [--release]  (the binary lives in build/, so the repo is the parent of its directory; it runs
# from examples/kernel like the script). Stops at the first failing step with that step's exit code (sh -e).
# --release (inv213) builds only the release kernel, build/kernel-release/kernel.elf: kernel.cud with
# krelease.cudi in place of kdebug.cudi (no hang probe, no KASLR layout lines). build/kernel (the test/debug kernel
# the OS tests boot) keeps its files.
# $CUDC_FLAGS is passed to cudc for both kernels (and inherited by the user and module builds); the kernels get
# --fs-ssa first unless $CUDC_FLAGS has -O0 (inv233: the O0 variant had kept the SSA backend).
import os
import sys

def cudc_flags():
# $CUDC_FLAGS (the pre-rename $FORGEC_FLAGS was read until 0.22.0)
    v = os.getenv("CUDC_FLAGS")
    if v is None:
        return ""
    return v

def kflags(v):
# the kernel's cudc flags: --fs-ssa then $CUDC_FLAGS, or $CUDC_FLAGS alone when it has -O0 (inv233)
    ex = v.split()
    for f in ex:
        if f == "-O0":
            return ex
    return ["--fs-ssa"] + ex

def step(args):
    r = os.run(args)
    os.write(1, r[1])
    os.write(2, r[2])
    if r[0] != 0:
        exit(r[0])

def mkdirs(p):
    d = ""
    for part in p.split("/"):
        d = part if d == "" else d + "/" + part
        if not os.path.isdir(d):
            os.mkdir(d)

def need(p):
    d = read_file(p)
    if d is None:
        os.write(2, "cp: cannot stat '" + p + "': No such file or directory\n")
        exit(1)
    return d

# cp(1) without -p: same bytes; an executable source (access X_OK) gives mode 0755 like cp under umask 022
def cp_file(a, b):
    write_file(b, need(a))
    if __syscall(21, a, 1, 0) == 0:
        os.chmod(b, 493)

def klink(p):
    step(["../../build/fld", "--format", "kernel", "-o", p + ".elf", p + ".o"])

def build_release(flags):
# the release kernel: the script's sed 's/^include "kdebug.cudi"$/include "krelease.cudi"/' and grep -q check
    r = "../../build/kernel-release"
    mkdirs(r)
    old = "include \"kdebug.cudi\""
    lines = []
    for l in need("kernel.cud").split("\n"):
        if l == old:
            l = "include \"krelease.cudi\""
        lines.append(l)
    rs = "\n".join(lines)
    write_file(".kernel_release.cud", rs)
    if rs.find("\ninclude \"krelease.cudi\"\n") < 0:
        exit(1)
    p = os.run(["../../build/cudc", ".kernel_release.cud", r + "/kernel.s"] + flags)
    os.write(1, p[1])
    os.write(2, p[2])
    if p[0] != 0:
        exit(p[0])
    os.remove(".kernel_release.cud")
    step(["../../build/fas", "-I", "../../build/user", "-o", r + "/kernel.o", r + "/kernel.s"])
    klink(r + "/kernel")
    step(["grub-file", "--is-x86-multiboot2", r + "/kernel.elf"])
    os.write(1, "built " + r + "/kernel.elf (release)\n")
    return 0

def main():
    me = sys.argv[0]
    root = os.path.dirname(me) + "/.." if me.find("/") >= 0 else ".."
    os.chdir(root + "/examples/kernel")
    b = "../../build/kernel"
    mkdirs(b + "/iso/boot/grub")
    # 12.1 step 3: the kernel (and kernel-next) are built with --fs-opt (register allocation and constant
    # division); every hand-written asm routine was audited for SysV register discipline (docs/SYSTEMS.md).
    # Step 4b: --fs-live (implies --fs-opt) adds liveness-based register sharing; same registers, same rules
    # Step 4c: --fs-temps (implies --fs-live) passes call arguments in registers and loads constants without
    # the stack; it only rewrites compiler-generated pushes, so the asm audit still covers it
    # Step 4d: --fs-ssa (implies --fs-temps) folds constants, compares and branches by SSA use counts; like every
    # --fs-* pass it never runs on a function with an asm() statement, so the asm audit still covers it
    # -O0 in $CUDC_FLAGS (the O0 gate, CI's boot-o0) drops the default --fs-ssa, so the O0 kernel is the plain
    # freestanding code generator with every bounds check kept; an --fs-* flag in $CUDC_FLAGS still applies (inv233)
    flags = kflags(cudc_flags())
    # the user programs and BusyBox (examples/user/build.cud, tools/busybox/build.cud)
    step(["../../cuditor", "../../tools/busybox/build.cud", "-o", "../../build/busybox-build"])
    step(["../../cuditor", "../user/build.cud", "-o", "../../build/user-build"])
    step(["../../build/user-build"])
    # the test modules (examples/modules/build.cud)
    step(["../../cuditor", "../modules/build.cud", "-o", "../../build/modules-build"])
    step(["../../build/modules-build"])
    if len(sys.argv) > 1 and sys.argv[1] == "--release":
        return build_release(flags)
    step(["../../build/cudc", "kernel.cud", b + "/kernel.s"] + flags)
    step(["../../build/fas", "-I", "../../build/user", "-o", b + "/kernel.o", b + "/kernel.s"])
    klink(b + "/kernel")
    step(["grub-file", "--is-x86-multiboot2", b + "/kernel.elf"])
    # a genuinely different build for the kexec test (\EFI\Incudela\kernel-next.elf): another version string
    # (the script's sed, first match per line, and its grep -q check)
    src = need("kernel.cud")
    old = "\"incudela-kernel 0.2.6\""
    new = "\"incudela-kernel 0.2.6-next\""
    lines = []
    for l in src.split("\n"):
        i = l.find(old)
        if i >= 0:
            l = l[:i] + new + l[i + len(old):]
        lines.append(l)
    nx = "\n".join(lines)
    write_file(".kernel_next.cud", nx)
    if nx.find(new) < 0:
        exit(1)
    r = os.run(["../../build/cudc", ".kernel_next.cud", b + "/kernel-next.s"] + flags)
    os.write(1, r[1])
    os.write(2, r[2])
    if r[0] != 0:
        exit(r[0])
    os.remove(".kernel_next.cud")
    step(["../../build/fas", "-I", "../../build/user", "-o", b + "/kernel-next.o", b + "/kernel-next.s"])
    klink(b + "/kernel-next")
    if read_file(b + "/kernel.elf") == read_file(b + "/kernel-next.elf"):
        os.write(1, "kernel-next.elf is identical to kernel.elf\n")
        exit(1)
    cp_file(b + "/kernel.elf", b + "/iso/boot/kernel.elf")
    cp_file("grub.cfg", b + "/iso/boot/grub/grub.cfg")
    # ISO UUID/date and the El Torito FAT serial: tools/repro-mkrescue pins them from SOURCE_DATE_EPOCH
    r = os.run(["../../tools/repro-mkrescue", "-o", b + "/forge.iso", b + "/iso"])
    if r[0] != 0:
        exit(r[0])
    os.write(1, "built " + b + "/kernel.elf and " + b + "/forge.iso\n")
    return 0

exit(main())
