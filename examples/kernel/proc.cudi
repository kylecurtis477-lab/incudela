# Processes: Proc objects (pid, parent, address space, fds, brk/mmap, args), fork/exec/wait/exit,
# the VFS (console, FAT32 files and directories behind file descriptors), the tty line queue fed by
# PS/2 and COM1 interrupts, and the syscall table. Syscalls run with interrupts enabled, so they can
# sleep (disk, tty, wait) and be preempted.
P_ALIVE = 1
P_ZOMBIE = 2
MAX_PROCS = 64
NFD = 16
MMAP_BASE = 0x0000700000000000
MMAP_TOP = 0x00007F0000000000
BRK_MAX = 0x0000100000000000
ENOENT = 0xFFFFFFFFFFFFFFFE
ENOEXEC = 0xFFFFFFFFFFFFFFF8
EBADF = 0xFFFFFFFFFFFFFFF7
ESTALE = 0xFFFFFFFFFFFFFF8C  # 116: a /data handle whose inode was unlinked or reused
ECHILD = 0xFFFFFFFFFFFFFFF6
ENOMEM = 0xFFFFFFFFFFFFFFF4
EFAULT = 0xFFFFFFFFFFFFFFF2
EMFILE = 0xFFFFFFFFFFFFFFE8
ENOTDIR = 0xFFFFFFFFFFFFFFEC
EISDIR = 0xFFFFFFFFFFFFFFEB
EINVAL = 0xFFFFFFFFFFFFFFEA
EROFS = 0xFFFFFFFFFFFFFFE2
EEXIST = 0xFFFFFFFFFFFFFFEF
ENOSPC = 0xFFFFFFFFFFFFFFE4
EIO = 0xFFFFFFFFFFFFFFFB
ENOSYS = 0xFFFFFFFFFFFFFFDA
EACCES = 0xFFFFFFFFFFFFFFF3
CAP_READ = 1
CAP_WRITE = 2
CAP_LOOKUP = 4
CAP_DUP = 8
CAP_XFER = 16
CAP_ALL = 31
CAP_ROOT_FD = 3

struct Proc:
    pid: u64
    ppid: u64
    pml4: u64
    thread: u64
    state: u64
    exit_code: u64
    brk_base: u64
    brk: u64
    mmap_next: u64
    fds: u64[16]
    fdr: u64[16]  # rights of each handle (CAP_*)
    args: u8[128]
    childq: WaitQ
    drv: u64
    dma_pa: u64
    dma_n: u64
    dma_va: u64
    caps: u64  # Phase 6.2: capabilities granted from the sealed manifest
    abi: u64  # 11.1: 0 Incudela syscalls, LX_ABI = the Linux personality (linux.cudi)
    lx_calls: u64  # Linux syscalls made
    lx_unsup: u64  # ... of which answered ENOSYS
    lx_dino: u64  # 11.1c: synthetic d_ino counter for getdents64
    lx_cloexec: u64  # 11.1d: bit fd set = opened with O_CLOEXEC (closed by execve)
    # 11.1b: Linux threads (linux.cudi). `thread` is the main thread and always the last to die; the
    # clone()d threads share pml4, fds and brk/mmap state and are pinned to the main thread's CPU
    nxthr: u64  # clone()d threads still alive
    xthr: u64[8]  # clone()d threads (dead ones are freed on slot reuse or in proc_destroy)
    thrq: WaitQ  # the main thread waits here for nxthr to reach 0
    exiting: u64  # a group exit (exit_group, a fatal fault) is under way
    gcode: u64  # its exit status
    nmade: u64  # threads ever created by clone
    fdbusy: u64  # threads inside read/write/ioctl (close of a shared fd waits for 0: EBUSY)
    # 11.1d: Linux signal dispositions (linux.cudi), index = signal number 1..31
    sig_h: u64[32]  # handler (0 SIG_DFL, 1 SIG_IGN)
    sig_fl: u64[32]  # sa_flags
    sig_rs: u64[32]  # sa_restorer
    sig_m: u64[32]  # sa_mask
    sig_cd: u64[32]  # si_code of the pending instance (SI_USER, SI_TKILL)
    sig_pend: u64  # process-directed pending signals (kill)

procs: u64[64]
# /proc/self/exe paths for Linux processes, indexed by the procs[] slot (not added to Proc, so
# kexec records and unsafe sys_fork are unchanged). Linux processes do not cross a kexec.
lx_exepid: u64[64]
lx_exepath: u8[8192]
reap_code: u64  # exit code of the child last found by sys_wait_ex
reap_found: u64  # Proc* unlinked but not yet destroyed (0 if none)
reap_slot: u64  # procs[] index to put the zombie back on a failed status copy
kx_freeze: u64  # a kexec handoff is collecting every user process at a syscall boundary
kx_caller: u64  # the Proc doing the handoff (it is not parked)

def kx_should_park() -> u64:
    if kx_freeze == 0:
        return 0
    p = cur_proc()
    return u64(p) != 0 and p.drv == 0 and u64(p) != kx_caller

def kx_park():
# park at a syscall boundary until the handoff happens (never returns then) or is abandoned
    t = cur_thread()
    t.kx_parked = 1
    while kx_freeze != 0:
        sleep_ticks(1)
    t.kx_parked = 0
nforks: u64
sandboxes: u64
sb_live: u64
sb_denials: u64
nexecs: u64

# the one checked-by-convention cast from a stored Proc address (procs[], Thread.proc) to a Proc
@unsafe
def as_proc(x: u64) -> ptr[Proc]:
    return ptr[Proc](x)

def proc_find_l(pid: u64) -> nptr[Proc]:
    i = 0
    while i < MAX_PROCS:
        if procs[i] != 0 and as_proc(procs[i]).pid == pid:
            return as_proc(procs[i])
        i += 1
    return 0

def proc_insert(p: ptr[Proc]) -> u64:
    f = irq_save()
    spin_lock(addr(rq_lock))
    i = 0
    while i < MAX_PROCS:
        if procs[i] == 0:
            procs[i] = u64(p)
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            return 1
        i += 1
    spin_unlock(addr(rq_lock))
    irq_restore(f)
    return 0

def proc_remove_l(p: ptr[Proc]):
    i = 0
    while i < MAX_PROCS:
        if procs[i] == u64(p):
            procs[i] = 0
        i += 1

def cur_proc() -> ptr[Proc]:
    return as_proc(cur_thread().proc)

# ---- files ----
F_CONSOLE = 1
F_FILE = 2
F_DIR = 3
F_CHAN = 4

struct File:
    type: u64
    ref: u64
    clu: u64  # first cluster (file) / directory cluster
    size: u64
    pos: u64  # byte offset (file) / entry index (dir)
    ccl: u64  # FAT: cached cluster; F_OBJ: snapshot clock; F_FFILE: inode generation
    cidx: u64  # its index in the chain
    gid: u64  # 10.2: grant id when this object was handed to a sandboxed app (0 = not a grant)
    lab: u8[32]  # 10.2: the path it was opened by (the grant ledger's resource label)

console_file: u64

@unsafe
def file_new(type: u64) -> ptr[File]:
    fl = ptr[File](kmalloc(sizeof(File)))
    memset(u64(fl), 0, sizeof(File))
    fl.type = type
    fl.ref = 1
    return fl

@unsafe
def file_get(fl: u64) -> u64:
    if fl != 0:
        atomic_fetch_add(addr(ptr[File](fl).ref), 1, acq_rel)
    return fl

@unsafe
def file_put(fl: u64):
    if fl == 0:
        return
    f = ptr[File](fl)
    if atomic_fetch_add(addr(f.ref), 0xFFFFFFFFFFFFFFFF, acq_rel) == 1:
        if f.type == F_CHAN:
            chan_end_close(f)
        if f.type == F_PIPE:
            pipe_end_close(f)
        if f.type == F_SOCK:
            sock_end_close(f)
        kfree(fl)

console_obj: File

def console() -> u64:
# one static console File shared by every process; its huge refcount means it is never freed
    if console_file == 0:
        console_obj.type = F_CONSOLE
        console_obj.ref = 1000000000
        console_file = u64(addr(console_obj))
    return file_get(console_file)

@unsafe
def fd_get(p: ptr[Proc], fd: u64) -> nptr[File]:
    if fd >= NFD:
        return 0
    return ptr[File](p.fds[fd])

def vfs_open(path: ptr[u8]) -> u64:
    return vfs_open_at(fs_root, path)

def vfs_open_at(c: u64, path: ptr[u8]) -> u64:
    ent: u8[32]
    e = u64(addr(ent[0]))
    mutex_lock(addr(fs_m))
    r = fs_lookup_at(c, path, e)
    mutex_unlock(addr(fs_m))
    if r == 0:
        return 0
    if r == 2:
        fl = file_new(F_DIR)
        fl.clu = c
        return u64(fl)
    if ent[11] & 0x10:
        fl = file_new(F_DIR)
        fl.clu = ent_cluster(e)
        if fl.clu == 0:
            fl.clu = fs_root
        return u64(fl)
    fl = file_new(F_FILE)
    fl.clu = ent_cluster(e)
    fl.size = le32(e + 28)
    fl.ccl = fl.clu
    return u64(fl)

def file_read(fl: ptr[File], ubuf: u64, n: u64) -> u64:
# FAT32 file -> user buffer, sector by sector through a bounce buffer
    kb: u8[512]
    if fl.pos >= fl.size:
        return 0
    if n > fl.size - fl.pos:
        n = fl.size - fl.pos
    csz = fs_spc * 512
    done: u64 = 0
    mutex_lock(addr(fs_m))
    while done < n:
        want = fl.pos / csz
        if want < fl.cidx:
            fl.ccl = fl.clu
            fl.cidx = 0
        while fl.cidx < want:
            fl.ccl = fat_next(fl.ccl)
            fl.cidx += 1
        if fl.ccl < 2 or fl.ccl >= 0x0FFFFFF8:
            break
        off = fl.pos % csz
        if vb_read(clu_lba(fl.ccl) + off / 512, 1, u64(addr(kb[0]))) == 0:
            break
        k = 512 - off % 512
        if k > n - done:
            k = n - done
        if copy_user(ubuf + done, u64(addr(kb[0])) + off % 512, k) != 0:
            mutex_unlock(addr(fs_m))
            return EFAULT
        done += k
        fl.pos += k
    mutex_unlock(addr(fs_m))
    return done

@unsafe
def dir_read(fl: ptr[File], ubuf: u64, n: u64, kern: u64) -> u64:
# kern = 1: ubuf is a kernel buffer (the Linux getdents64 converter), copied with memcpy
# getdents records: u64 size, u8 is_dir, name, NUL (only whole records are returned)
    ent: u8[32]
    nm: u8[256]
    rec: u8[272]
    done: u64 = 0
    mutex_lock(addr(fs_m))
    while 1:
        nx = dir_next(fl.clu, fl.pos, addr(nm[0]), u64(addr(ent[0])))
        if nx == 0:
            break
        if nm[0] == 46:
            fl.pos = nx
            continue
        l: u64 = 0
        while nm[l] != 0:
            l += 1
        rl = 9 + l + 1
        if done + rl > n:
            break
        vstore64(u64(addr(rec[0])), le32(u64(addr(ent[28]))))
        rec[8] = u8((ent[11] >> 4) & 1)
        memcpy(u64(addr(rec[9])), u64(addr(nm[0])), l + 1)
        if kern != 0:
            memcpy(ubuf + done, u64(addr(rec[0])), rl)
        elif copy_user(ubuf + done, u64(addr(rec[0])), rl) != 0:
            mutex_unlock(addr(fs_m))
            return EFAULT
        done += rl
        fl.pos = nx
    mutex_unlock(addr(fs_m))
    return done

# ---- /obj (Phase 9.5): the object store's files (objfs.cudi) as a read-only VFS view ----
# "/obj" lists the files, "/obj/<name>" opens one, "/obj/@<clock>/<name>" opens it as of that clock and
# "/obj/@<clock>" lists the files as of then. A handle snapshots its clock at open (fl.ccl; fl.clu = object
# id), so later writes never change what an open handle reads. ofs_m serialises every objfs access.
F_OBJ = 5
F_ODIR = 6
F_PIPE = 7  # item 9: Linux pipe/pipe2 ends (pipe.cudi); clu = pipe index, pos = 0 read / 1 write
F_SOCK = 12  # item 9: Linux socketpair ends (sock.cudi); clu = sock index, pos = 0 or 1
F_FFILE = 8  # item 9: a user-visible Incudela FS file under /data; clu = inode slot, ccl = inode generation, cidx bit 0 = O_APPEND
F_FDIR = 9  # item 9: the /data directory (the user-visible view of a mounted Incudela FS)
F_PDIR = 10  # item 9: a read-only /proc directory (clu 0 = /proc, clu 1 = /proc/<pid> or followed /proc/self)
F_PLNK = 11  # item 9: a /proc symlink (clu 0 = self -> pid, clu 1 = exe -> the image path)
ofs_m: Mutex

ovfs_o: u64  # ovfs_resolve results: object id, clock
ovfs_ts: u64

def ovfs_resolve(s: slice[u8]) -> u64:
# OB_ERR if s is not under /obj; else 0 (no such file / store not mounted), 1 (file ovfs_o as of
# ovfs_ts) or 2 (the listing as of ovfs_ts). Caller holds ofs_m.
    n = len(s)
    if n < 4 or s[0] != 47 or s[1] != 111 or s[2] != 98 or s[3] != 106:
        return OB_ERR
    if n > 4 and s[4] != 0 and s[4] != 47:
        return OB_ERR
    i: u64 = 4
    while i < n and s[i] == 47:
        i += 1
    ts = ob_clock
    if i < n and s[i] == 64:
        i += 1
        ts = 0
        d: u64 = 0
        while i < n and s[i] >= 48 and s[i] <= 57:
            ts = ts * 10 + u64(s[i] - 48)
            d += 1
            i += 1
        if d == 0 or ts > ob_clock or (i < n and s[i] != 0 and s[i] != 47):
            return 0
        while i < n and s[i] == 47:
            i += 1
    if ofs_ok == 0:
        return 0
    ovfs_ts = ts
    if i >= n or s[i] == 0:
        return 2
    k: u64 = 0
    while k < 32:
        ofs_nm[k] = 0
        k += 1
    k = 0
    while i < n and s[i] != 0:
        if s[i] == 47 or k == 31:
            return 0
        ofs_nm[k] = s[i]
        k += 1
        i += 1
    o = ofs_lookup()
    if o == OB_ERR or ofs_read_at(o, ts) == OB_ERR:
        return 0
    ovfs_o = o
    return 1

def ovfs_open(s: slice[u8]) -> u64:
# OB_ERR if s is not under /obj; else 0 or a new File snapshotting the file (or listing) as of open time
    mutex_lock(addr(ofs_m))
    r = ovfs_resolve(s)
    o = ovfs_o
    ts = ovfs_ts
    sz = ob_out[5]
    mutex_unlock(addr(ofs_m))
    if r == OB_ERR or r == 0:
        return r
    if r == 2:
        dl = file_new(F_ODIR)
        dl.ccl = ts
        return u64(dl)
    fl = file_new(F_OBJ)
    fl.clu = o
    fl.ccl = ts
    fl.size = sz
    return u64(fl)


def ofile_read(fl: ptr[File], ubuf: u64, n: u64) -> u64:
    mutex_lock(addr(ofs_m))
    sz = ofs_read_at(fl.clu, fl.ccl)
    if sz == OB_ERR or fl.pos >= sz:
        mutex_unlock(addr(ofs_m))
        return 0
    if n > sz - fl.pos:
        n = sz - fl.pos
    if copy_user(ubuf, u64(addr(ofs_buf[fl.pos])), n) != 0:
        mutex_unlock(addr(ofs_m))
        return EFAULT
    mutex_unlock(addr(ofs_m))
    fl.pos += n
    return n

ovfs_pos: u64

def odir_next(ts: u64) -> u64:
# next file in an /obj listing as of ts, after the first ovfs_pos type-list entries (advances ovfs_pos);
# leaves its name in ofs_nm and its size in ob_out[5]. Caller holds ofs_m.
    o = obj_type_first(OFS_T)
    k: u64 = 0
    while o != OB_ERR and k < ovfs_pos:
        o = obj_type_next(o)
        k += 1
    while o != OB_ERR:
        ovfs_pos += 1
        if ofs_name_of(o, ts) != OB_ERR:
            return o
        o = obj_type_next(o)
    return OB_ERR

def odir_read(fl: ptr[File], ubuf: u64, n: u64, kern: u64, kb: slice[u8]) -> u64:
# kern = 1: records go into the kernel buffer kb (the Linux getdents64 converter), ubuf unused
# same getdents records as dir_read: u64 size, u8 is_dir (0), name, NUL
    rec: u8[48]
    done: u64 = 0
    mutex_lock(addr(ofs_m))
    while 1:
        ovfs_pos = fl.pos
        o = odir_next(fl.ccl)
        if o == OB_ERR:
            break
        l: u64 = 0
        while l < 32 and ofs_nm[l] != 0:
            rec[9 + l] = ofs_nm[l]
            l += 1
        rec[9 + l] = 0
        rl = 9 + l + 1
        if done + rl > n:
            break
        fl.pos = ovfs_pos
        sz = ob_out[5]
        k: u64 = 0
        while k < 8:
            rec[k] = u8((sz >> (k * 8)) & 255)
            k += 1
        rec[8] = 0
        if kern != 0:
            if done + rl > len(kb):
                break
            q: u64 = 0
            while q < rl:
                kb[done + q] = rec[q]
                q += 1
        elif copy_user(ubuf + done, u64(addr(rec[0])), rl) != 0:
            mutex_unlock(addr(ofs_m))
            return EFAULT
        done += rl
    mutex_unlock(addr(ofs_m))
    return done

# ---- tty: one input queue fed by PS/2 and COM1 interrupts; lines are handed out on '\n' ----
tty_buf: u8[512]
tty_head: u64
tty_count: u64
tty_lines: u64
tty_q: WaitQ
kbd_irqs: u64
com_irqs: u64
ps2_rd: u64  # keyboard (non-aux) bytes read from port 0x60 by on_kbd; read by the boot harness at a hang (hang probe)

# The line discipline is hot-swappable (Phase 2.4): v0 below is built in; tty1.ko / tty2.ko provide the
# same three entry points. tty_fp_* are swapped together under rq_lock, and every call is made under
# rq_lock, so no CPU can be inside the old code once the swap's critical section ends.
tty_fp_push: u64
tty_fp_lines: u64
tty_fp_pop: u64
tty_pushed: u64
tty_popped: u64
tty_erased: u64
tty_dropped: u64

def kcur_pid() -> u64:
    p = cur_proc()
    if u64(p) == 0:
        return 0
    return p.pid

@patchable
def sys_getpid() -> u64:
# live-patch target (Phase 2.5): entry is a 5-byte nop that livepatch.cudi turns into a jmp
    return kcur_pid()

def kcur_ppid() -> u64:
    p = cur_proc()
    if u64(p) == 0:
        return 0
    return p.ppid

@patchable
def sys_getppid() -> u64:
# second live-patch site (no-restart gap 3)
    return kcur_ppid()

def tty0_push(c: u64) -> u64:
    if c == 8 or c == 127:
        if tty_count > 0 and tty_buf[(tty_head + tty_count - 1) & 511] != 10:
            tty_count -= 1
        return 2
    if tty_count >= 511:
        return 4
    tty_buf[(tty_head + tty_count) & 511] = u8(c)
    tty_count += 1
    if c == 10:
        tty_lines += 1
        return 1
    return 0

def tty0_lines() -> u64:
    return tty_lines

def tty0_pop() -> u64:
    c = u64(tty_buf[tty_head])
    tty_head = (tty_head + 1) & 511
    tty_count -= 1
    if c == 10:
        tty_lines -= 1
    return c

@unsafe
def tty0_save(st: u64, cap: u64) -> u64:
    if cap < 24 + tty_count:
        return 0
    vstore64(st, 0x54545931)
    vstore64(st + 8, tty_count)
    vstore64(st + 16, tty_lines)
    i: u64 = 0
    while i < tty_count:
        vstore8(st + 24 + i, u64(tty_buf[(tty_head + i) & 511]))
        i += 1
    return 24 + tty_count

@unsafe
def tty0_restore(st: u64, n: u64) -> u64:
    if n < 24 or vload64(st) != 0x54545931:
        return 0
    k = vload64(st + 8)
    if k > 511 or n != 24 + k:
        return 0
    tty_head = 0
    tty_count = k
    tty_lines = vload64(st + 16)
    i: u64 = 0
    while i < k:
        tty_buf[i] = u8(vload8(st + 24 + i))
        i += 1
    return 1

@unsafe
def tty_push_l(c: u64):
# rq_lock held (interrupt context)
    tty_pushed += 1
    if tty_fp_push == 0:
        tty_fp_push = u64(tty0_push)
        tty_fp_lines = u64(tty0_lines)
        tty_fp_pop = u64(tty0_pop)
    fl = call_ptr(tty_fp_push, c)
    if fl & 2:
        tty_erased += 1
    if fl & 4:
        tty_dropped += 1
    if fl & 1:
        wq_wake_all_l(addr(tty_q))

def tty_input(c: u64):
    spin_lock(addr(rq_lock))
    tty_push_l(c)
    spin_unlock(addr(rq_lock))

@unsafe
def tty_read(ubuf: u64, n: u64) -> u64:
    kb: u8[256]
    if n > 256:
        n = 256
    f = irq_save()
    spin_lock(addr(rq_lock))
    if tty_fp_push == 0:
        tty_fp_push = u64(tty0_push)
        tty_fp_lines = u64(tty0_lines)
        tty_fp_pop = u64(tty0_pop)
    while call_ptr(tty_fp_lines) == 0:
        if kx_should_park():
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            kx_park()
            f = irq_save()
            spin_lock(addr(rq_lock))
            continue
        wq_block_l(addr(tty_q))
    got: u64 = 0
    while got < n:
        c = call_ptr(tty_fp_pop)
        tty_popped += 1
        kb[got] = u8(c)
        got += 1
        if c == 10:
            break
    spin_unlock(addr(rq_lock))
    irq_restore(f)
    # echo what the program consumed (cooked mode, echo at read time)
    spin_lock_irq_con()
    i: u64 = 0
    while i < got:
        putc(kb[i])
        i += 1
    spin_unlock_irq_con()
    if copy_user(ubuf, u64(addr(kb[0])), got) != 0:
        return EFAULT
    return got

con_irqf: u64

def spin_lock_irq_con():
    f = irq_save()
    spin_lock(addr(con_lock))
    con_irqf = f

def spin_unlock_irq_con():
    f = con_irqf
    spin_unlock(addr(con_lock))
    irq_restore(f)

SC_MAP: u8[58] = [0, 27, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 45, 61, 8, 9, 113, 119, 101, 114, 116, 121, 117, 105, 111, 112, 91, 93, 10, 0, 97, 115, 100, 102, 103, 104, 106, 107, 108, 59, 39, 96, 0, 92, 122, 120, 99, 118, 98, 110, 109, 44, 46, 47, 0, 42, 0, 32]
SC_SHIFT: u8[58] = [0, 27, 33, 64, 35, 36, 37, 94, 38, 42, 40, 41, 95, 43, 8, 9, 81, 87, 69, 82, 84, 89, 85, 73, 79, 80, 123, 125, 10, 0, 65, 83, 68, 70, 71, 72, 74, 75, 76, 58, 34, 126, 0, 124, 90, 88, 67, 86, 66, 78, 77, 60, 62, 63, 0, 42, 0, 32]
kbd_shift: u64
kbd_e0: u64
VEC_KBD = 0x42
VEC_COM1 = 0x43
VEC_MOUSE = 0x44

def kbd_decode_l(sc: u64):
# in-kernel scan-code decoder (rq_lock held); the input service (kbd.cudi) runs the same in ring 3
    if sc == 0xE0:
        kbd_e0 = 1
        return
    if kbd_e0:
        kbd_e0 = 0
        return
    if sc == 0x2A or sc == 0x36:
        kbd_shift = 1
    elif sc == 0xAA or sc == 0xB6:
        kbd_shift = 0
    elif sc < 58:
        c = u64(SC_MAP[sc])
        if kbd_shift:
            c = u64(SC_SHIFT[sc])
        if c != 0:
            tty_push_l(c)

@unsafe
def ps2_io(port: u64, v: u64, wr: u64) -> u64:
# the PS/2 controller's two ports only (0x60 data, 0x64 status/command): one write or one read
    if port != 0x60 and port != 0x64:
        return 0
    if wr != 0:
        outb(u16(port), u8(v))
        return 0
    return u64(inb(u16(port)))

def ps2_wait_out():
# input buffer empty (status bit 1 clear) before a command or data byte, bounded
    g = 0
    while (ps2_io(0x64, 0, 0) & 2) != 0 and g < 100000:
        g += 1

def ps2_read_wait() -> u64:
# the next output byte (status bit 0), bounded; 0x100 when none came
    g = 0
    while (ps2_io(0x64, 0, 0) & 1) == 0 and g < 100000:
        g += 1
    if g >= 100000:
        return 0x100
    return ps2_io(0x60, 0, 0)

def ps2_mouse_cmd(c: u64) -> u64:
# a command to the aux device (0xD4 prefix); returns its reply byte (0xFA = ACK)
    ps2_wait_out()
    ps2_io(0x64, 0xD4, 1)
    ps2_wait_out()
    ps2_io(0x60, c, 1)
    return ps2_read_wait()

ms_ready: u64

def mouse_init():
# screen step 3, desktop mode only: enable the aux port and its interrupt (config bit 1, clock bit 5 clear),
# set defaults and turn on data reporting; IRQ 12 shares on_kbd, which sorts bytes by the aux bit
    ps2_wait_out()
    ps2_io(0x64, 0xA8, 1)
    ps2_wait_out()
    ps2_io(0x64, 0x20, 1)
    cfg = ps2_read_wait() & 0xFF
    ps2_wait_out()
    ps2_io(0x64, 0x60, 1)
    ps2_wait_out()
    ps2_io(0x60, (cfg | 0x43) & 0xCF, 1)
    a = ps2_mouse_cmd(0xF6)
    b = ps2_mouse_cmd(0xF4)
    ms_ready = 0
    if a == 0xFA and b == 0xFA:
        ms_ready = 1
    idt_set(VEC_MOUSE, u64(on_kbd), 0)
    ioapic_route(12, VEC_MOUSE)

@interrupt
@unsafe
def on_kbd(frame: ptr[u64]):
# IRQ 1 and (desktop mode) IRQ 12: status bit 5 marks a byte from the aux (mouse) port
    atomic_fetch_add(addr(kbd_irqs), 1, acq_rel)
    while 1:
        st = ps2_io(0x64, 0, 0)
        if (st & 1) == 0:
            break
        sc = ps2_io(0x60, 0, 0)
        if (st & 0x20) != 0:
            mouse_byte(sc)
            continue
        kbd_key_event(sc)
        ps2_rd += 1
        if kb_svc:
            kbd_event(0, sc)
        else:
            spin_lock(addr(rq_lock))
            kbd_decode_l(sc)
            spin_unlock(addr(rq_lock))
    lapic_eoi()

@interrupt
@unsafe
def on_com1(frame: ptr[u64]):
    atomic_fetch_add(addr(com_irqs), 1, acq_rel)
    while inb(0x3FD) & 1:
        c = u64(inb(0x3F8))
        if kb_svc:
            kbd_event(1, c)
            continue
        if c == 13:
            c = 10
        tty_input(c)
    lapic_eoi()

@unsafe
def input_init():
# PS/2: flush, enable the first port's interrupt (config bit 0), keep scan-code translation (set 1)
    while inb(0x64) & 1:
        inb(0x60)
    outb(0x64, 0x20)
    g = 0
    while (inb(0x64) & 1) == 0 and g < 100000:
        g += 1
    cfg = inb(0x60)
    outb(0x64, 0x60)
    outb(0x60, (cfg | 0x41) & 0xEF)
    outb(0x64, 0xAE)
    idt_set(VEC_KBD, u64(on_kbd), 0)
    ioapic_route(1, VEC_KBD)
    # COM1: receive-data interrupt, OUT2 gates the IRQ line
    idt_set(VEC_COM1, u64(on_com1), 0)
    ioapic_route(4, VEC_COM1)
    outb(0x3FC, inb(0x3FC) | 8)
    outb(0x3F9, 1)

@unsafe
def input_off():
    outb(0x3F9, 0)
    ioapic_mask(4)
    ioapic_mask(1)

# ---- address spaces: clone (fork), user page mapping (brk/mmap) ----
@unsafe
def clone_tbl(t: u64, lvl: u64) -> u64:
    nt = frame_alloc()
    memset(p2v(nt), 0, PAGE)
    i = 0
    while i < 512:
        v = vload64(p2v(t) + i * 8)
        if v & PTE_P:
            if lvl == 1:
                nf = frame_alloc()
                memcpy(p2v(nf), p2v(v & ADDR_MASK), PAGE)
                vstore64(p2v(nt) + i * 8, nf | (v & ~ADDR_MASK))
            else:
                vstore64(p2v(nt) + i * 8, clone_tbl(v & ADDR_MASK, lvl - 1) | (v & ~ADDR_MASK))
        i += 1
    return nt

@unsafe
def as_clone(src: u64) -> u64:
    pml4 = as_new()
    i = 0
    while i < 256:
        v = vload64(p2v(src) + i * 8)
        if v & PTE_P:
            vstore64(p2v(pml4) + i * 8, clone_tbl(v & ADDR_MASK, 3) | (v & ~ADDR_MASK))
        i += 1
    return pml4

@unsafe
def user_map_zero(pml4: u64, va: u64) -> u64:
    e = user_pte(pml4, va)
    if (vload64(e) & PTE_P) == 0:
        f = frame_alloc()
        if f == 0:
            return 0
        memset(p2v(f), 0, PAGE)
        vstore64(e, f | PTE_P | PTE_W | PTE_U | PTE_NX)
    return 1

@unsafe
def user_unmap(pml4: u64, va: u64):
    if user_page_ok(pml4, va, 0) == 0:
        return
    e = user_pte(pml4, va)
    v = vload64(e)
    vstore64(e, 0)
    invlpg(va)  # only this single-threaded process uses pml4, on this CPU
    pcid_forget(pml4)  # CPUs it ran on before may still cache va under its PCID
    frame_free(v & ADDR_MASK)

def page_up(v: u64) -> u64:
    return (v + PAGE - 1) & ~u64(PAGE - 1)

# ---- process lifecycle ----
def user_main(arg: u64):
    enter_ring3(arg, USTACK_TOP - 8)

def map_ustack(pml4: u64):
    i = 0
    while i < USTACK_PAGES:
        user_map_zero(pml4, USTACK_TOP - (i + 1) * PAGE)
        i += 1

@unsafe
def proc_new(ppid: u64) -> ptr[Proc]:
    p = ptr[Proc](kmalloc(sizeof(Proc)))
    memset(u64(p), 0, sizeof(Proc))
    p.ppid = ppid
    p.state = P_ALIVE
    p.mmap_next = MMAP_BASE
    return p

@unsafe
def proc_spawn_args(img: u64, len: u64, args: ptr[u8]) -> nptr[Thread]:
    vc = image_verify(img, len, SEAL_USER)
    if vc == 0:
        seal_log("kernel-supplied image")
        return 0
    pml4 = as_new()
    iend: u64 = 0
    entry = elf_load(pml4, img, len, u64(addr(iend)))
    if entry == 0:
        as_free(pml4)
        return 0
    map_ustack(pml4)
    p = proc_new(0)
    p.pml4 = pml4
    p.caps = vc & CAPB_ALL
    dk = cur_thread().spawn_drv  # per spawning thread: a concurrent ordinary spawn is never a driver
    p.drv = dk
    p.brk_base = page_up(iend)
    p.brk = p.brk_base
    p.fds[0] = console()
    p.fds[1] = console()
    p.fds[2] = console()
    p.fdr[0] = CAP_ALL
    p.fdr[1] = CAP_ALL
    p.fdr[2] = CAP_ALL
    if dk == 0 and fs_root != 0:
        rt = file_new(F_DIR)
        rt.clu = fs_root
        p.fds[CAP_ROOT_FD] = u64(rt)
        p.fdr[CAP_ROOT_FD] = CAP_ALL
    i: u64 = 0
    while i < 127 and args[i] != 0:
        p.args[i] = args[i]
        i += 1
    t = thread_new(u64(user_main), entry)
    t.cr3 = pml4
    t.user = 1
    t.proc = u64(p)
    p.pid = t.id
    p.thread = u64(t)
    proc_insert(p)
    thread_start_ready(t)
    return t

def proc_spawn(img: u64, len: u64) -> nptr[Thread]:
    return proc_spawn_args(img, len, "")

def proc_spawn_ok(img: u64, len: u64) -> ptr[Thread]:
# kernel self-tests: spawn an image that must load
    t = proc_spawn(img, len)
    if t == 0:
        panic("proc_spawn: image rejected by ELF loader")
    return t

@unsafe
def proc_destroy(p: ptr[Proc]):
# p is a zombie whose thread is dead and which is no longer in the table
    t = ptr[Thread](p.thread)
    thread_free(t)
    if p.nmade != 0:
        lx_proc_done(p)  # 11.1b: frees the dead clone()d threads
    as_free(p.pml4)
    sb_clear(p.pid)
    kfree(u64(p))

@unsafe
def proc_reap(t: ptr[Thread]) -> u64:
# kernel-side wait for a process the kernel spawned
    while atomic_load(addr(t.state), acquire) != T_DEAD:
        yield_cpu()
    p = ptr[Proc](t.proc)
    code = p.exit_code
    f = irq_save()
    spin_lock(addr(rq_lock))
    proc_remove_l(p)
    spin_unlock(addr(rq_lock))
    irq_restore(f)
    proc_destroy(p)
    return code

@unsafe
def proc_exit(code: u64):
    t = cur_thread()
    p = ptr[Proc](t.proc)
    lx_smap_sync_pid(p.pid)
    if p.abi == LX_ABI:
        code = lx_exit_begin(t, p, code)  # 11.1b: a clone()d thread never returns; main waits for them
    if p.drv == DRV_KBD:
        kbd_died()
    elif p.drv == DRV_NVME:
        nvs_died()
    elif p.drv != 0:
        drv_died(p)
    i = 0
    while i < NFD:
        file_put(p.fds[i])
        p.fds[i] = 0
        p.fdr[i] = 0
        i += 1
    gr_exit(p.pid)
    cli()
    spin_lock(addr(rq_lock))
    p.exit_code = code
    t.exit_code = code
    p.state = P_ZOMBIE
    # orphans go to the kernel (ppid 0), which reaps them in proc_reap_orphans (driver processes
    # are reaped by their supervisor only)
    i = 0
    while i < MAX_PROCS:
        if procs[i] != 0 and ptr[Proc](procs[i]).ppid == p.pid:
            ptr[Proc](procs[i]).ppid = 0
        i += 1
    par = proc_find_l(p.ppid)
    if u64(par) != 0:
        wq_wake_all_l(addr(par.childq))
    schedule_l(1)
    panic("dead process resumed")

@unsafe
def proc_reap_orphans() -> u64:
    n: u64 = 0
    while 1:
        f = irq_save()
        spin_lock(addr(rq_lock))
        z: u64 = 0
        i = 0
        while i < MAX_PROCS:
            q = procs[i]
            if q != 0 and ptr[Proc](q).ppid == 0 and ptr[Proc](q).drv == 0 and ptr[Proc](q).state == P_ZOMBIE and ptr[Thread](ptr[Proc](q).thread).state == T_DEAD:
                procs[i] = 0
                z = q
                break
            i += 1
        spin_unlock(addr(rq_lock))
        irq_restore(f)
        if z == 0:
            return n
        proc_destroy(ptr[Proc](z))
        n += 1

@unsafe
def sys_fork(frame: u64, ustack: u64) -> u64:
# ustack == 0: fork. ustack != 0 (11.1b, Linux clone of a thread, linux.cudi lx_clone): no new process;
# returns the new, not yet runnable Thread in the caller's process, resuming on ustack with rax = 0
    t = cur_thread()
    p = ptr[Proc](t.proc)
    c = p
    if ustack == 0:
        c = proc_new(p.pid)
        c.pml4 = as_clone(p.pml4)
        c.brk_base = p.brk_base
        c.brk = p.brk
        c.mmap_next = p.mmap_next
        c.caps = p.caps
        c.abi = p.abi
        memcpy(u64(addr(c.args[0])), u64(addr(p.args[0])), 128)
        i = 0
        while i < NFD:
            c.fds[i] = file_get(p.fds[i])
            c.fdr[i] = p.fdr[i]
            i += 1
        c.lx_cloexec = p.lx_cloexec
        c.lx_calls = 0
        c.lx_unsup = 0
        c.lx_dino = 0
        i = 0
        while i < 32:
            c.sig_h[i] = p.sig_h[i]
            c.sig_fl[i] = p.sig_fl[i]
            c.sig_rs[i] = p.sig_rs[i]
            c.sig_m[i] = p.sig_m[i]
            c.sig_cd[i] = 0
            i += 1
        c.sig_pend = 0
    ct = thread_new(fork_child_entry_addr(), 0)
    # the child's kernel stack: its own copy of the syscall frame at the top, the switch frame below it
    # (move the switch frame down first: the two regions overlap)
    cf = ct.kstack_top - SF_SIZE
    sp = cf - 72
    i = 0
    while i < 9:
        vstore64(sp + i * 8, vload64(ct.kstack_top - 72 + i * 8))
        i += 1
    memcpy(cf, frame, SF_SIZE)
    vstore64(sp + 16, cf)  # r13 = arg = frame
    ct.rsp = sp
    ct.cr3 = c.pml4
    ct.user = 1
    ct.proc = u64(c)
    ct.fsbase = t.fsbase
    ct.sig_mask = t.sig_mask
    fpu_save(ct.fpu)  # the parent's live FPU/SSE registers
    if ustack != 0:
        vstore64(cf + SF_RSP * 8, ustack)
        return u64(ct)
    c.pid = ct.id
    c.thread = u64(ct)
    if proc_insert(c) == 0:
        as_free(c.pml4)
        thread_free_new(ct)
        kfree(u64(c))
        return ENOMEM
    nforks += 1
    sb_inherit(p.pid, c.pid)
    thread_start_ready(ct)
    return c.pid

def thread_free_new(t: ptr[Thread]):
    t.state = T_DEAD
    thread_free(t)

def sys_exec(frame: u64, upath: u64, uargs: u64, sb: u64) -> u64:
    path: u8[128]
    args: u8[128]
    if copy_str_user(u64(addr(path[0])), upath, 128) > 127:
        return EFAULT
    args[0] = 0
    if uargs != 0 and copy_str_user(u64(addr(args[0])), uargs, 128) > 127:
        return EFAULT
    if root_cap(cur_proc()) == 0:
        cap_deny(cur_proc(), "exec", addr(path[0]))
        return EACCES
    if path_ok(path[:]) == 0:
        return EACCES
    sz: u64 = 0
    img = fs_read_file(addr(path[0]), addr(sz))
    if img == 0:
        return ENOENT
    # 11.1: only a sandboxed launch (sh `run app`) may verify a Linux-ABI image (SEAL_COMPAT)
    vk = SEAL_USER
    if sb:
        vk = SEAL_USER | SEAL_COMPAT
    vc = image_verify(img, sz, vk)
    if vc == 0:
        seal_log(addr(path[0]))
        kfree(img)
        return ENOEXEC
    pa: u8[256]
    exec_pack(pa[:], path[:], args[:])
    r = exec_image(frame, img, sz, vc, pa[:])
    if r == 0 and sb:
        sandbox_enter(cur_proc(), path[:])
    return r

def exec_pack(pa: slice[u8], path: slice[u8], args: slice[u8]):
# pa[0..128) = path, pa[128..256) = args (both NUL-terminated): exec_image's one argument buffer
    k: u64 = 0
    while k < 128:
        pa[k] = path[k]
        pa[128 + k] = args[k]
        k += 1

@unsafe
def exec_image(frame: u64, img: u64, sz: u64, vc: u64, pa: slice[u8]) -> u64:
# replace the calling process's image with a verified one (vc = its sealed capabilities); frees img.
# Shared by sys_exec and (11.1d) the Linux execve. Capabilities only narrow: caps &= vc.
# pa = exec_pack(path, args) (kernel memory).
    abi: u64 = 0
    if elf_is_linux(img, sz):
        abi = LX_ABI  # verified above with SEAL_COMPAT, so this is a sandboxed launch
    pml4 = as_new()
    iend: u64 = 0
    entry = elf_load(pml4, img, sz, u64(addr(iend)))
    kfree(img)
    if entry == 0:
        as_free(pml4)
        return ENOEXEC
    map_ustack(pml4)
    t = cur_thread()
    p = ptr[Proc](t.proc)
    old = p.pml4
    lx_smap_sync_pid(p.pid)
    f = irq_save()
    p.pml4 = pml4
    t.cr3 = pml4
    write_cr3(pml4)
    irq_restore(f)
    as_free(old)
    p.brk_base = page_up(iend)
    p.brk = p.brk_base
    p.mmap_next = MMAP_BASE
    p.caps = p.caps & vc & CAPB_ALL  # never more than the parent held
    k: u64 = 0
    while k < 128:
        p.args[k] = pa[128 + k]
        k += 1
    p.abi = abi
    p.lx_calls = 0
    p.lx_unsup = 0
    p.lx_cloexec = 0
    lx_sig_exec(p)  # 11.1d: caught signals go back to SIG_DFL (ignored stay ignored, mask kept)
    usp = USTACK_TOP - 8
    if abi == LX_ABI:
        usp = lx_stack(p, entry, pa)
        if usp == 0:
            proc_exit(127)
    # fresh registers: rip = entry, rsp = top of the new stack, everything else zero
    memset(frame, 0, SF_SIZE)
    vstore64(frame + SF_RIP * 8, entry)
    vstore64(frame + SF_RSP * 8, usp)
    vstore64(frame + SF_RFLAGS * 8, 0x202)
    fpu_restore(fpu_template)
    cur_thread().fsbase = 0  # 11.1b: a new image starts without TLS
    wrmsr(MSR_FS_BASE, 0)
    nexecs += 1
    return 0

@unsafe
def sys_wait_ex(pid: u64, kstatus: u64, options: u64) -> u64:
# reap a child; kstatus is a kernel u64* (0 to ignore). options bit 0 = WNOHANG (do not block).
    me = cur_proc()
    f = irq_save()
    spin_lock(addr(rq_lock))
    while 1:
        found: u64 = 0
        any: u64 = 0
        i = 0
        while i < MAX_PROCS:
            q = procs[i]
            if q != 0 and ptr[Proc](q).ppid == me.pid and (pid == 0xFFFFFFFFFFFFFFFF or ptr[Proc](q).pid == pid):
                any = 1
                if ptr[Proc](q).state == P_ZOMBIE and ptr[Thread](ptr[Proc](q).thread).state == T_DEAD:
                    procs[i] = 0
                    found = q
                    break
            i += 1
        if found != 0:
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            c = ptr[Proc](found)
            cpid = c.pid
            reap_code = c.exit_code
            # leave the zombie unlinked but not destroyed until wait_commit;
            # wait_abort puts it back if the status pointer is bad (badptr)
            reap_found = found
            reap_slot = i
            return cpid
        if any == 0:
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            return ECHILD
        if (options & 1) != 0:
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            return 0
        if kx_should_park():
            spin_unlock(addr(rq_lock))
            irq_restore(f)
            kx_park()
            f = irq_save()
            spin_lock(addr(rq_lock))
            continue
        wq_block_l(addr(me.childq))
    return 0

def wait_commit():
# destroy the zombie sys_wait_ex unlinked
    if reap_found != 0:
        proc_destroy(as_proc(reap_found))
        reap_found = 0

def wait_abort():
# status was not delivered: put the zombie back so a later wait can still reap it
    if reap_found != 0:
        f = irq_save()
        spin_lock(addr(rq_lock))
        procs[reap_slot] = reap_found
        spin_unlock(addr(rq_lock))
        irq_restore(f)
        reap_found = 0

def sys_wait(pid: u64, ustatus: u64) -> u64:
    r = sys_wait_ex(pid, 1, 0)
    if r == 0 or r == ECHILD or (r >> 63) != 0:
        return r
    if ustatus != 0 and (user_ptr_ok(ustatus, 8) == 0 or copy_user(ustatus, u64(addr(reap_code)), 8) != 0):
        wait_abort()
        return EFAULT
    wait_commit()
    return r

def sys_brk(nb: u64) -> u64:
    p = cur_proc()
    if nb == 0 or nb < p.brk_base or nb > BRK_MAX:
        return p.brk
    a = page_up(p.brk)
    b = page_up(nb)
    while a < b:
        if user_map_zero(p.pml4, a) == 0:
            return p.brk
        a += PAGE
    while b < a:
        user_unmap(p.pml4, b)
        b += PAGE
    p.brk = nb
    return nb

def sys_mmap(len: u64) -> u64:
    p = cur_proc()
    if len == 0 or len > 0x40000000:
        return EINVAL
    n = page_up(len)
    if p.mmap_next + n > MMAP_TOP:
        return ENOMEM
    va = p.mmap_next
    i: u64 = 0
    while i < n:
        if user_map_zero(p.pml4, va + i) == 0:
        # roll back the pages mapped so far; the VA range is not consumed
            while i > 0:
                i -= PAGE
                user_unmap(p.pml4, va + i)
            return ENOMEM
        i += PAGE
    p.mmap_next += n + PAGE  # one unmapped guard page between mappings
    return va

def sys_munmap(va: u64, len: u64) -> u64:
    p = cur_proc()
    if (va & (PAGE - 1)) != 0 or va < MMAP_BASE or va + len > MMAP_TOP or va + len < va:
        return EINVAL
    # DMA pages stay pinned while the device may still use them (freed only with the process)
    if p.dma_n != 0 and va < p.dma_va + p.dma_n * PAGE and va + len > p.dma_va:
        return EPERM
    lx_smap_drop_va(p.pid, va, len)
    i: u64 = 0
    while i < len:
        user_unmap(p.pml4, va + i)
        i += PAGE
    return 0

def sys_open(upath: u64) -> u64:
    path: u8[256]
    if copy_str_user(u64(addr(path[0])), upath, 256) > 255:
        return EFAULT
    p = cur_proc()
    if root_cap(p) == 0:
        cap_deny(p, "open", addr(path[0]))
        return EACCES
    if path_ok(path[:]) == 0:
        return EACCES
    if ffs_path_kind(path[:]) != 0:
        return ffs_open_abs(p, path[:], p.fdr[CAP_ROOT_FD], 0, 0)
    if proc_path_kind(path[:]) != 0:
        return proc_open_abs(p, path[:], p.fdr[CAP_ROOT_FD], 0, 0, 0)
    o = ovfs_open(path[:])
    if o != OB_ERR:
        return fd_label(p, ovfs_install(p, o, p.fdr[CAP_ROOT_FD]), path[:], 0)
    return fd_label(p, open_install(p, fs_root, addr(path[0]), p.fdr[CAP_ROOT_FD]), path[:], 0)

def fd_label(p: ptr[Proc], fd: u64, path: slice[u8], gid: u64) -> u64:
# remember what a fresh handle was opened as (the grant ledger's label) and the grant it derives from
    fl = fd_get(p, fd)
    if u64(fl) == 0:
        return fd
    k: u64 = 0
    while k < 31 and k < len(path) and path[k] != 0:
        fl.lab[k] = path[k]
        k += 1
    fl.lab[k] = 0
    fl.gid = gid
    return fd

@unsafe
def sys_stat(upath: u64, ubuf: u64) -> u64:
    st: u64[2]
    path: u8[256]
    if copy_str_user(u64(addr(path[0])), upath, 256) > 255:
        return EFAULT
    if root_cap(cur_proc()) == 0:
        cap_deny(cur_proc(), "stat", addr(path[0]))
        return EACCES
    if path_ok(path[:]) == 0:
        return EACCES
    if ffs_path_kind(path[:]) != 0:
        r = ffs_stat(path[:], st[:])
        if r != 0:
            return r
        if user_ptr_ok(ubuf, 16) == 0 or copy_user(ubuf, u64(addr(st[0])), 16) != 0:
            return EFAULT
        return 0
    fl = ovfs_open(path[:])
    if fl == OB_ERR:
        fl = vfs_open(addr(path[0]))
    if fl == 0:
        return ENOENT
    st[0] = ptr[File](fl).size
    st[1] = u64(ptr[File](fl).type == F_DIR or ptr[File](fl).type == F_ODIR)
    file_put(fl)
    if user_ptr_ok(ubuf, 16) == 0 or copy_user(ubuf, u64(addr(st[0])), 16) != 0:
        return EFAULT
    return 0

def sys_read(fd: u64, ubuf: u64, n: u64) -> u64:
    if user_ptr_ok(ubuf, n) == 0:
        return EFAULT
    fl = fd_get(cur_proc(), fd)
    if u64(fl) == 0:
        return EBADF
    op = "read"
    if n == 0:
        op = "poll"
    if gr_use(fl.gid, op) != 0:
        return EACCES
    if (cur_proc().fdr[fd] & CAP_READ) == 0:
        return EPERM
    if fl.type == F_CONSOLE:
        return tty_read(ubuf, n)
    if fl.type == F_FILE:
        r = file_read(fl, ubuf, n)
        au_moved(fl.gid, r)
        return r
    if fl.type == F_PIPE:
        return pipe_read(fl, ubuf, n)
    if fl.type == F_SOCK:
        return sock_read(fl, ubuf, n)
    if fl.type == F_OBJ:
        r = ofile_read(fl, ubuf, n)
        au_moved(fl.gid, r)
        return r
    if fl.type == F_FFILE:
        r = ffile_read(fl, ubuf, n)
        au_moved(fl.gid, r)
        return r
    return EISDIR

def sys_write(fd: u64, ubuf: u64, n: u64) -> u64:
    if user_ptr_ok(ubuf, n) == 0:
        return EFAULT
    fl = fd_get(cur_proc(), fd)
    if u64(fl) == 0:
        return EBADF
    if gr_use(fl.gid, "write") != 0:
        return EACCES
    if (cur_proc().fdr[fd] & CAP_WRITE) == 0:
        return EPERM
    if fl.type == F_CONSOLE:
        return con_write_user(ubuf, n)
    if fl.type == F_PIPE:
        return pipe_write(fl, ubuf, n)
    if fl.type == F_SOCK:
        return sock_write(fl, ubuf, n)
    if fl.type == F_FFILE:
        r = ffile_write(fl, ubuf, n)
        au_moved(fl.gid, r)
        return r
    return EROFS

def sys_getdents(fd: u64, ubuf: u64, n: u64) -> u64:
    if user_ptr_ok(ubuf, n) == 0:
        return EFAULT
    fl = fd_get(cur_proc(), fd)
    if u64(fl) == 0:
        return EBADF
    if gr_use(fl.gid, "getdents") != 0:
        return EACCES
    if (cur_proc().fdr[fd] & CAP_READ) == 0:
        return EPERM
    if fl.type == F_ODIR:
        z: u8[1]
        return odir_read(fl, ubuf, n, 0, z[:])
    if fl.type == F_FDIR:
        return fdir_read(fl, ubuf, n)
    if fl.type == F_PDIR:
        return pdir_read(fl, ubuf, n)
    if fl.type != F_DIR:
        return ENOTDIR
    return dir_read(fl, ubuf, n, 0)

def sys_close(fd: u64) -> u64:
    p = cur_proc()
    if fd >= NFD or p.fds[fd] == 0:
        return EBADF
    file_put(p.fds[fd])
    p.fds[fd] = 0
    p.fdr[fd] = 0
    return 0

# ---- capabilities (Phase 5.1): every fd is a handle with rights; no ambient path authority ----
def fd_free(p: ptr[Proc]) -> u64:
    fd: u64 = 0
    while fd < NFD and p.fds[fd] != 0:
        fd += 1
    return fd

def root_cap(p: ptr[Proc]) -> u64:
# absolute paths resolve only through a held root-directory capability (fd 3 with LOOKUP)
    fl = fd_get(p, CAP_ROOT_FD)
    if u64(fl) == 0:
        return 0
    if fl.type != F_DIR or fl.clu != fs_root or (p.fdr[CAP_ROOT_FD] & CAP_LOOKUP) == 0:
        return 0
    return 1

def path_ok(s: slice[u8]) -> u64:
# no "." or ".." components: a directory capability cannot be escaped upward
    n = len(s)
    i: u64 = 0
    while i < n and s[i] != 0:
        while i < n and s[i] == 47:
            i += 1
        j = i
        while j < n and s[j] != 0 and s[j] != 47:
            j += 1
        if j - i == 1 and s[i] == 46:
            return 0
        if j - i == 2 and s[i] == 46 and s[i + 1] == 46:
            return 0
        i = j
    return 1

cap_denials: u64

# sandbox state lives beside the Proc table (keyed by pid) so Proc stays in its 512-byte slab class
sb_pid: u64[64]  # 0 = free slot
sb_name: u8[1024]  # 16 bytes per slot: the app's name
sb_lock: u64

def sb_slot(pid: u64) -> u64:
    i: u64 = 0
    while i < MAX_PROCS:
        if sb_pid[i] == pid:
            return i
        i += 1
    return MAX_PROCS

def sb_new(pid: u64) -> u64:
# a free slot always exists: there are as many slots as processes
    f = irq_save()
    spin_lock(addr(sb_lock))
    i: u64 = 0
    while i < MAX_PROCS and sb_pid[i] != 0:
        i += 1
    sb_pid[i] = pid
    spin_unlock(addr(sb_lock))
    irq_restore(f)
    atomic_fetch_add(addr(sb_live), 1, acq_rel)
    return i

def sb_inherit(ppid: u64, pid: u64):
# a sandboxed process forks a sandboxed child with the same name
    sp = sb_slot(ppid)
    if sp == MAX_PROCS:
        return
    n = sb_new(pid)
    k: u64 = 0
    while k < 16:
        sb_name[n * 16 + k] = sb_name[sp * 16 + k]
        k += 1

def sb_clear(pid: u64):
    sp = sb_slot(pid)
    if sp == MAX_PROCS:
        return
    sb_pid[sp] = 0
    atomic_fetch_add(addr(sb_live), 0xFFFFFFFFFFFFFFFF, acq_rel)

def sandbox_enter(p: ptr[Proc], path: slice[u8]):
# exec through a manifest: the new image keeps only the handles the launcher installed; the
# ambient root capability (fd 3) is dropped, so every other path is out of reach
    if p.fds[CAP_ROOT_FD] != 0:
        file_put(p.fds[CAP_ROOT_FD])
        p.fds[CAP_ROOT_FD] = 0
        p.fdr[CAP_ROOT_FD] = 0
    sp = sb_slot(p.pid)
    if sp == MAX_PROCS:
        sp = sb_new(p.pid)
    b: u64 = 0
    i: u64 = 0
    while i < len(path) and path[i] != 0:
        if path[i] == 47:
            b = i + 1
        i += 1
    k: u64 = 0
    while k < 15 and b + k < len(path) and path[b + k] != 0:
        sb_name[sp * 16 + k] = path[b + k]
        k += 1
    sb_name[sp * 16 + k] = 0
    gr_enter(p, sp)
    n: u64 = 0
    i = 0
    while i < NFD:
        if i > 2 and p.fds[i] != 0:
            n += 1
        i += 1
    sandboxes += 1
    puts("sandbox: pid ")
    put_u64(p.pid)
    puts(" (")
    puts(addr(sb_name[sp * 16]))
    puts(") runs with ")
    put_u64(n)
    puts(" manifest handles, no root capability\n")

def sys_restrict(fd: u64, rights: u64) -> u64:
# narrow a handle's rights in place (never widen)
    p = cur_proc()
    if fd >= NFD or p.fds[fd] == 0:
        return EBADF
    if (rights & (~p.fdr[fd])) != 0:
        return EPERM
    p.fdr[fd] = rights
    return 0

def cap_deny(p: ptr[Proc], what: ptr[u8], path: ptr[u8]):
    cap_denials += 1
    sp = sb_slot(p.pid)
    if sp != MAX_PROCS:
        sb_denials += 1
        puts("sandbox: pid ")
        put_u64(p.pid)
        puts(" (")
        puts(addr(sb_name[sp * 16]))
        puts(") denied ")
        puts(what)
        puts(" ")
        puts(path)
        puts(": not in its manifest\n")
        return
    puts("cap: pid ")
    put_u64(p.pid)
    puts(" denied ")
    puts(what)
    puts(" (no root capability)\n")


def ffs_stat(path: slice[u8], st: slice[u64]) -> u64:
# native stat of /data: st[0] = size, st[1] = 1 if the path is the directory. 0 or an errno.
    kind = ffs_path_kind(path)
    if kind == 0 or ffs_ok == 0:
        return ENOENT
    if kind == 1:
        st[0] = 0
        st[1] = 1
        return 0
    i: u64 = 6
    n = len(path)
    while i < n and path[i] != 0:
        if path[i] == 47:
            return EACCES
        i += 1
    if ffs_user_ok(path[6:]) == 0:
        return EACCES
    ffs_lock()
    slot = ffs_find_slice(path[6:])
    if slot == FFS_NI:
        ffs_unlock()
        return ENOENT
    st[0] = ffs_it[slot * 8 + 5]
    st[1] = 0
    ffs_unlock()
    return 0

def ffs_path_kind(s: slice[u8]) -> u64:
# 0 = not under /data, 1 = /data or /data/, 2 = /data/<name>
    n = len(s)
    i: u64 = 0
    while i < n and s[i] != 0:
        i += 1
    if i < 5:
        return 0
    if s[0] != 47 or s[1] != 100 or s[2] != 97 or s[3] != 116 or s[4] != 97:
        return 0
    if i == 5:
        return 1
    if s[5] != 47:
        return 0
    if i == 6:
        return 1
    return 2

def ffs_install(p: ptr[Proc], fl: u64, r: u64) -> u64:
# an Incudela FS handle: CAP_WRITE may pass through (it is stripped for FAT and /obj)
    fd = fd_free(p)
    if fd == NFD:
        file_put(fl)
        return EMFILE
    if fl == 0:
        return ENOENT
    p.fds[fd] = fl
    p.fdr[fd] = r & (CAP_READ | CAP_WRITE | CAP_LOOKUP | CAP_DUP | CAP_XFER)
    return fd


# MAP_SHARED maps of an Incudela FS file (F_FFILE) in one process: stores are visible
# to read() and write() is visible in the mapping; munmap and exit write the file back.
# ESP / FAT MAP_SHARED+PROT_WRITE stays EACCES. Fork is still an eager copy, so a
# child's pages are not kept coherent with the parent's map. Cross-process shared
# physical pages are not implemented (sockets are the other item 9 leftover).
LX_SMAP_MAX = 4
lx_smap_va: u64[4]
lx_smap_n: u64[4]
lx_smap_off: u64[4]
lx_smap_slot: u64[4]
lx_smap_gen: u64[4]
lx_smap_pid: u64[4]
lx_smap_wr: u64[4]

def lx_smap_add(va: u64, n: u64, off: u64, slot: u64, gen: u64, pid: u64, wr: u64) -> u64:
    i: u64 = 0
    while i < LX_SMAP_MAX:
        if lx_smap_va[i] == 0:
            lx_smap_va[i] = va
            lx_smap_n[i] = n
            lx_smap_off[i] = off
            lx_smap_slot[i] = slot
            lx_smap_gen[i] = gen
            lx_smap_pid[i] = pid
            lx_smap_wr[i] = wr
            return 0
        i += 1
    return ENOMEM

def lx_smap_clear(i: u64):
    lx_smap_va[i] = 0
    lx_smap_n[i] = 0
    lx_smap_off[i] = 0
    lx_smap_slot[i] = 0
    lx_smap_gen[i] = 0
    lx_smap_pid[i] = 0
    lx_smap_wr[i] = 0

def lx_smap_sync_one(i: u64):
# write a PROT_WRITE map back into the file (clipped to the current size); then clear it
    if lx_smap_va[i] == 0:
        return
    va = lx_smap_va[i]
    n = lx_smap_n[i]
    off = lx_smap_off[i]
    slot = lx_smap_slot[i]
    gen = lx_smap_gen[i]
    wr = lx_smap_wr[i]
    lx_smap_clear(i)
    if wr == 0 or n == 0:
        return
    kb: u8[512]
    ffs_lock()
    if ffs_ok == 0 or ffs_check_gen(slot, gen) == 0:
        ffs_unlock()
        return
    sz = ffs_it[slot * 8 + 5]
    end = off + n
    if end > sz:
        end = sz
    o = off
    while o < end:
        k = 512
        if k > end - o:
            k = end - o
        if copy_user(u64(addr(kb[0])), va + (o - off), k) != 0:
            break
        r = ffs_kwrite(slot, o, kb[0:k])
        if r == 0:
            break
        o += r
        if r < k:
            break
    ffs_unlock()

def lx_smap_drop_va(pid: u64, va: u64, length: u64):
    i: u64 = 0
    while i < LX_SMAP_MAX:
        if lx_smap_va[i] != 0 and lx_smap_pid[i] == pid:
            ev = lx_smap_va[i]
            en = lx_smap_n[i]
            if va < ev + en and va + length > ev:
                lx_smap_sync_one(i)
        i += 1

def lx_smap_sync_pid(pid: u64):
    i: u64 = 0
    while i < LX_SMAP_MAX:
        if lx_smap_va[i] != 0 and lx_smap_pid[i] == pid:
            lx_smap_sync_one(i)
        i += 1

def lx_smap_fill(slot: u64, gen: u64, pos: u64, dst: u64, k: u64) -> u64:
# overlay k bytes at pos from a same-process shared map into a kernel buffer; 1 if filled
    p = cur_proc()
    i: u64 = 0
    while i < LX_SMAP_MAX:
        if lx_smap_va[i] != 0 and lx_smap_pid[i] == p.pid and lx_smap_slot[i] == slot and lx_smap_gen[i] == gen:
            off = lx_smap_off[i]
            if pos >= off and pos + k <= off + lx_smap_n[i]:
                if copy_user(dst, lx_smap_va[i] + (pos - off), k) == 0:
                    return 1
        i += 1
    return 0

def lx_smap_store(slot: u64, gen: u64, pos: u64, src: u64, k: u64):
# copy k bytes at pos from a kernel buffer into any covering same-process shared map
    p = cur_proc()
    i: u64 = 0
    while i < LX_SMAP_MAX:
        if lx_smap_va[i] != 0 and lx_smap_pid[i] == p.pid and lx_smap_slot[i] == slot and lx_smap_gen[i] == gen:
            off = lx_smap_off[i]
            if pos >= off and pos + k <= off + lx_smap_n[i]:
                copy_user(lx_smap_va[i] + (pos - off), src, k)
        i += 1

def ffile_read(fl: ptr[File], ubuf: u64, n: u64) -> u64:
    kb: u8[512]
    done: u64 = 0
    ffs_lock()
    if ffs_ok == 0 or ffs_check_gen(fl.clu, fl.ccl) == 0:
        ffs_unlock()
        return ESTALE
    fl.size = ffs_it[fl.clu * 8 + 5]
    while done < n:
        k = 512
        if k > n - done:
            k = n - done
        r = ffs_kread(fl.clu, fl.pos, kb[0:k])
        if r == 0:
            break
        lx_smap_fill(fl.clu, fl.ccl, fl.pos, u64(addr(kb[0])), r)
        if copy_user(ubuf + done, u64(addr(kb[0])), r) != 0:
            ffs_unlock()
            if done != 0:
                return done
            return EFAULT
        fl.pos += r
        done += r
        if r < k:
            break
    ffs_unlock()
    return done

def ffile_write(fl: ptr[File], ubuf: u64, n: u64) -> u64:
    kb: u8[512]
    if (fl.cidx & 1) != 0:
        fl.pos = fl.size
    done: u64 = 0
    ffs_lock()
    if ffs_ok == 0 or ffs_check_gen(fl.clu, fl.ccl) == 0:
        ffs_unlock()
        return ESTALE
    fl.size = ffs_it[fl.clu * 8 + 5]
    if (fl.cidx & 1) != 0:
        fl.pos = fl.size
    while done < n:
        k = 512
        if k > n - done:
            k = n - done
        if copy_user(u64(addr(kb[0])), ubuf + done, k) != 0:
            ffs_unlock()
            if done != 0:
                return done
            return EFAULT
        r = ffs_kwrite(fl.clu, fl.pos, kb[0:k])
        if r == 0:
            break
        lx_smap_store(fl.clu, fl.ccl, fl.pos, u64(addr(kb[0])), r)
        fl.pos += r
        if fl.pos > fl.size:
            fl.size = fl.pos
        done += r
        if r < k:
            break
    ffs_unlock()
    if done == 0 and n != 0:
        return ENOSPC
    return done

def fdir_put(fl: ptr[File], dst: slice[u8]) -> u64:
# Forge getdents records for the user-visible /data names (same layout as dir_read) into a kernel slice
    nm: u8[40]
    rec: u8[64]
    sz: u64[1]
    n = len(dst)
    done: u64 = 0
    ffs_lock()
    if ffs_ok == 0:
        ffs_unlock()
        return 0
    while 1:
        nx = ffs_dir_next(fl.pos, nm[:], sz[:])
        if nx == 0:
            break
        l: u64 = 0
        while l < 40 and nm[l] != 0:
            l += 1
        rl = 9 + l + 1
        if done + rl > n:
            break
        v = sz[0]
        i: u64 = 0
        while i < 8:
            rec[i] = u8((v >> (i * 8)) & 255)
            i += 1
        rec[8] = u8(0)
        i = 0
        while i <= l:
            rec[9 + i] = nm[i]
            i += 1
        i = 0
        while i < rl:
            dst[done + i] = rec[i]
            i += 1
        done += rl
        fl.pos = nx
    ffs_unlock()
    return done

def fdir_read(fl: ptr[File], ubuf: u64, n: u64) -> u64:
# user-buffer getdents of /data: fill a bounce slice, then copy_user
    kb: u8[512]
    done: u64 = 0
    while done < n:
        want = n - done
        if want > 512:
            want = 512
        r = fdir_put(fl, kb[0:want])
        if r == 0:
            break
        if copy_user(ubuf + done, u64(addr(kb[0])), r) != 0:
            if done != 0:
                return done
            return EFAULT
        done += r
        if r < want:
            break
    return done

def ffs_open_name(p: ptr[Proc], name: slice[u8], rights: u64, flags: u64, gid: u64) -> u64:
# open or create a /data file relative to the directory handle. flags are the Linux O_* bits (0 for
# a native open: existing file, read). Caller has already checked LOOKUP and the grant.
    if ffs_ok == 0:
        return ENOENT
    if (flags & O_DIRECTORY) != 0:
        return ENOTDIR
    if ffs_user_ok(name) == 0:
        return EACCES
    acc = flags & O_ACCMODE
    wr = 0
    if acc != 0 or (flags & (O_CREAT | O_TRUNC | O_APPEND | O_EXCL)) != 0:
        wr = 1
    if wr != 0 and (rights & CAP_WRITE) == 0:
        return EACCES
    ffs_lock()
    slot = ffs_find_slice(name)
    if slot == FFS_NI:
        if (flags & O_CREAT) == 0:
            ffs_unlock()
            return ENOENT
        if wr == 0 or (rights & CAP_WRITE) == 0:
            ffs_unlock()
            return EACCES
        slot = ffs_create_empty(name)
        if slot == FFS_NI:
            ffs_unlock()
            return ENOSPC
    elif (flags & O_CREAT) != 0 and (flags & O_EXCL) != 0:
        ffs_unlock()
        return EEXIST
    elif (flags & O_TRUNC) != 0:
        if (rights & CAP_WRITE) == 0:
            ffs_unlock()
            return EACCES
        if ffs_grow(slot, 0) == 0:
            ffs_unlock()
            return EIO
    size = ffs_it[slot * 8 + 5]
    gen = ffs_igen[slot]
    if gen == 0:
        gen = 1
    ffs_unlock()
    fl = file_new(F_FFILE)
    fl.clu = slot
    fl.size = size
    fl.ccl = gen
    if (flags & O_APPEND) != 0:
        fl.cidx = 1
        fl.pos = size
    r = rights
    if acc == 1:
        r = r & ~CAP_READ
    if acc == 0:
        r = r & ~CAP_WRITE
    return fd_label(p, ffs_install(p, u64(fl), r), name, gid)

def ffs_open_abs(p: ptr[Proc], path: slice[u8], rights: u64, flags: u64, gid: u64) -> u64:
    kind = ffs_path_kind(path)
    if kind == 0:
        return ENOENT
    if ffs_ok == 0:
        return ENOENT
    if kind == 1:
        if (flags & 0x10000) == 0 and (flags & 3) != 0:
            return EISDIR
        fl = file_new(F_FDIR)
        return fd_label(p, ffs_install(p, u64(fl), rights), path, gid)
    # /data/name -- reject a further slash (the volume is flat)
    i: u64 = 6
    n = len(path)
    while i < n and path[i] != 0:
        if path[i] == 47:
            return EACCES
        i += 1
    return ffs_open_name(p, path[6:], rights, flags, gid)

# ---- item 9: a read-only /proc (self and self/exe only) ----
# Kinds returned by proc_parse: 0 = not under /proc, 1 = /proc, 2 = /proc/self, 3 = /proc/self/exe,
# 4 = /proc/<our pid>, 5 = /proc/<our pid>/exe. Any other name under /proc is ENOENT (including
# another process's pid, so /proc does not leak other images).
def proc_path_kind(path: slice[u8]) -> u64:
    if len(path) >= 5 and path[0] == 47 and path[1] == 112 and path[2] == 114 and path[3] == 111 and path[4] == 99:
        if len(path) == 5 or path[5] == 0 or path[5] == 47:
            return 1
    return 0

def proc_dec(n: u64, dst: slice[u8]) -> u64:
    t: u8[20]
    if n == 0:
        dst[0] = 48
        return 1
    i: u64 = 0
    while n != 0 and i < 20:
        t[i] = u8(48 + (n % 10))
        n = n / 10
        i += 1
    j: u64 = 0
    while j < i:
        dst[j] = t[i - 1 - j]
        j += 1
    return i

def proc_parse(path: slice[u8], pid: u64) -> u64:
    if proc_path_kind(path) == 0:
        return 0
    # /proc or /proc/
    if len(path) == 5 or (len(path) == 6 and path[5] == 47) or (len(path) > 5 and path[5] == 0):
        return 1
    if path[5] != 47:
        return 0
    rest = path[6:]
    # strip a trailing slash for the first component only when the rest is empty after it
    if rest[0] == 0:
        return 1
    # self or self/exe
    if len(rest) >= 4 and rest[0] == 115 and rest[1] == 101 and rest[2] == 108 and rest[3] == 102:
        if len(rest) == 4 or rest[4] == 0:
            return 2
        if rest[4] == 47:
            if len(rest) == 5 or rest[5] == 0:
                return 2
            if len(rest) >= 8 and rest[5] == 101 and rest[6] == 120 and rest[7] == 101 and (len(rest) == 8 or rest[8] == 0):
                return 3
            return ENOENT
        return ENOENT
    # decimal pid
    d: u8[20]
    pl = proc_dec(pid, d[:])
    i: u64 = 0
    while i < pl and i < len(rest) and rest[i] == d[i]:
        i += 1
    if i != pl:
        return ENOENT
    if rest[i] == 0:
        return 4
    if rest[i] == 47:
        if rest[i + 1] == 0:
            return 4
        if rest[i + 1] == 101 and rest[i + 2] == 120 and rest[i + 3] == 101 and (len(rest) == i + 4 or rest[i + 4] == 0):
            return 5
        return ENOENT
    return ENOENT

def proc_slot_of(p: ptr[Proc]) -> u64:
    i: u64 = 0
    while i < 64:
        if procs[i] == u64(p):
            return i
        i += 1
    return 64

def lx_exe_set(p: ptr[Proc], path: slice[u8]):
    s = proc_slot_of(p)
    if s == 64:
        return
    lx_exepid[s] = p.pid
    i: u64 = 0
    while i < 127 and i < len(path) and path[i] != 0:
        lx_exepath[s * 128 + i] = path[i]
        i += 1
    lx_exepath[s * 128 + i] = 0

def lx_exe_get(p: ptr[Proc], dst: slice[u8]) -> u64:
    s = proc_slot_of(p)
    if s == 64 or lx_exepid[s] != p.pid:
        return 0
    i: u64 = 0
    while i < 127 and i < len(dst) and lx_exepath[s * 128 + i] != 0:
        dst[i] = lx_exepath[s * 128 + i]
        i += 1
    if i < len(dst):
        dst[i] = 0
    return i

def lx_exe_dup_pid(oldpid: u64, newpid: u64):
# copy the parent's exe path onto the child (called from the parent after a Linux fork)
    src: u64 = 64
    dst: u64 = 64
    i: u64 = 0
    while i < 64:
        if procs[i] != 0:
            q = as_proc(procs[i])
            if q.pid == oldpid:
                src = i
            if q.pid == newpid:
                dst = i
        i += 1
    if src == 64 or dst == 64 or lx_exepid[src] != oldpid:
        return
    lx_exepid[dst] = newpid
    i = 0
    while i < 128:
        lx_exepath[dst * 128 + i] = lx_exepath[src * 128 + i]
        i += 1

def proc_target(p: ptr[Proc], clu: u64, dst: slice[u8]) -> u64:
# length of a /proc symlink target (clu 0 = pid digits, clu 1 = exe path)
    if clu == 0:
        return proc_dec(p.pid, dst)
    return lx_exe_get(p, dst)

def proc_install(p: ptr[Proc], typ: u64, clu: u64, rights: u64, gid: u64, lab: slice[u8]) -> u64:
    fd = fd_free(p)
    if fd == NFD:
        return EMFILE
    fl = file_new(typ)
    if u64(fl) == 0:
        return ENOSPC
    fl.clu = clu
    fl.pos = 0
    p.fds[fd] = u64(fl)
    p.fdr[fd] = rights & (CAP_READ | CAP_LOOKUP | CAP_DUP | CAP_XFER)
    return fd_label(p, fd, lab, gid)

def proc_open_kind(p: ptr[Proc], kind: u64, rights: u64, gid: u64, nofollow: u64) -> u64:
    lab: u8[32]
    lab[0] = 47
    lab[1] = 112
    lab[2] = 114
    lab[3] = 111
    lab[4] = 99
    lab[5] = 0
    if kind == 1:
        return proc_install(p, F_PDIR, 0, rights, gid, lab[:])
    if kind == 2 or kind == 4:
        if nofollow != 0 and kind == 2:
            return proc_install(p, F_PLNK, 0, rights, gid, lab[:])
        return proc_install(p, F_PDIR, 1, rights, gid, lab[:])
    if kind == 3 or kind == 5:
    # exe is always a symlink this batch; following it would open the image, which may be ungranted
        return proc_install(p, F_PLNK, 1, rights, gid, lab[:])
    return ENOENT

def proc_open_abs(p: ptr[Proc], path: slice[u8], rights: u64, flags: u64, gid: u64, nofollow: u64) -> u64:
    kind = proc_parse(path, p.pid)
    if kind == 0:
        return EACCES
    if (kind >> 63) != 0:
        return kind
    return proc_open_kind(p, kind, rights, gid, nofollow)

def proc_open_name(p: ptr[Proc], name: slice[u8], rights: u64, flags: u64, gid: u64, nofollow: u64, base: u64) -> u64:
# name is relative to a held /proc handle: base 0 is /proc, base 1 is /proc/<pid>
    path: u8[64]
    path[0] = 47
    path[1] = 112
    path[2] = 114
    path[3] = 111
    path[4] = 99
    i: u64 = 5
    if base == 1:
        path[5] = 47
        n = proc_dec(p.pid, path[6:])
        i = 6 + n
    if name[0] != 0:
        path[i] = 47
        i += 1
        k: u64 = 0
        while k < 40 and k < len(name) and name[k] != 0 and i < 63:
            path[i] = name[k]
            i += 1
            k += 1
    path[i] = 0
    return proc_open_abs(p, path[:], rights, flags, gid, nofollow)

def pdir_put(fl: ptr[File], dst: slice[u8]) -> u64:
# Forge getdents records: is_dir 1 = directory, 2 = symlink, 0 = file
    rec: u8[32]
    nm: u8[20]
    p = cur_proc()
    n = len(dst)
    done: u64 = 0
    # two entries at most; fl.pos is the next index (0 or 1)
    while fl.pos < 2:
        isdir: u64 = 2
        l: u64 = 0
        if fl.clu == 0:
            if fl.pos == 0:
            # self
                nm[0] = 115
                nm[1] = 101
                nm[2] = 108
                nm[3] = 102
                nm[4] = 0
                l = 4
            else:
                l = proc_dec(p.pid, nm[:])
                nm[l] = 0
                isdir = 1
        else:
            if fl.pos == 0:
                nm[0] = 101
                nm[1] = 120
                nm[2] = 101
                nm[3] = 0
                l = 3
            else:
                break
        rl = 9 + l + 1
        if done + rl > n:
            break
        i: u64 = 0
        while i < 8:
            rec[i] = 0
            i += 1
        rec[8] = u8(isdir)
        i = 0
        while i <= l:
            rec[9 + i] = nm[i]
            i += 1
        i = 0
        while i < rl:
            dst[done + i] = rec[i]
            i += 1
        done += rl
        fl.pos += 1
    return done

def pdir_read(fl: ptr[File], ubuf: u64, n: u64) -> u64:
    kb: u8[128]
    done: u64 = 0
    while done < n:
        want = n - done
        if want > 128:
            want = 128
        r = pdir_put(fl, kb[0:want])
        if r == 0:
            break
        if copy_user(ubuf + done, u64(addr(kb[0])), r) != 0:
            if done != 0:
                return done
            return EFAULT
        done += r
        if r < want:
            break
    return done

def open_install(p: ptr[Proc], c: u64, path: ptr[u8], r: u64) -> u64:
    fd = fd_free(p)
    if fd == NFD:
        return EMFILE
    fl = vfs_open_at(c, path)
    if fl == 0:
        return ENOENT
    p.fds[fd] = fl
    p.fdr[fd] = r & (CAP_READ | CAP_LOOKUP | CAP_DUP | CAP_XFER)
    return fd

def ovfs_install(p: ptr[Proc], fl: u64, r: u64) -> u64:
# an /obj handle (from ovfs_open) into a free fd: read-only, never a lookup capability
    fd = fd_free(p)
    if fd == NFD:
        file_put(fl)
        return EMFILE
    if fl == 0:
        return ENOENT
    p.fds[fd] = fl
    p.fdr[fd] = r & (CAP_READ | CAP_DUP | CAP_XFER)
    return fd

def sys_openat(dirfd: u64, upath: u64) -> u64:
    path: u8[256]
    if copy_str_user(u64(addr(path[0])), upath, 256) > 255:
        return EFAULT
    p = cur_proc()
    d = fd_get(p, dirfd)
    if u64(d) == 0:
        return EBADF
    if (p.fdr[dirfd] & CAP_LOOKUP) == 0:
        return EPERM
    if path[0] == 47 or path_ok(path[:]) == 0:
        return EACCES
    if gr_use(d.gid, "openat") != 0:
        return EACCES
    if d.type == F_FDIR:
        return ffs_open_name(p, path[:], p.fdr[dirfd], 0, d.gid)
    if d.type == F_PDIR:
        return proc_open_name(p, path[:], p.fdr[dirfd], 0, d.gid, 0, d.clu)
    if d.type != F_DIR:
        return ENOTDIR
    # a file found through a granted directory belongs to the same grant
    return fd_label(p, open_install(p, d.clu, addr(path[0]), p.fdr[dirfd]), path[:], d.gid)

def sys_dup(fd: u64, rights: u64) -> u64:
# a new handle to the same object with a subset of the rights: dup can only narrow
    p = cur_proc()
    if fd >= NFD or p.fds[fd] == 0:
        return EBADF
    old = p.fdr[fd]
    if (old & CAP_DUP) == 0 or (rights & (~old)) != 0:
        return EPERM
    if gr_fd(p, fd, "dup") != 0:
        return EACCES
    n = fd_free(p)
    if n == NFD:
        return EMFILE
    p.fds[n] = file_get(p.fds[fd])
    p.fdr[n] = rights
    return n

def sys_rights(fd: u64) -> u64:
    p = cur_proc()
    if fd >= NFD or p.fds[fd] == 0:
        return EBADF
    return p.fdr[fd]

def user_ptr_ok(va: u64, len: u64) -> u64:
# only the range check: the copy itself survives unmapped pages through the #PF fixup
    return va < USER_TOP and va + len <= USER_TOP and va + len >= va

def con_write_user(p: u64, n: u64) -> u64:
    kb: u8[256]
    done: u64 = 0
    while done < n:
        k = n - done
        if k > 256:
            k = 256
        if copy_user(u64(addr(kb[0])), p + done, k) != 0:
            return EFAULT
        spin_lock_irq_con()
        i = 0
        while i < k:
            putc(kb[i])
            i += 1
        spin_unlock_irq_con()
        done += k
    return n

@export
def syscall_dispatch(nr: u64, a: u64, b: u64, c: u64, d: u64, frame: u64) -> u64:
# the syscall entry stubs call this; every native syscall result passes the nondeterminism hook (nondet.cudi)
    return nd_hook(ND_SYSCALL, nr, syscall_do(nr, a, b, c, d, frame))

@unsafe
def syscall_do(nr: u64, a: u64, b: u64, c: u64, d: u64, frame: u64) -> u64:
# entered with interrupts off (FMASK); the asm exit path disables them again before sysret
    atomic_fetch_add(addr(syscalls), 1, acq_rel)
    sti()
    st = cur_thread()
    st.sc[0] = nr
    st.sc[1] = a
    st.sc[2] = b
    st.sc[3] = c
    st.sc[4] = d
    if kx_should_park():
        kx_park()
    if cur_proc().abi == LX_ABI:
    # 11.1: a Linux-personality process reaches only the Linux table; no Forge syscall is visible
        lx_exit_check()  # 11.1b: a pending group exit ends this thread here
        sf = ptr[SFrame](frame)  # 11.1d: r8/r9 (5th/6th arguments) and the signal code's view
        r: u64 = 0
        if nr == 9:
            f = irq_save()  # 11.1b: the process's threads share one CPU; irqs off serialises mm state
            r = lx_mmap(a, b, c, d, sf.r8, sf.r9)
            irq_restore(f)
        elif nr == 56:
            r = lx_clone(frame, a, b, c, d, sf.r8)
        elif nr == 57:
            r = lx_fork(frame)
        elif nr == 58:
        # item 9: Linux vfork. Implemented as the same eager-copy fork as 57:
        # address spaces are not shared and the parent is not suspended. Ash
        # uses vfork to run an external command; a shared-memory vfork is not needed.
            r = lx_fork(frame)
        elif nr == 61:
            r = lx_wait4(a, b, c, d)
        elif nr == 59:
            r = lx_execve(frame, LX_NODIR, a, b, 0)  # 11.1d
        elif nr == 322:
            r = lx_execve(frame, a, b, c, sf.r8)
        elif nr == 15:
            r = lx_sigreturn(sf)  # 11.1d: the frame comes back from the user stack
        elif nr == 158:
        # 11.1b: arch_prctl may change this thread's FS base; load it now (sched.cudi reloads on switches)
            r = lx_arch_prctl(a, b)
            wrmsr(MSR_FS_BASE, cur_thread().fsbase)
        else:
            r = lx_dispatch(nr, a, b, c, d)
        return lx_sig_deliver(sf, r)  # 11.1d: a pending unblocked signal runs before user code resumes
    need = sys_need(nr)
    if need != 0:
        sp = cur_proc()
        if (sp.caps & need) == 0:
            return cap_sys_deny(sp, nr, need)
    if nr == 0:
        return sys_read(a, b, c)
    if nr == 1:
        return sys_write(a, b, c)
    if nr == 2:
        return sys_open(a)
    if nr == 3:
        return sys_close(a)
    if nr == 4:
        return sys_stat(a, b)
    if nr == 9:
        return sys_mmap(b)
    if nr == 11:
        return sys_munmap(a, b)
    if nr == 12:
        return sys_brk(a)
    if nr == 24:
        yield_cpu()
        return 0
    if nr == 39:
        return sys_getpid()
    if nr == 57:
        return sys_fork(frame, 0)
    if nr == 59:
        return sys_exec(frame, a, b, 0)
    if nr == 60:
        proc_exit(a & 0xFF)
    if nr == 61:
        return sys_wait(a, b)
    if nr == 420:
        return sys_dup(a, b)
    if nr == 421:
        return sys_openat(a, b)
    if nr == 422:
        return sys_rights(a)
    if nr == 426:
        return sys_exec(frame, a, b, 1)
    if nr == 427:
        return sys_restrict(a, b)
    if nr == 428:
        return sys_grant_revoke(a)
    if nr == 429:
        return sys_grant_list()
    if nr == 430:
        return sys_audit_dump()
    if nr == 431:
        return sys_win_open(a, b, c)
    if nr == 432:
        return sys_win_fill(a, b, c)
    if nr == 433:
        return sys_win_text(a, b, c)
    if nr == 423:
        return sys_chan_create(a)
    if nr == 424:
        return sys_chan_send(a, b, c, d)
    if nr == 425:
        return sys_chan_recv(a, b, c, d)
    if nr == 78:
        return sys_getdents(a, b, c)
    if nr == 96:
        return lapic_ticks
    if nr == 97:
        return lapic_cpu()
    if nr == 110:
        return sys_getppid()
    if nr == 200:
    # self-test probes: 1 = kernel read of user memory without stac, 2 = kernel call into user code
        if user_ptr_ok(b, 8) == 0:
            return EFAULT
        if a == 1:
            return smap_probe(b)
        if a == 2:
            smep_probing = 1
            r = smep_probe(b)
            smep_probing = 0
            return r
        if a == 3:
            return u64(smep_on) | (u64(smap_on) << 1)
        return EINVAL
    if nr == 409:
        return sys_kexec(frame, a)
    if nr == 410:
        return kx_gen
    if nr >= 411 and nr <= 413:
        return sys_kbd(nr, a, b, c, d)
    if nr >= 414 and nr <= 418:
        return sys_nvs(nr, a, b, c)
    if nr >= 400 and nr <= 408:
        return sys_drv(nr, a, b, c)
    if nr == 300:
    # getargs(buf, n): the argument string given to exec
        p = cur_proc()
        l: u64 = 0
        while l < 127 and p.args[l] != 0:
            l += 1
        if l + 1 > b:
            return EINVAL
        if user_ptr_ok(a, l + 1) == 0 or copy_user(a, u64(addr(p.args[0])), l + 1) != 0:
            return EFAULT
        return l
    return ENOSYS

def user_kill(name: ptr[u8], vec: u64, rip: u64, addr_: u64):
# called from an exception taken in ring 3: report, and the process exits with 0x100 + vector
    t = cur_thread()
    atomic_fetch_add(addr(user_kills), 1, acq_rel)
    spin_lock(addr(con_lock))
    puts("user fault: pid ")
    put_u64(t.id)
    puts(" ")
    puts(name)
    puts(" at rip=")
    put_hex(rip)
    puts(" addr=")
    put_hex(addr_)
    puts(" -> killed\n")
    spin_unlock(addr(con_lock))
    proc_exit(0x100 + vec)
