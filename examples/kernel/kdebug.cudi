# kdebug.cudi: boot diagnostics only the test/debug kernel carries (inv213, docs/kernel-core.md "Test/debug and
# release kernels"). kernel.cud includes this file; `build/kernel-build --release` (examples/kernel/build.sh
# --release) compiles it with krelease.cudi instead, whose kdbg_* hooks do nothing, so the release kernel has no
# hang probe and never prints its KASLR layout. The kernel the OS tests boot (build/kernel/kernel.elf, the ISO's)
# is always this test/debug build. The KASLR itself (slide, relocation, alias unmap, heap/stack slots) is the
# same in both builds; only the lines that report it and the unslid-alias self-check are here.

def kdbg_kaslr_image():
# after kaslr_unmap dropped the link-address alias (tests/os/run.sh os/kaslr, tests/dwarf read the slide)
    puts("KASLR: kernel image at ")
    put_hex(ksym(0))
    puts(" (slide ")
    put_hex(kslide)
    puts(", ")
    put_u64(krel_count)
    puts(" relocations applied), link-address alias unmapped\n")

def kdbg_kaslr_dyn():
# the big heap and thread stack slots canary_init picked (os/kaslr counts distinct layouts)
    puts("KASLR: big heap at ")
    put_hex(heap_big_next)
    puts(", thread stacks at ")
    put_hex(kstack_next)
    putc(10)

def kdbg_kaslr_unslid():
# self-check: the image is no longer mapped at its link address once it slid (os/kaslr "unslid .text")
    check_mapping("unslid .text", ksym(0) - kslide, u64(kslide == 0))

def probe_put(n: ptr[u8], p: ptr[u64]):
    puts(" ")
    puts(n)
    puts("@0x")
    put_hexn(u64(p), 16)

def kdbg_hang_probe():
# (hang_probe_line before inv213)
# one boot line with the runtime (slid) addresses of the input counters; at a HANG the boot harness reads them
# with the monitor (x/1gx on cpu 0) from the last such line, so a kexec'd kernel reports its own. Diagnostic only:
# nothing reads it in the kernel (inv203: was a typed line lost before or after the guest read it?)
    puts("hang probe:")
    probe_put("kbd_irqs", addr(kbd_irqs))
    probe_put("ps2_rd", addr(ps2_rd))
    probe_put("com_irqs", addr(com_irqs))
    probe_put("kb_in", addr(kb_in))
    probe_put("kb_head", addr(kb_head))
    probe_put("kb_ack", addr(kb_ack))
    probe_put("kb_take", addr(kb_take))
    probe_put("kb_commits", addr(kb_commits))
    probe_put("kb_restarts", addr(kb_restarts))
    probe_put("kb_dropped", addr(kb_dropped))
    probe_put("kb_up", addr(kb_up))
    probe_put("kb_ready", addr(kb_ready))
    probe_put("kb_quit", addr(kb_quit))
    probe_put("tty_pushed", addr(tty_pushed))
    probe_put("tty_popped", addr(tty_popped))
    probe_put("lapic_ticks", addr(lapic_ticks))
    probe_put("i0_max", addr(i0_max))
    probe_put("i0_max_tick", addr(i0_max_tick))
    probe_put("i0_over", addr(i0_over))
    probe_put("i0_stalls", addr(i0_stalls))
    putc(10)

def kdbg_paging(pml4: u64):
# 0.23.1: the physical page-table root and the frames used so far, once paging_init built the tables
# (physical layout: test/debug only)
    puts("page tables built: pml4 at ")
    put_hex(pml4)
    puts(", frames used ")
    put_u64(frames_total - frames_free)
    putc(10)

def kdbg_higher_half(rsp: u64):
# 0.23.1: kmain_high's slid address and the boot stack pointer; they give away the image slide, so the
# release kernel does not print them (rsp is read_rsp() in kmain_high, as before)
    puts("higher half: rip ")
    put_hex(u64(kmain_high))
    puts(", rsp ")
    put_hex(rsp)
    putc(10)

# Interrupts-off watch on CPU 0 (diagnostic only, inv203): CPU 0 is the only IRQ1 target, and the inv203 hang lost
# the tail of a typed line, as if CPU 0 had not taken interrupts for seconds. Its LAPIC timer stays pending while
# IF=0, so the gap between two CPU 0 timer interrupts bounds the longest interrupts-off stretch (to one tick). One
# rdtsc per CPU 0 tick, in the test/debug kernel only (0.23.1: moved here from apic.cudi; on_lapic_timer calls
# kdbg_tick0, and krelease.cudi's stub does nothing, so a release kernel has no watch); nothing in the kernel reads
# these. Reported at the end of the shell session (kdbg_watch_report) and in the hang probe. Gaps are raw TSC
# time, and under QEMU the TSC follows host time while the guest is not run: in
# kbs-s1 a 126 s, 304 s and 140 s gap each matched a whole-box freeze the harness measured, to the millisecond.
# Gaps of I0_STALL_MS or more are therefore counted apart as "guest not running" (i0_stalls, i0_stall_max) and
# kept out of i0_max and i0_over. Both are printed; nothing is judged on either.
I0_WARN_MS = 250
I0_STALL_MS = 5000
i0_last: u64
i0_max: u64  # longest gap under I0_STALL_MS, TSC ticks
i0_max_tick: u64  # lapic_ticks when the longest gap ended
i0_over: u64  # gaps over I0_WARN_MS (and under I0_STALL_MS)
i0_stalls: u64  # gaps of I0_STALL_MS or more: guest not running (box or vCPU stalled)
i0_stall_max: u64  # longest such gap, TSC ticks

def i0_watch():
    n = rdtsc()
    if i0_last != 0 and tsc_per_ms != 0:
        d = n - i0_last
        if d >= tsc_per_ms * I0_STALL_MS:
            i0_stalls += 1
            if d > i0_stall_max:
                i0_stall_max = d
        else:
            if d > i0_max:
                i0_max = d
                i0_max_tick = lapic_ticks
            if d > tsc_per_ms * I0_WARN_MS:
                i0_over += 1
    i0_last = n

def i0_reset():
# start of the shell session: the window the boot test types into
    i0_last = 0
    i0_max = 0
    i0_max_tick = 0
    i0_over = 0
    i0_stalls = 0
    i0_stall_max = 0

def i0_ms(t: u64):
    if tsc_per_ms != 0:
        put_u64(t / tsc_per_ms)
    else:
        putc(63)

def i0_report():
    puts("irq-off watch: cpu0 longest gap between timer interrupts ")
    i0_ms(i0_max)
    puts(" ms (at tick ")
    put_u64(i0_max_tick)
    puts("), gaps over 250 ms: ")
    put_u64(i0_over)
    puts("; guest not running (gaps of 5 s or more): ")
    put_u64(i0_stalls)
    puts(", longest ")
    i0_ms(i0_stall_max)
    puts(" ms\n")


def kdbg_tick0():
# 0.23.1: CPU 0's timer interrupt (apic.cudi on_lapic_timer): the irq-off watch, one rdtsc per tick
    i0_watch()

def kdbg_watch_reset():
# start of the shell session: the irq-off watch window (tests/os/run.sh os/irq-off-watch)
    i0_reset()

def kdbg_watch_report():
# end of the shell session: the "irq-off watch: ..." line
    i0_report()
