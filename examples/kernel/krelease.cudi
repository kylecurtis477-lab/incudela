# krelease.cudi: the release kernel's stand-ins for kdebug.cudi (inv213). `build/kernel-build --release`
# compiles kernel.cud with this file in place of kdebug.cudi: no hang probe, no KASLR layout lines and no
# unslid-alias self-check, so a release kernel never prints its addresses for them. KASLR itself is unchanged.

def kdbg_kaslr_image():
    return

def kdbg_kaslr_dyn():
    return

def kdbg_kaslr_unslid():
    return

def kdbg_hang_probe():
    return

# 0.23.1: no page-table root or higher-half addresses on the console, and no irq-off watch (no per-tick rdtsc
# on CPU 0, no "irq-off watch:" line)
def kdbg_paging(pml4: u64):
    return

def kdbg_higher_half(rsp: u64):
    return

def kdbg_tick0():
    return

def kdbg_watch_reset():
    return

def kdbg_watch_report():
    return
