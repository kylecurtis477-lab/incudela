# cuditor: no-runtime
# cuditor: caps()
# Item 9 Linux-ABI pipe, fork, wait4, file-backed mmap and AF_UNIX socket test (docs/linux-compat.md).
# Built and sealed like lxtest (EI_OSABI = 3, examples/user/build.sh) and launched only with sh
# `run lxipc` in the compat sandbox. Raw Linux syscalls only. Checks pipe (22) / pipe2 (293),
# fork (57), vfork (58, same eager-copy fork), fork-style clone (56), wait4 (61), a MAP_PRIVATE
# file mapping of a granted file, socketpair 53, and socket/bind/listen/connect/accept on an
# AF_UNIX SOCK_STREAM abstract address (sun_path[0] == 0). A pathname bind is EOPNOTSUPP.
# A write to a pipe or socket with no reader raises SIGPIPE (default action ends the process;
# SIG_IGN then the write returns EPIPE). socketpair and socket accept SOCK_NONBLOCK; a
# non-blocking read, write or accept that would wait returns EAGAIN; fcntl F_SETFL can set
# O_NONBLOCK on a socket, and ppoll reports real POLLIN/POLLOUT for sockets and waits when
# only they are in the set. Syscall 409 stays unreachable (ENOSYS). Syscalls 408/409 stay
# ktest_hooks gated. The kernel unsafe cap is unchanged (709).

ENOSYS = 0xFFFFFFFFFFFFFFDA
EINVAL = 0xFFFFFFFFFFFFFFEA
EFAULT = 0xFFFFFFFFFFFFFFF2
EPIPE = 0xFFFFFFFFFFFFFFE0
ESPIPE = 0xFFFFFFFFFFFFFFE3
EACCES = 0xFFFFFFFFFFFFFFF3
EBADF = 0xFFFFFFFFFFFFFFF7
EAFNOSUPPORT = 0xFFFFFFFFFFFFFF9F
EPROTONOSUPPORT = 0xFFFFFFFFFFFFFFA3
ESOCKTNOSUPPORT = 0xFFFFFFFFFFFFFFA2
EOPNOTSUPP = 0xFFFFFFFFFFFFFFA1
ENOTCONN = 0xFFFFFFFFFFFFFF95
EISCONN = 0xFFFFFFFFFFFFFF96
EADDRINUSE = 0xFFFFFFFFFFFFFF9E
ECONNREFUSED = 0xFFFFFFFFFFFFFF91
EDESTADDRREQ = 0xFFFFFFFFFFFFFFA7
EMSGSIZE = 0xFFFFFFFFFFFFFFA6
ENOTSOCK = 0xFFFFFFFFFFFFFFA8
SIGPIPE = 13
EAGAIN = 0xFFFFFFFFFFFFFFF5
SOCK_CLOEXEC = 0x80000
SOCK_NONBLOCK = 0x800

fails: u64
checks: u64
buf: u8[256]
blen: u64
fds: u32[2]
st: u64[18]
msg: u8[8]
got: u8[8]
path: u8[40]
status: u32[1]
sa: u64[4]
pfd: u64[1]
sun: u8[16]
sun2: u8[16]
dn: u8[16]
dc: u8[16]
pn: u8[16]
an: u8[16]
alen: u32[1]
big: u8[600]
rb: u8[512]
lx_a6: u64

@naked
def lsys(n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64:
    asm("mov %rdi,%rax", "mov %rsi,%rdi", "mov %rdx,%rsi", "mov %rcx,%rdx", "mov %r8,%r10",
        "mov %r9,%r8", "mov lx_a6(%rip),%r9", "syscall", "ret")

@unsafe
def peek(a: u64) -> u64:
    return ptr[u64](a)[0]

@unsafe
def peek8(a: u64) -> u64:
    return u64(ptr[u8](a)[0])

def flush():
    lsys(1, 1, u64(addr(buf[0])), blen, 0, 0)
    blen = 0

def putz(p: u64):
    i: u64 = 0
    while peek8(p + i) != 0 and blen < 255 and i < 200:
        buf[blen] = u8(peek8(p + i))
        blen += 1
        i += 1

def put(s: ptr[u8]):
    putz(u64(s))

def putn(n: u64):
    if n >= 10:
        putn(n / 10)
    if blen < 255:
        buf[blen] = u8(48 + n % 10)
        blen += 1

def check(ok: u64, what: ptr[u8]):
    checks += 1
    if ok == 0:
        fails += 1
        put("lxipc: FAIL ")
        put(what)
        put("\n")
        flush()

# sendto (44) and recvfrom (45) take six arguments; lsys carries five, and the sixth (r9) comes from
# lx_a6 (0 for every other call).
def sendto(fd: u64, b: u64, n: u64, fl: u64, dst: u64, dl: u64) -> u64:
    lx_a6 = dl
    r = lsys(44, fd, b, n, fl, dst)
    lx_a6 = 0
    return r

def recvfrom(fd: u64, b: u64, n: u64, fl: u64, src: u64, lp: u64) -> u64:
    lx_a6 = lp
    r = lsys(45, fd, b, n, fl, src)
    lx_a6 = 0
    return r

def lx_main(sp: u64):
    msg[0] = 104
    msg[1] = 101
    msg[2] = 108
    msg[3] = 108
    msg[4] = 111
    r = lsys(22, u64(addr(fds[0])), 0, 0, 0, 0)
    check(r == 0, "pipe")
    check(fds[1] != fds[0], "pipe fds distinct")
    wr = lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "pipe write 5")
    rd = lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5, "pipe read 5")
    check(got[0] == 104 and got[4] == 111, "pipe bytes")
    check(lsys(5, u64(fds[0]), u64(addr(st[0])), 0, 0, 0) == 0, "fstat read end")
    check((st[3] & 0xFFFF) == 0x1180, "fstat S_IFIFO 0600")
    check(lsys(8, u64(fds[0]), 0, 0, 0, 0) == ESPIPE, "lseek pipe -> ESPIPE")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0) == 0, "close-write then read EOF")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    r = lsys(22, u64(addr(fds[0])), 0, 0, 0, 0)
    check(r == 0, "pipe for SIGPIPE")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
        lsys(231, 42, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork SIGPIPE pipe child")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid, "wait4 SIGPIPE pipe child")
    check(status[0] == (141 << 8), "wait4 SIGPIPE pipe status 141")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    r = lsys(53, 1, 1, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair for SIGPIPE")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
        lsys(231, 42, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork SIGPIPE socket child")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid, "wait4 SIGPIPE socket child")
    check(status[0] == (141 << 8), "wait4 SIGPIPE socket status 141")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    sa[0] = 1
    sa[1] = 0
    sa[2] = 0
    sa[3] = 0
    check(lsys(13, SIGPIPE, u64(addr(sa[0])), 0, 8, 0) == 0, "sigaction SIGPIPE SIG_IGN")
    r = lsys(22, u64(addr(fds[0])), 0, 0, 0, 0)
    check(r == 0, "pipe again")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    check(lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0) == EPIPE, "close-read then write EPIPE")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    r = lsys(293, u64(addr(fds[0])), 0x80000, 0, 0, 0)
    check(r == 0, "pipe2 O_CLOEXEC")
    check(lsys(72, u64(fds[0]), 1, 0, 0, 0) == 1, "pipe2 GETFD FD_CLOEXEC")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(22, 0x10, 0, 0, 0, 0) == EFAULT, "pipe bad pointer -> EFAULT")
    check(lsys(293, u64(addr(fds[0])), 0x800, 0, 0, 0) == EINVAL, "pipe2 O_NONBLOCK -> EINVAL")
    check(lsys(409, 0, 0, 0, 0, 0) == ENOSYS, "syscall 409 -> ENOSYS")
    put("lxipc: pipe write/read 5 bytes, fstat S_IFIFO, close-write EOF, close-read EPIPE\n")
    flush()
    put("lxipc: SIGPIPE default ends a pipe or socket writer; SIG_IGN then write returns EPIPE\n")
    flush()
    put("lxipc: pipe2 O_CLOEXEC, EFAULT, lseek ESPIPE, syscall 409 -> ENOSYS\n")
    flush()
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 7, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork parent")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid, "wait4 fork pid")
    check(status[0] == (7 << 8), "wait4 status 7")
    pid = lsys(56, 17, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 0, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "clone(SIGCHLD) parent")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid and status[0] == 0, "wait4 clone status 0")
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 3, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork for wait4 EFAULT")
    r = lsys(61, pid, 0xFFFF800000001000, 0, 0, 0)
    check(r == EFAULT, "wait4 bad pointer -> EFAULT")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid and status[0] == (3 << 8), "wait4 reaps after EFAULT")
    pid = lsys(58, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 9, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "vfork parent")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid, "wait4 vfork pid")
    check(status[0] == (9 << 8), "wait4 vfork status 9")
    put("lxipc: fork, vfork and clone(SIGCHLD) children reaped by wait4\n")
    flush()
    pth = "/efi/incudela/docs/hello.sh"
    i: u64 = 0
    while peek8(u64(pth) + i) != 0:
        path[i] = u8(peek8(u64(pth) + i))
        i += 1
    path[i] = 0
    fd = lsys(2, u64(addr(path[0])), 0, 0, 0, 0)
    check((fd >> 63) == 0, "open hello.sh")
    va = lsys(9, 0, 4096, 1, 2, fd)
    check((va >> 63) == 0 and va != 0, "mmap file MAP_PRIVATE")
    check(peek8(va) == 35 and peek8(va + 2) == 70, "mmap shows # F of hello.sh")
    check(lsys(9, 0, 4096, 3, 1, fd) == EACCES, "mmap MAP_SHARED+WRITE -> EACCES")
    check(lsys(11, va, 4096, 0, 0, 0) == 0, "munmap")
    lsys(3, fd, 0, 0, 0, 0)
    check(lsys(9, 0, 4096, 1, 2, 99) == EBADF, "mmap bad fd -> EBADF")
    put("lxipc: file-backed mmap of hello.sh, MAP_SHARED+WRITE EACCES, bad fd EBADF\n")
    flush()
    r = lsys(53, 1, 1, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair")
    check(fds[1] != fds[0], "socketpair fds distinct")
    wr = lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "socketpair write 0->1")
    rd = lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5, "socketpair read 1")
    check(got[0] == 104 and got[4] == 111, "socketpair 0->1 bytes")
    wr = lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "socketpair write 1->0")
    rd = lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5, "socketpair read 0")
    check(got[0] == 104 and got[4] == 111, "socketpair 1->0 bytes")
    check(lsys(5, u64(fds[0]), u64(addr(st[0])), 0, 0, 0) == 0, "fstat socket")
    check((st[3] & 0xFFFF) == 0xC180, "fstat S_IFSOCK 0600")
    check(lsys(8, u64(fds[0]), 0, 0, 0, 0) == ESPIPE, "lseek socket -> ESPIPE")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    check(lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0) == 0, "close peer then read EOF")
    check(lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0) == EPIPE, "close peer then write EPIPE")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    r = lsys(53, 1, 1 | 0x80000, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair SOCK_CLOEXEC")
    check(lsys(72, u64(fds[0]), 1, 0, 0, 0) == 1, "socketpair GETFD FD_CLOEXEC")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(53, 1, 1, 0, 0x10, 0) == EFAULT, "socketpair bad pointer -> EFAULT")
    r = lsys(53, 1, 1 | 0x800, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair SOCK_NONBLOCK")
    check((lsys(72, u64(fds[0]), 3, 0, 0, 0) & 0x800) != 0, "GETFL O_NONBLOCK")
    check(lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0) == EAGAIN, "nonblock read empty -> EAGAIN")
    wr = lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "nonblock write 0->1")
    pfd[0] = u64(fds[1]) | (u64(1) << 32)
    check(lsys(271, u64(addr(pfd[0])), 1, 0, 0, 0) == 1, "ppoll POLLIN ready")
    check(((pfd[0] >> 48) & 0xFFFF) == 1, "ppoll revents POLLIN")
    rd = lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5 and got[0] == 104 and got[4] == 111, "nonblock 0->1 bytes")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    r = lsys(53, 1, 1, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair for SETFL")
    check(lsys(72, u64(fds[0]), 4, 0x800 | 2, 0, 0) == 0, "SETFL O_NONBLOCK")
    check((lsys(72, u64(fds[0]), 3, 0, 0, 0) & 0x800) != 0, "GETFL after SETFL")
    check(lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0) == EAGAIN, "SETFL then read empty -> EAGAIN")
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
        lsys(231, 0, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork ppoll waiter")
    pfd[0] = u64(fds[0]) | (u64(1) << 32)
    check(lsys(271, u64(addr(pfd[0])), 1, 0, 0, 0) == 1, "ppoll waits then POLLIN")
    check(((pfd[0] >> 48) & 0xFFFF) == 1, "ppoll wait revents POLLIN")
    rd = lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5 and got[0] == 104, "ppoll wait read")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid and status[0] == 0, "wait4 ppoll child")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(53, 2, 1, 0, u64(addr(fds[0])), 0) == EAFNOSUPPORT, "socketpair AF_INET -> EAFNOSUPPORT")
    check(lsys(53, 1, 3, 0, u64(addr(fds[0])), 0) == ESOCKTNOSUPPORT, "socketpair SOCK_RAW -> ESOCKTNOSUPPORT")
    check(lsys(53, 1, 1, 1, u64(addr(fds[0])), 0) == EPROTONOSUPPORT, "socketpair protocol 1 -> EPROTONOSUPPORT")
    check(lsys(41, 2, 1, 0, 0, 0) == EAFNOSUPPORT, "socket AF_INET -> EAFNOSUPPORT")
    check(lsys(41, 1, 3, 0, 0, 0) == ESOCKTNOSUPPORT, "socket SOCK_RAW -> ESOCKTNOSUPPORT")
    check(lsys(41, 1, 1, 1, 0, 0) == EPROTONOSUPPORT, "socket protocol 1 -> EPROTONOSUPPORT")
    s = lsys(41, 1, 1, 0, 0, 0)
    check((s >> 63) == 0, "socket")
    check(lsys(5, s, u64(addr(st[0])), 0, 0, 0) == 0, "fstat unbound socket")
    check((st[3] & 0xFFFF) == 0xC180, "fstat socket S_IFSOCK 0600")
    check(lsys(1, s, u64(addr(msg[0])), 5, 0, 0) == ENOTCONN, "write unbound -> ENOTCONN")
    check(lsys(0, s, u64(addr(got[0])), 8, 0, 0) == ENOTCONN, "read unbound -> ENOTCONN")
    check(lsys(49, 0x20, u64(addr(sun[0])), 8, 0, 0) == EBADF, "bind bad fd -> EBADF")
    sun[0] = 1
    sun[1] = 0
    sun[2] = 0
    sun[3] = 108
    sun[4] = 120
    sun[5] = 105
    sun[6] = 112
    sun[7] = 99
    check(lsys(49, s, u64(addr(sun[0])), 8, 0, 0) == 0, "bind abstract")
    check(lsys(49, s, u64(addr(sun[0])), 8, 0, 0) == EINVAL, "bind already bound -> EINVAL")
    s2 = lsys(41, 1, 1, 0, 0, 0)
    check((s2 >> 63) == 0, "socket for EADDRINUSE")
    check(lsys(49, s2, u64(addr(sun[0])), 8, 0, 0) == EADDRINUSE, "bind EADDRINUSE")
    sun2[0] = 1
    sun2[1] = 0
    sun2[2] = 47
    sun2[3] = 100
    sun2[4] = 97
    sun2[5] = 116
    sun2[6] = 97
    sun2[7] = 47
    sun2[8] = 115
    check(lsys(49, s2, u64(addr(sun2[0])), 9, 0, 0) == EOPNOTSUPP, "bind pathname -> EOPNOTSUPP")
    lsys(3, s2, 0, 0, 0, 0)
    check(lsys(50, s, 1, 0, 0, 0) == 0, "listen")
    r = lsys(53, 1, 1, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair for listen EINVAL")
    check(lsys(50, u64(fds[0]), 1, 0, 0, 0) == EINVAL, "listen on socketpair -> EINVAL")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    c = lsys(41, 1, 1, 0, 0, 0)
    check((c >> 63) == 0, "socket client")
    sun2[0] = 1
    sun2[1] = 0
    sun2[2] = 0
    sun2[3] = 110
    sun2[4] = 111
    check(lsys(42, c, u64(addr(sun2[0])), 5, 0, 0) == ECONNREFUSED, "connect missing -> ECONNREFUSED")
    check(lsys(42, c, u64(addr(sun[0])), 8, 0, 0) == 0, "connect")
    check(lsys(42, c, u64(addr(sun[0])), 8, 0, 0) == EISCONN, "connect already connected -> EISCONN")
    a = lsys(43, s, 0, 0, 0, 0)
    check((a >> 63) == 0, "accept")
    wr = lsys(1, c, u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "connect write 5")
    rd = lsys(0, a, u64(addr(got[0])), 8, 0, 0)
    check(rd == 5 and got[0] == 104 and got[4] == 111, "accept read 5")
    wr = lsys(1, a, u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "accept write 5")
    rd = lsys(0, c, u64(addr(got[0])), 8, 0, 0)
    check(rd == 5 and got[0] == 104, "connect read 5")
    lsys(3, c, 0, 0, 0, 0)
    lsys(3, a, 0, 0, 0, 0)
    c = lsys(41, 1, 1, 0, 0, 0)
    check(lsys(42, c, u64(addr(sun[0])), 8, 0, 0) == 0, "connect for accept4")
    a = lsys(288, s, 0, 0, SOCK_CLOEXEC, 0)
    check((a >> 63) == 0, "accept4 SOCK_CLOEXEC")
    check(lsys(72, a, 1, 0, 0, 0) == 1, "accept4 GETFD FD_CLOEXEC")
    lsys(3, c, 0, 0, 0, 0)
    lsys(3, a, 0, 0, 0, 0)
    check(lsys(72, s, 4, SOCK_NONBLOCK, 0, 0) == 0, "F_SETFL O_NONBLOCK on listener")
    check(lsys(43, s, 0, 0, 0, 0) == EAGAIN, "nonblock accept empty -> EAGAIN")
    lsys(3, s, 0, 0, 0, 0)
    c = lsys(41, 1, 1, 0, 0, 0)
    check(lsys(42, c, u64(addr(sun[0])), 8, 0, 0) == ECONNREFUSED, "connect after listen close -> ECONNREFUSED")
    lsys(3, c, 0, 0, 0, 0)
    # AF_UNIX SOCK_DGRAM: socketpair, message boundaries, truncation, empty datagrams
    r = lsys(53, 1, 2, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair SOCK_DGRAM")
    check(lsys(5, u64(fds[0]), u64(addr(st[0])), 0, 0, 0) == 0, "fstat dgram end")
    check((st[3] & 0xFFFF) == 0xC180, "fstat dgram S_IFSOCK 0600")
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0) == 5, "dgram write 5")
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 3, 0, 0) == 3, "dgram write 3")
    rd = lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5 and got[0] == 104 and got[4] == 111, "dgram read returns one message (5 of 8)")
    rd = lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 3, "dgram second message 3")
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0) == 5, "dgram write 5 for short read")
    rd = lsys(0, u64(fds[1]), u64(addr(got[0])), 2, 0, 0)
    check(rd == 2 and got[1] == 101, "dgram short read returns 2")
    check(recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0x40, 0, 0) == EAGAIN, "dgram rest dropped after short read")
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 0, 0, 0) == 0, "dgram empty write")
    pfd[0] = u64(fds[1]) | (u64(1) << 32)
    check(lsys(271, u64(addr(pfd[0])), 1, 0, 0, 0) == 1, "ppoll sees a queued empty datagram")
    check(((pfd[0] >> 48) & 0xFFFF) == 1, "ppoll empty datagram revents POLLIN")
    check(lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0) == 0, "dgram empty read returns 0")
    check(recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0x40, 0, 0) == EAGAIN, "dgram empty message consumed")
    check(lsys(1, u64(fds[1]), u64(addr(msg[0])), 4, 0, 0) == 4, "dgram write other direction")
    rd = lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 4, "dgram read other direction")
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0) == 5, "dgram write for ppoll")
    pfd[0] = u64(fds[1]) | (u64(5) << 32)
    check(lsys(271, u64(addr(pfd[0])), 1, 0, 0, 0) == 1, "ppoll POLLIN|POLLOUT")
    check(((pfd[0] >> 48) & 0xFFFF) == 5, "ppoll dgram revents POLLIN|POLLOUT")
    check(lsys(0, u64(fds[1]), u64(addr(got[0])), 8, 0, 0) == 5, "dgram drain")
    check(lsys(1, u64(fds[0]), u64(addr(big[0])), 600, 0, 0) == EMSGSIZE, "dgram write 600 -> EMSGSIZE")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 1, 0, 0) == EOPNOTSUPP, "sendto MSG_OOB -> EOPNOTSUPP")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0x40, 0, 0) == 5, "sendto MSG_DONTWAIT on a pair")
    rd = recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0, 0, 0)
    check(rd == 5, "recvfrom on a pair")
    dn[0] = 1
    dn[1] = 0
    dn[2] = 0
    dn[3] = 100
    dn[4] = 103
    dn[5] = 115
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == EISCONN, "sendto a name on a connected pair -> EISCONN")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0, 0, 0) == 5, "sendto no address on a pair")
    alen[0] = 16
    rd = recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0, u64(addr(an[0])), u64(addr(alen[0])))
    check(rd == 5 and alen[0] == 0, "recvfrom unnamed sender: addrlen 0")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0, 0, 0) == 5, "sendto for bad addrlen pointer")
    check(recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0x40, u64(addr(an[0])), 8) == EFAULT, "recvfrom bad addrlen pointer -> EFAULT")
    check(recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0x40, 0, 0) == 5, "message kept after EFAULT")
    check(sendto(0x20, u64(addr(msg[0])), 5, 0, 0, 0) == EBADF, "sendto bad fd -> EBADF")
    check(recvfrom(0x20, u64(addr(got[0])), 8, 0, 0, 0) == EBADF, "recvfrom bad fd -> EBADF")
    check(sendto(1, u64(addr(msg[0])), 5, 0, 0, 0) == ENOTSOCK, "sendto on the console -> ENOTSOCK")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(1, u64(fds[0]), u64(addr(msg[0])), 5, 0, 0) == ECONNREFUSED, "dgram write after peer close -> ECONNREFUSED")
    check(recvfrom(u64(fds[0]), u64(addr(got[0])), 8, 0x40, 0, 0) == EAGAIN, "dgram recv after peer close, non-blocking -> EAGAIN")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    r = lsys(53, 1, 2 | SOCK_NONBLOCK, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair SOCK_DGRAM|SOCK_NONBLOCK")
    check(lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0) == EAGAIN, "dgram SOCK_NONBLOCK read empty -> EAGAIN")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    # named AF_UNIX SOCK_DGRAM sockets, sendto by abstract name
    sv = lsys(41, 1, 2, 0, 0, 0)
    check((sv >> 63) == 0, "socket SOCK_DGRAM")
    check(lsys(1, sv, u64(addr(msg[0])), 5, 0, 0) == EDESTADDRREQ, "write on unconnected dgram -> EDESTADDRREQ")
    check(sendto(sv, u64(addr(msg[0])), 5, 0, 0, 0) == EDESTADDRREQ, "sendto no address -> EDESTADDRREQ")
    check(recvfrom(sv, u64(addr(got[0])), 8, 0x40, 0, 0) == EAGAIN, "recvfrom empty unbound dgram, non-blocking -> EAGAIN")
    check(lsys(49, sv, u64(addr(dn[0])), 6, 0, 0) == 0, "bind dgram abstract name")
    cl = lsys(41, 1, 2, 0, 0, 0)
    check(lsys(49, cl, u64(addr(dn[0])), 6, 0, 0) == EADDRINUSE, "bind dgram name in use -> EADDRINUSE")
    sx = lsys(41, 1, 1, 0, 0, 0)
    check(lsys(49, sx, u64(addr(dn[0])), 6, 0, 0) == 0, "a stream socket may bind a dgram name")
    lsys(3, sx, 0, 0, 0, 0)
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == 5, "sendto a bound dgram name")
    alen[0] = 16
    rd = recvfrom(sv, u64(addr(got[0])), 8, 0, u64(addr(an[0])), u64(addr(alen[0])))
    check(rd == 5 and got[0] == 104 and alen[0] == 0, "recvfrom: message and unnamed sender")
    dc[0] = 1
    dc[1] = 0
    dc[2] = 0
    dc[3] = 100
    dc[4] = 103
    dc[5] = 99
    check(lsys(49, cl, u64(addr(dc[0])), 6, 0, 0) == 0, "bind the client dgram name")
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == 5, "sendto from a named sender")
    alen[0] = 16
    rd = recvfrom(sv, u64(addr(got[0])), 8, 0, u64(addr(an[0])), u64(addr(alen[0])))
    check(rd == 5 and alen[0] == 6, "recvfrom reports the sender name length")
    check(an[0] == 1 and an[1] == 0 and an[2] == 0 and an[3] == 100 and an[4] == 103 and an[5] == 99, "recvfrom sender name bytes")
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == 5, "sendto for a short address buffer")
    alen[0] = 3
    rd = recvfrom(sv, u64(addr(got[0])), 8, 0, u64(addr(an[0])), u64(addr(alen[0])))
    check(rd == 5 and alen[0] == 6, "short address buffer: full length reported")
    check(sendto(sv, u64(addr(msg[0])), 3, 0, u64(addr(dc[0])), 6) == 3, "sendto back to the sender's name")
    rd = recvfrom(cl, u64(addr(got[0])), 8, 0, 0, 0)
    check(rd == 3, "recvfrom the reply")
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == 5, "sendto for ppoll")
    pfd[0] = sv | (u64(1) << 32)
    check(lsys(271, u64(addr(pfd[0])), 1, 0, 0, 0) == 1, "ppoll on a bound dgram")
    check(((pfd[0] >> 48) & 0xFFFF) == 1, "ppoll bound dgram revents POLLIN")
    check(recvfrom(sv, u64(addr(got[0])), 8, 0x40, 0, 0) == 5, "drain the ppoll message")
    sun2[0] = 1
    sun2[1] = 0
    sun2[2] = 0
    sun2[3] = 110
    sun2[4] = 111
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(sun2[0])), 5) == ECONNREFUSED, "sendto a missing name -> ECONNREFUSED")
    pn[0] = 1
    pn[1] = 0
    pn[2] = 47
    pn[3] = 100
    pn[4] = 97
    pn[5] = 116
    pn[6] = 97
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(pn[0])), 7) == EOPNOTSUPP, "sendto a pathname -> EOPNOTSUPP")
    dn[0] = 2
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == EAFNOSUPPORT, "sendto bad family -> EAFNOSUPPORT")
    dn[0] = 1
    check(sendto(cl, u64(addr(big[0])), 600, 0, u64(addr(dn[0])), 6) == EMSGSIZE, "sendto 600 bytes -> EMSGSIZE")
    check(lsys(42, cl, u64(addr(dn[0])), 6, 0, 0) == EOPNOTSUPP, "connect on a dgram socket -> EOPNOTSUPP")
    check(lsys(50, sv, 1, 0, 0, 0) == EOPNOTSUPP, "listen on a dgram socket -> EOPNOTSUPP")
    check(lsys(43, sv, 0, 0, 0, 0) == EOPNOTSUPP, "accept on a dgram socket -> EOPNOTSUPP")
    # a full ring (7 frames of 512 bytes plus the 3-byte header and a 4-byte sender name) and a
    # second fill after the head has moved, so the frames wrap around the 4096-byte ring
    k = 0
    while k < 512:
        big[k] = u8(k & 255)
        k += 1
    rnd = 0
    while rnd < 2:
        k = 0
        rr = 512
        while rr == 512 and k < 20:
            rr = sendto(cl, u64(addr(big[0])), 512, 0x40, u64(addr(dn[0])), 6)
            if rr == 512:
                k += 1
        check(k == 7 and rr == EAGAIN, "ring holds 7 maximal frames, the 8th is EAGAIN")
        k = 0
        rr = 512
        while rr == 512 and k < 20:
            rr = recvfrom(sv, u64(addr(rb[0])), 512, 0x40, 0, 0)
            if rr == 512:
                k += 1
        check(k == 7 and rr == EAGAIN, "ring drains 7 frames of 512, then EAGAIN")
        check(rb[0] == 0 and rb[255] == 255 and rb[256] == 0 and rb[511] == 255, "full-size frame data intact")
        rnd += 1
    lsys(3, sv, 0, 0, 0, 0)
    check(sendto(cl, u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == ECONNREFUSED, "sendto after the receiver closed -> ECONNREFUSED")
    lsys(3, cl, 0, 0, 0, 0)
    # sendto/recvfrom on a stream socketpair are send and recv
    r = lsys(53, 1, 1, 0, u64(addr(fds[0])), 0)
    check(r == 0, "socketpair for stream sendto")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0, 0, 0) == 5, "sendto on a stream pair")
    alen[0] = 16
    rd = recvfrom(u64(fds[1]), u64(addr(got[0])), 8, 0, u64(addr(an[0])), u64(addr(alen[0])))
    check(rd == 5 and alen[0] == 0, "recvfrom on a stream pair, addrlen 0")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0, u64(addr(dn[0])), 6) == EISCONN, "sendto a name on a connected stream -> EISCONN")
    check(sendto(u64(fds[0]), u64(addr(msg[0])), 5, 0x40, 0, 0) == EOPNOTSUPP, "sendto flags on a stream -> EOPNOTSUPP")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    put("lxipc: AF_UNIX SOCK_STREAM socketpair is bidirectional, fstat S_IFSOCK, close EOF/EPIPE\n")
    flush()
    put("lxipc: SOCK_NONBLOCK and F_SETFL return EAGAIN; ppoll waits for a socket\n")
    flush()
    put("lxipc: AF_UNIX abstract bind/listen/accept/connect, pathname bind EOPNOTSUPP\n")
    flush()
    put("lxipc: AF_UNIX SOCK_DGRAM socketpair and bound names, sendto/recvfrom keep message boundaries\n")
    flush()
    if fails == 0:
        put("lxipc: PASS (")
        putn(checks)
        put(" checks)\n")
    flush()
    lsys(231, fails, 0, 0, 0, 0)

@naked
@export
def _start():
    asm("mov %rsp, %rdi", "and $-16, %rsp", "call lx_main", "ud2")
