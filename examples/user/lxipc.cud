# cuditor: no-runtime
# cuditor: caps()
# Item 9 Linux-ABI pipe, fork, wait4 and file-backed mmap test (docs/linux-compat.md). Built and
# sealed like lxtest (EI_OSABI = 3, examples/user/build.sh) and launched only with sh `run lxipc`
# in the compat sandbox. Raw Linux syscalls only. Checks pipe (22) / pipe2 (293), fork (57) and
# fork-style clone (56), wait4 (61), and a MAP_PRIVATE file mapping of a granted file. Syscall 409
# stays unreachable (ENOSYS). Syscalls 408/409 stay ktest_hooks gated. The kernel unsafe cap is
# unchanged (709).

ENOSYS = 0xFFFFFFFFFFFFFFDA
EINVAL = 0xFFFFFFFFFFFFFFEA
EFAULT = 0xFFFFFFFFFFFFFFF2
EPIPE = 0xFFFFFFFFFFFFFFE0
ESPIPE = 0xFFFFFFFFFFFFFFE3
EACCES = 0xFFFFFFFFFFFFFFF3
EBADF = 0xFFFFFFFFFFFFFFF7

fails: u64
checks: u64
buf: u8[256]
blen: u64
fds: u32[2]
st: u64[18]
msg: u8[8]
got: u8[8]
path: u8[40]
status: u32[1]

@naked
def lsys(n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64:
    asm("mov %rdi,%rax", "mov %rsi,%rdi", "mov %rdx,%rsi", "mov %rcx,%rdx", "mov %r8,%r10",
        "mov %r9,%r8", "xor %r9d,%r9d", "syscall", "ret")

@unsafe
def peek(a: u64) -> u64:
    return ptr[u64](a)[0]

@unsafe
def peek8(a: u64) -> u64:
    return u64(ptr[u8](a)[0])

def flush():
    lsys(1, 1, u64(addr(buf[0])), blen, 0, 0)
    blen = 0

def putz(p: u64):
    i: u64 = 0
    while peek8(p + i) != 0 and blen < 255 and i < 200:
        buf[blen] = u8(peek8(p + i))
        blen += 1
        i += 1

def put(s: ptr[u8]):
    putz(u64(s))

def putn(n: u64):
    if n >= 10:
        putn(n / 10)
    if blen < 255:
        buf[blen] = u8(48 + n % 10)
        blen += 1

def check(ok: u64, what: ptr[u8]):
    checks += 1
    if ok == 0:
        fails += 1
        put("lxipc: FAIL ")
        put(what)
        put("\n")
        flush()

def lx_main(sp: u64):
    msg[0] = 104
    msg[1] = 101
    msg[2] = 108
    msg[3] = 108
    msg[4] = 111
    r = lsys(22, u64(addr(fds[0])), 0, 0, 0, 0)
    check(r == 0, "pipe")
    check(fds[1] != fds[0], "pipe fds distinct")
    wr = lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0)
    check(wr == 5, "pipe write 5")
    rd = lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0)
    check(rd == 5, "pipe read 5")
    check(got[0] == 104 and got[4] == 111, "pipe bytes")
    check(lsys(5, u64(fds[0]), u64(addr(st[0])), 0, 0, 0) == 0, "fstat read end")
    check((st[3] & 0xFFFF) == 0x1180, "fstat S_IFIFO 0600")
    check(lsys(8, u64(fds[0]), 0, 0, 0, 0) == ESPIPE, "lseek pipe -> ESPIPE")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(0, u64(fds[0]), u64(addr(got[0])), 8, 0, 0) == 0, "close-write then read EOF")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    r = lsys(22, u64(addr(fds[0])), 0, 0, 0, 0)
    check(r == 0, "pipe again")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    check(lsys(1, u64(fds[1]), u64(addr(msg[0])), 5, 0, 0) == EPIPE, "close-read then write EPIPE")
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    r = lsys(293, u64(addr(fds[0])), 0x80000, 0, 0, 0)
    check(r == 0, "pipe2 O_CLOEXEC")
    check(lsys(72, u64(fds[0]), 1, 0, 0, 0) == 1, "pipe2 GETFD FD_CLOEXEC")
    lsys(3, u64(fds[0]), 0, 0, 0, 0)
    lsys(3, u64(fds[1]), 0, 0, 0, 0)
    check(lsys(22, 0x10, 0, 0, 0, 0) == EFAULT, "pipe bad pointer -> EFAULT")
    check(lsys(293, u64(addr(fds[0])), 0x800, 0, 0, 0) == EINVAL, "pipe2 O_NONBLOCK -> EINVAL")
    check(lsys(409, 0, 0, 0, 0, 0) == ENOSYS, "syscall 409 -> ENOSYS")
    put("lxipc: pipe write/read 5 bytes, fstat S_IFIFO, close-write EOF, close-read EPIPE\n")
    flush()
    put("lxipc: pipe2 O_CLOEXEC, EFAULT, lseek ESPIPE, syscall 409 -> ENOSYS\n")
    flush()
    pid = lsys(57, 0, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 7, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "fork parent")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid, "wait4 fork pid")
    check(status[0] == (7 << 8), "wait4 status 7")
    pid = lsys(56, 17, 0, 0, 0, 0)
    if pid == 0:
        lsys(231, 0, 0, 0, 0, 0)
    check((pid >> 63) == 0 and pid != 0, "clone(SIGCHLD) parent")
    status[0] = 0
    w = lsys(61, pid, u64(addr(status[0])), 0, 0, 0)
    check(w == pid and status[0] == 0, "wait4 clone status 0")
    put("lxipc: fork and clone(SIGCHLD) children reaped by wait4\n")
    flush()
    pth = "/efi/incudela/docs/hello.sh"
    i: u64 = 0
    while peek8(u64(pth) + i) != 0:
        path[i] = u8(peek8(u64(pth) + i))
        i += 1
    path[i] = 0
    fd = lsys(2, u64(addr(path[0])), 0, 0, 0, 0)
    check((fd >> 63) == 0, "open hello.sh")
    va = lsys(9, 0, 4096, 1, 2, fd)
    check((va >> 63) == 0 and va != 0, "mmap file MAP_PRIVATE")
    check(peek8(va) == 35 and peek8(va + 2) == 70, "mmap shows # F of hello.sh")
    check(lsys(9, 0, 4096, 3, 1, fd) == EACCES, "mmap MAP_SHARED+WRITE -> EACCES")
    check(lsys(11, va, 4096, 0, 0, 0) == 0, "munmap")
    lsys(3, fd, 0, 0, 0, 0)
    check(lsys(9, 0, 4096, 1, 2, 99) == EBADF, "mmap bad fd -> EBADF")
    put("lxipc: file-backed mmap of hello.sh, MAP_SHARED+WRITE EACCES, bad fd EBADF\n")
    if fails == 0:
        put("lxipc: PASS (")
        putn(checks)
        put(" checks)\n")
    flush()
    lsys(231, fails, 0, 0, 0, 0)

@naked
@export
def _start():
    asm("mov %rsp, %rdi", "and $-16, %rsp", "call lx_main", "ud2")
