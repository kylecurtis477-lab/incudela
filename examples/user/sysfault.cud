# cuditor: safe
# cuditor: no-runtime
# cuditor: caps(fs, spawn, ktest)
# Item 7 batch 3 (sustained adversarial testing): fault injection in front of sysfuzz.
#   sysfault [SEED [N]]   (defaults 1 and 50)
# Requires the kernel to have armed ktest_hooks (incudela.sysfault). Uses syscall 408
# (still ktest-capability and ktest_hooks gated; b=2/3/4) to force kmalloc failures,
# then a short user-space error-path battery, then fork+exec `sysfuzz SEED N`.
# The kernel unsafe cap is not raised. 409 is unchanged.
include "ulib.cudi"

EPERM_ = 0xFFFFFFFFFFFFFFFF
ENOMEM_ = 0xFFFFFFFFFFFFFFF4
EMFILE_ = 0xFFFFFFFFFFFFFFE8

def num(p: ptr[u8], i: ptr[u64]) -> u64:
    v: u64 = 0
    while mem_get8(u64(p) + i[0]) == 32:
        i[0] += 1
    while mem_get8(u64(p) + i[0]) >= 48 and mem_get8(u64(p) + i[0]) <= 57:
        v = v * 10 + mem_get8(u64(p) + i[0]) - 48
        i[0] += 1
    return v

def put_num(dst: ptr[u8], i: u64, v: u64) -> u64:
    d: u8[24]
    p: u64 = 24
    if v == 0:
        p -= 1
        d[p] = 48
    while v != 0:
        p -= 1
        d[p] = u8(48 + v % 10)
        v = v / 10
    while p < 24:
        mem_set8(u64(dst) + i, d[p])
        i += 1
        p += 1
    return i

def hook(a: u64, b: u64) -> u64:
    return syscall3(408, a, b, 0)

def fail(s: ptr[u8]):
    out("sysfault: FAIL ")
    out(s)
    out("\n")
    flush()
    sys_exit(1)

@export
def _start():
    ab: u8[128]
    ab[0] = 0
    sys_getargs(u64(addr(ab[0])), 128)
    pos: u64 = 0
    seed = num(addr(ab[0]), addr(pos))
    n = num(addr(ab[0]), addr(pos))
    if seed == 0:
        seed = 1
    if n == 0:
        n = 50
    out("sysfault: start seed ")
    out_u64(seed)
    out(", sysfuzz ")
    out_u64(n)
    out(" calls\n")
    flush()
    # --- ktest-gated kmalloc injection (408 b=2/3/4) ---
    if hook(0, 3) != 0:
        fail("query was not 0 at start")
    if hook(1, 2) != 0:
        fail("arm 1 was refused (ktest_hooks off?)")
    if hook(0, 3) != 1:
        fail("query after arm 1")
    if hook(0, 4) != 0:
        fail("probe should have been denied")
    if hook(0, 3) != 0:
        fail("count should be 0 after one fail")
    if hook(0, 4) != 1:
        fail("probe should have succeeded once disarmed")
    if hook(3, 2) != 0:
        fail("arm 3")
    k: u64 = 0
    while k < 3:
        if hook(0, 4) != 0:
            fail("probe in the armed window should fail")
        k += 1
    if hook(0, 4) != 1:
        fail("fourth probe should have succeeded")
    if hook(0, 3) != 0:
        fail("count leftover after 3 fails")
    out("sysfault: alloc-inject PASS (1+3 forced kmalloc failures, then a live probe)\n")
    flush()
    # --- user-space error-path battery ---
    fds: u64[16]
    nopen: u64 = 0
    last: u64 = 0
    while nopen < 16:
        r = sys_open("/efi/incudela/bin/hello")
        if is_err(r):
            last = r
            break
        fds[nopen] = r
        nopen += 1
    if last != EMFILE_ or nopen < 4:
        fail("EMFILE exhaust")
    # close one, open should succeed again
    if sys_close(fds[0]) != 0:
        fail("close")
    r = sys_open("/efi/incudela/bin/hello")
    if is_err(r):
        fail("open after close")
    fds[0] = r
    i: u64 = 0
    while i < nopen:
        sys_close(fds[i])
        i += 1
    huge = sys_mmap(0x0000004000000000)
    if is_err(huge) == 0:
        fail("huge mmap succeeded")
    small = sys_mmap(4096)
    if is_err(small):
        fail("small mmap")
    if sys_munmap(small, 4096) != 0:
        fail("munmap")
    out("sysfault: user-faults PASS (EMFILE after ")
    out_u64(nopen)
    out(" fds, huge mmap denied)\n")
    flush()
    # --- short sysfuzz, injection off ---
    args: u8[64]
    i = 0
    i = put_num(addr(args[0]), i, seed)
    mem_set8(u64(addr(args[0])) + i, 32)
    i += 1
    i = put_num(addr(args[0]), i, n)
    mem_set8(u64(addr(args[0])) + i, 0)
    pid = sys_fork()
    if pid == 0:
        sys_exec("/efi/incudela/bin/sysfuzz", addr(args[0]))
        out("sysfault: exec sysfuzz failed\n")
        flush()
        sys_exit(127)
    st: u64 = 0
    w = sys_wait(pid, addr(st))
    if is_err(pid) or is_err(w) or w != pid or st != 0:
        fail("sysfuzz")
    out("sysfault: sysfuzz PASS\n")
    flush()
    out("sysfault: PASS\n")
    flush()
    sys_exit(0)
