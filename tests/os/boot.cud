# tests/os/boot.cud: Cuditor port of tests/os/boot.py (kept as the reference) — boot one QEMU configuration,
# check serial markers and (optionally) OCR the framebuffer.
# usage: boot NAME LOG TIMEOUT 'marker|marker|...' FBTEXT -- qemu args...
#        boot --self-test   pipe-drain, stall-predicate and settled-screendump checks (no QEMU)
# After KERNEL OK the harness issues QEMU monitor `stop` before the screendumps, then queues `q` and
# `cont`s (inv237): the kernel's 5 s 'q' wait is rdtsc (tsc_per_ms * 5000) and a host suspend can
# jump guest TSC so the wait expires mid-dump (inv236 os/bootpol-config-strict). Failed screendumps
# still FAIL. FORGE_BOOT_DELAY_AFTER_OK=N sleeps N s after the stop, for tests/os/boot-ok-stop.sh.
# Same behaviour and PASS/FAIL/HANG/SLOW lines as boot.py; see its docstring. Differences: QEMU runs via
# os.fork/os.execv with its serial console on two pipes, and the HMP monitor is a `-chardev pipe` (the FIFOs
# MON.in / MON.out made with os.mkfifo, opened O_RDWR so neither side blocks) read with os.poll, instead of a
# Unix socket per command. Built with `fld --base 0x100000000000` like the other hosted tools.
# Hang path (inv118b os/kernel-bios-smp1): drain QEMU stdio before any HMP command, and apply
# FORGE_BOOT_STALL (default 60 s, not raised) every loop iteration rather than only at the timeout
# deadline, so a full serial pipe cannot wedge serial_putc while the harness waits until 2x timeout.
# Before the first HMP command a stalled boot also records QEMU's threads from the host side (tests/os/hostcap.sh:
# per-thread CPU over 1 s, state, wchan, syscall, kernel stack with sudo -n, gdb backtraces if installed).
import os
import sys
import time

KEYS = {" ": "spc", "/": "slash", "-": "minus", ".": "dot", "\n": "ret"}

def script():
# after the n-th "sh$ " prompt, type line n: 'k' on the PS/2 keyboard (monitor sendkey), 's' on COM1;
# a third element holds the line back until that text has appeared
    s = [["k", "ls"], ["s", "cat /efi/incudela/docs/Long File Name Notes.txt"], ["k", "forktest"], ["s", "hello a b"], ["k", "nosuch"], ["k", "ls /EFI/Incudela"], ["s", "crash 40"]]
    s += [["s", "sum /efi/incudela/docs/big.bin"], ["s", "captest"], ["s", "chantest"], ["s", "run sbtest"], ["s", "run grtest &"], ["s", "grants"], ["s", "revoke grtest", "grtest: halfway"], ["s", "wait", "grtest: cut off"]]
    s += [["s", "grants"], ["s", "audit"], ["s", "wxtest"], ["s", "unsealed"], ["s", "tampered"], ["s", "forged"], ["s", "linuxabi"], ["s", "lxtest"], ["s", "run lxtest"], ["s", "run lxthreads"], ["s", "run lxfs"], ["s", "run lxexec"], ["s", "lxipc"], ["s", "run lxipc"]]
    s += [["s", "run lxsig"], ["s", "run lxsig term"], ["s", "run busybox echo hello from busybox"], ["s", "run busybox basename /a/b/forge-bb"], ["s", "run busybox false"], ["s", "run busybox seq -s , 3 5"]]
    s += [["s", "run busybox expr 6 + 7"], ["s", "run busybox uname -s -m"], ["s", "run busybox wc -c /efi/incudela/docs/big.bin"], ["s", "run busybox sha256sum /efi/incudela/docs/big.bin"], ["s", "run busybox cat /efi/incudela/bin/cat"]]
    s += [["s", "run busybox ls /efi/incudela/bin"], ["s", "run busybox ls /efi/incudela/docs"], ["s", "run busybox printf %d-%s 42 ok"], ["s", "run busybox pwd"], ["s", "run busybox sleep 1"], ["s", "run busybox sh -c exit${IFS}3"]]
    s += [["s", "run busybox sh -c exit${IFS}4</efi/incudela/docs/big.bin"], ["s", "run busybox tail -n 2 /efi/incudela/docs/hello.sh"], ["s", "run busybox sh /efi/incudela/docs/hello.sh"], ["s", "run busybox grep -c echo /efi/incudela/docs/hello.sh"]]
    s += [["s", "capdeny"], ["s", "badptr"], ["s", "sysfuzz 7 3000"], ["s", "crash k 4"], ["k", "hello Swap OK"], ["s", "exit"], ["s", "hello x"], ["s", "bg 1 &"], ["s", "hello z &"], ["s", "kexec next"], ["k", "hello after kexec"], ["s", "wait"]]
    # FORGE_BOOT_KEXEC=N: N handoffs in one boot, each next line sent the moment the new prompt appears
    # (regression for the inv80 hang: kernel lines interleaved with the post-kexec prompt)
    i: int = 1
    while i < int(os.getenv("FORGE_BOOT_KEXEC", "1")):
        s += [["s", "kexec next"], ["s", "hello serial " + str(i)], ["k", "hello keys"]]
        i += 1
    s += [["s", "exit"]]
    return s

class H:
    def __init__(self):
        self.root = ""
        self.mon = ""
        self.mfd = -1
        self.minkeep = -1
        self.shot = ""
        self.log = ""
        self.name = ""
        self.tmo = 0.0
        self.stall = 60.0
        self.qargs = []

def fix(x):
# %.0f-style integer seconds
    return str(int(x + 0.5))

def nocount(s, sub) -> int:
    c: int = 0
    i: int = find(s, sub, 0)
    while i >= 0:
        c += 1
        i = find(s, sub, i + len(sub))
    return c

def font(h):
    src = read_file(os.path.join(h.root, "examples/kernel/font.cudi"))
    a: int = find(src, "[", find(src, "=", 0))
    b: int = rfind(src, "]")
    out = []
    for x in split(replace(src[a + 1:b], "\n", " "), ","):
        if strip(x) != "":
            out.append(int(strip(x)))
    return out

def read_ppm(path):
# inv211: a missing or truncated dump (QEMU gone before it wrote one) raises, so screenshot() reports
# "screendump failed" and the boot still gets a result line; indexing None used to segfault the harness
    d = read_file(path)
    if d is None:
        raise Exception(f"no screendump file {path}")
    n: int = len(d)
    toks = []
    i: int = 0
    while len(toks) < 4:
        while i < n and (d[i] == " " or d[i] == "\n" or d[i] == "\t" or d[i] == "\r"):
            i += 1
        j: int = i
        while j < n and not (d[j] == " " or d[j] == "\n" or d[j] == "\t" or d[j] == "\r"):
            j += 1
        if j == i:
            raise Exception(f"truncated screendump {path} ({n} bytes)")
        toks.append(d[i:j])
        i = j
    w: int = int(toks[1])
    hh: int = int(toks[2])
    if toks[0] != "P6" or n < i + 1 + w * hh * 3:
        raise Exception(f"truncated screendump {path} ({n} bytes for {w}x{hh})")
    return [w, hh, d, i + 1]

def decode_row(f, ppm, row: int):
    w: int = ppm[0]
    px = ppm[2]
    base: int = ppm[3]
    n: int = w // 8
    out = ""
    cx: int = 0
    while cx < n:
        bits = []
        r: int = 0
        while r < 16:
            b: int = 0
            x: int = 0
            while x < 8:
                o: int = base + ((row * 16 + r) * w + cx * 8 + x) * 3
                b = b << 1
                if ord(px[o]) + ord(px[o + 1]) + ord(px[o + 2]) > 384:
                    b = b | 1
                x += 1
            bits.append(b)
            r += 1
        ch = "?"
        g: int = 0
        while g < 95:
            if f[g * 16:(g + 1) * 16] == bits:
                ch = chr(32 + g)
                break
            g += 1
        out += ch
        cx += 1
    return out

def strip_esc(t):
# drop ANSI CSI sequences ESC [ digits letter, like re.sub(r'\x1b\[[0-9]*[A-Za-z]', '', t)
    out = ""
    i: int = 0
    n: int = len(t)
    while i < n:
        if t[i] == chr(27) and i + 1 < n and t[i + 1] == "[":
            j: int = i + 2
            while j < n and isdigit(t[j]):
                j += 1
            if j < n and isalpha(t[j]):
                i = j + 1
                continue
        out += t[i]
        i += 1
    return out

def mon_drain(h):
    got = ""
    while len(os.poll([[h.mfd, 1]], 0)) > 0:
        c = os.read(h.mfd, 65536)
        if c == "":
            break
        got += c
    return got

def monitor(h, cmd, wait=1.0):
    try:
        mon_drain(h)
        w = os.open(concat(h.mon, ".in"), 2048 | 1)
        e = send(w, concat(cmd, "\n"))
        os.close(w)
        if e != "":
            return f"[monitor {__repr(cmd)} failed: {e}]"
        out = ""
        t0 = clk()
        while clk() - t0 < wait:
            left: int = int((wait - (clk() - t0)) * 1000) + 1
            if len(os.poll([[h.mfd, 1]], left)) == 0:
                break
            out += os.read(h.mfd, 65536)
        t = strip_esc(out)
        keep = []
        for l in splitlines(t):
            if not startswith(l, "(qemu) i"):
                keep.append(l)
        return "\n".join(keep)
    except Exception as ex:
        return f"[monitor {__repr(cmd)} failed: {ex}]"

def irq_dump(h, cpus) -> str:
# interrupt delivery at a hang (inv167: input never echoed, all vCPUs had IF=1): the 8259/IOAPIC state with
# its masks, per-IRQ counts, and every vCPU's local APIC (IRR/ISR/TPR, LVT masks)
    out = concat("---- info pic ----\n", monitor(h, "info pic"))
    out = concat(out, concat("\n---- info irq ----\n", monitor(h, "info irq")))
    n = nocount(cpus, "CPU #")
    i = 0
    while i < n:
        out = concat(out, concat(f"\n---- info lapic {i} ----\n", monitor(h, f"info lapic {i}")))
        i += 1
    return concat(out, "\n")

def probe_addrs(buf):
# [name, 0xaddr] pairs from the last "hang probe:" line of the serial output (each kernel prints its own at boot,
# a kexec'd one too, so the last line names the running kernel's slid addresses)
    line = ""
    for l in splitlines(buf):
        if startswith(l, "hang probe:"):
            line = l
    out = []
    for tok in split(line[11:], " "):
        a: int = find(tok, "@0x", 0)
        if a > 0 and all_hex(tok[a + 3:]):
            out.append([tok[0:a], tok[a + 1:]])
    return out

def hex_int(s) -> int:
    v: int = 0
    for c in lower(s):
        d: int = find("0123456789abcdef", c, 0)
        if d >= 0:
            v = v * 16 + d
    return v

def probe_dump(h, buf) -> str:
# the guest's input counters at a hang (inv203: the last 16 scancodes of a typed line never raised IRQ1, and the
# dump could not show whether the guest read them): one monitor round trip, `x/1gx` per counter on cpu 0
    pa = probe_addrs(buf)
    hd = "---- guest input counters (hang probe, cpu 0) ----\n"
    if len(pa) == 0:
        return concat(hd, "[no hang probe line in the serial output]\n")
    cmd = "cpu 0"
    for p in pa:
        cmd = concat(cmd, f"\nx/1gx {p[1]}")
    got = {}
    for wl in splitlines(monitor(h, cmd, 2.0)):
        c: int = find(wl, ": ", 0)
        if c > 0 and all_hex(wl[0:c]) and startswith(strip(wl[c + 2:]), "0x"):
            got[lower(wl[0:c])] = str(hex_int(strip(wl[c + 2:])[2:]))
    out = []
    for p in pa:
        k = lower(p[1][2:])
        while len(k) < 16:
            k = concat("0", k)
        v = "?"
        if k in got:
            v = got[k]
        out.append(f"{p[0]}={v}")
    return concat(concat(hd, " ".join(out)), "\n")

def ishex(c) -> bool:
    return isdigit(c) or (c >= "a" and c <= "f")

def stack_dump(h, regs):
# 64 words at each vCPU's rsp, parsed from 'info registers -a' (HMP has no $rsp); 'cpu N' selects the vCPU
    out = []
    ls = splitlines(regs)
    k: int = 0
    while k < len(ls):
        l = ls[k]
        if startswith(l, "CPU#") and len(l) > 4 and isdigit(l[4]):
            j: int = 4
            while j < len(l) and isdigit(l[j]):
                j += 1
            cpu = l[4:j]
            rsp = ""
            m: int = k + 1
            while m < len(ls) and m <= k + 3 and rsp == "":
                for key in ["RSP=", "ESP="]:
                    p: int = find(ls[m], key, 0)
                    if p >= 0 and rsp == "":
                        e: int = p + 4
                        while e < len(ls[m]) and ishex(ls[m][e]):
                            e += 1
                        if e - p - 4 >= 8:
                            rsp = ls[m][p + 4:e]
                m += 1
            if rsp != "":
                words = []
                for wl in splitlines(monitor(h, f"cpu {cpu}\nx/64gx 0x{rsp}", 1.0)):
                    c: int = find(wl, ": ", 0)
                    if c > 0 and all_hex(wl[0:c]):
                        words.append(wl)
                out.append(concat(f"---- CPU#{cpu} stack at rsp=0x{rsp} ----\n", "\n".join(words)))
        k += 1
    if len(out) == 0:
        return "[no RSP found in info registers -a]"
    return "\n".join(out)

def proc_text(path):
# /proc files are unseekable, so read_file returns None for them; read with os.read instead
    fd = os.open(path, 0)
    out = ""
    while True:
        c = os.read(fd, 4096)
        if c == "":
            break
        out += c
    os.close(fd)
    return out

def all_hex(s) -> bool:
    for c in s:
        if not ishex(c):
            return False
    return len(s) > 0

def last_line(text):
    last = ""
    for l in splitlines(text):
        if strip(l) != "":
            last = l
    return last[0:120]

# The harness clock. The box is a VM that is at times suspended whole (90-145 s, "crng reseeded due to virtual
# machine fork" in its kernel log); QEMU and the guest stop with it. CLOCK_MONOTONIC does not advance across such
# a suspension, the wall clock does: inv167 and inv171 declared HANG after 12 s of real guest silence because a
# suspension landed between a pass's freeze check and its stall check (or inside a send), so time.time() showed
# 60 s / 172 s of silence for a QEMU that had run 42 s / 34 s. Every stall, run-time and timeout figure uses clk().
def clk():
    return time.monotonic()

def freeze_gap(tprev, tn):
# a loop pass takes ~0.05 s plus its actions (which reset tprev); a gap over 3 s means the harness was not running
# (host starvation or SIGSTOP; a VM suspension does not show on clk()), so that time is not guest silence
    if tn - tprev > 3.0:
        return tn - tprev - 0.05
    return 0.0

def step_gap(tp, tq, wait):
# the input injection (FORGE_BOOT_INPUT) sends one HMP command at a time and waits up to `wait` seconds for its
# echo; a step that took over 3 s more than that means the harness was not running (inv224 os/desktop: a box
# stall inside the injection let the guest's 30 s input window run out with 6 of 36 commands unsent, and no
# freeze was reported because the loop never checked)
    return freeze_gap(tp + wait, tq)

def hnote(buf, notes, s):
# A harness note never shares a line with guest output: inv235 os/kaslr missed a kexec because a freeze note was
# glued to the front of "kexec: new kernel relocatable, ..." and run.sh's ^-anchored grep no longer matched it.
# At a line boundary the note gets its own line in place; mid-line (a guest line still arriving) it goes to the
# end-of-log notes, as the input-injection notes do. Returns [buf, notes].
    if buf == "" or buf[len(buf) - 1:] == "\n":
        return [concat(buf, concat(s, "\n")), notes]
    return [buf, concat(notes, concat(s, "\n"))]

def stall_expired(now, tlast, stall) -> i64:
# 1 if serial has been silent for `stall` seconds (FORGE_BOOT_STALL, default 60; never raised here)
    if now - tlast >= stall:
        return 1
    return 0

def drain_avail(fd, buf, tlast):
# Non-blocking drain of QEMU stdio (or any pipe). Returns [buf, tlast, eof].
    eof = 0
    while len(os.poll([[fd, 1]], 0)) > 0:
        chunk = ""
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            chunk = ""
        if chunk == "":
            eof = 1
            break
        buf = concat(buf, chunk)
        tlast = clk()
    return [buf, tlast, eof]

def type_keys(h, line):
    w = os.open(concat(h.mon, ".in"), 2048 | 1)
    for ch in concat(line, "\n"):
        k = ""
        if ch in KEYS:
            k = KEYS[ch]
        elif isupper(ch):
            k = concat("shift-", lower(ch))
        else:
            k = ch
        e = send(w, f"sendkey {k}\n")
        if e != "":
            os.close(w)
            raise Exception(e)
        time.sleep(0.03)
    os.close(w)
    time.sleep(0.2)

def send(fd, s):
# write s to a pipe or FIFO and check the result: "" when all of it went, else why not (os.write returns the raw
# syscall result, -errno on failure). Never SIGPIPE: boot() keeps a read end of every pipe and FIFO it writes to.
    n: int = os.write(fd, s)
    if n == len(s):
        return ""
    if n < 0:
        return f"write failed, errno {0 - n}"
    return f"short write, {n} of {len(s)} bytes"

def spawn(h, pin, pout):
    pid = os.fork()
    if pid == 0:
        os.dup2(pin[0], 0)
        os.dup2(pout[1], 1)
        os.dup2(pout[1], 2)
        args = ["env", "qemu-system-x86_64"] + h.qargs + ["-chardev", f"pipe,id=fmon,path={h.mon}", "-mon", "chardev=fmon,mode=readline"]
        os.execv("/usr/bin/env", args)
        os._exit(127)
    return pid

def host_capture(pid, out):
# QEMU's threads as the host sees them, before any HMP command (tests/os/hostcap.sh); returns the text
    c = os.fork()
    if c == 0:
        os.execv("/bin/sh", ["sh", "-c", f"sh tests/os/hostcap.sh {pid} > {out} 2>&1"])
        os._exit(127)
    os.waitpid(c, 0)
    t = read_file(out)
    if t is None:
        return "(hostcap: no output)\n"
    return concat(t, "\n")

def boot(h, attempt):
    for sfx in [".in", ".out"]:
        if os.path.exists(concat(h.mon, sfx)):
            os.remove(concat(h.mon, sfx))
        os.mkfifo(concat(h.mon, sfx), 384)
    h.mfd = os.open(concat(h.mon, ".out"), 2048 | 2)
    # inv211: the harness keeps a read end of QEMU's stdin pipe and of MON.in for the whole boot. A write to a
    # pipe with no reader raises SIGPIPE, which killed the harness silently (exit 141, no result line, no log)
    # when QEMU had already exited, e.g. the kernel's 5 s wait for 'q' ran out during the screendumps
    # (os/kernel-iommu result lost in os211b). With a reader always present a late write just sits unread in
    # the pipe and the boot is judged from the serial log as usual. (SIGPIPE cannot be set to SIG_IGN from
    # Cuditor: __syscall passes r10 = 0, and rt_sigaction needs sigsetsize 8 there.)
    h.minkeep = os.open(concat(h.mon, ".in"), 2048 | 2)
    pin = os.pipe()
    pout = os.pipe()
    pid = spawn(h, pin, pout)
    inkeep = pin[0]
    os.close(pout[1])
    sin = pin[1]
    sout = pout[0]
    os.set_blocking(sout, False)
    sc = script()
    buf = ""
    t0 = clk()
    # wall clock minus clk(): grows only while the box is suspended (reported, never counted)
    woff = time.time() - t0
    susp = 0.0
    shot_ok = False
    fbmsg = ""
    sent: int = 0
    tlast = t0
    deadline = t0 + h.tmo
    kind = ""
    dump = ""
    rc = None
    eof = False
    tprev = t0
    frozen = 0.0
    # FORGE_BOOT_INPUT="MARKER|cmd;cmd;...": once MARKER is on serial, send each HMP command once, in order
    # (tests/os/desktop.sh: mouse_move / mouse_button / sendkey for the desktop's input window)
    inp = os.getenv("FORGE_BOOT_INPUT", "")
    inp_mark = ""
    inp_cmds = []
    if inp != "":
        ip = split(inp, "|")
        inp_mark = ip[0]
        inp_cmds = split(ip[1], ";")
    inp_sent = False
    # harness notes that must not land inside a serial line (the input injection starts mid-line): logged at the end
    notes = ""
    while rc is None:
    # Box suspensions never reach clk() (see clk); a pass over 3 s on clk() means the harness itself was not
    # scheduled (freeze_gap), so that time is not counted as guest silence, run time or timeout either.
        tn = clk()
        g = freeze_gap(tprev, tn)
        if g > 0.0:
            frozen += g
            tlast += g
            t0 += g
            deadline += g
            hn = hnote(buf, notes, f"[harness: box frozen {fix(g)}s, not counted]")
            buf = hn[0]
            notes = hn[1]
        tprev = tn
        ws = time.time() - tn - woff
        if ws > 1.0:
            susp += ws
            woff += ws
            hn = hnote(buf, notes, f"[harness: box suspended {fix(ws)}s by the wall clock, not counted]")
            buf = hn[0]
            notes = hn[1]
        w = os.waitpid(pid, 1)
        if w[0] == pid:
            rc = os.waitstatus_to_exitcode(w[1])
            break
        if not eof:
            d = drain_avail(sout, buf, tlast)
            buf = d[0]
            tlast = d[1]
            if d[2] != 0:
                eof = True
        now = clk()
        if stall_expired(now, tlast, h.stall) == 1:
        # Drain once more before HMP so a full stdio pipe cannot block QEMU, and so last_line is current.
            if not eof:
                d = drain_avail(sout, buf, tlast)
                buf = d[0]
                tlast = d[1]
                if d[2] != 0:
                    eof = True
            now = clk()
            # a freeze inside this pass (after its check above) is not silence either: count it, look again
            g = freeze_gap(tn, now)
            if g > 0.0:
                frozen += g
                tlast += g
                t0 += g
                deadline += g
                hn = hnote(buf, notes, f"[harness: box frozen {fix(g)}s, not counted]")
                buf = hn[0]
                notes = hn[1]
            if stall_expired(now, tlast, h.stall) == 1:
                kind = "hang"
                dump = f"{h.log}.hang{attempt}"
                load = split__1(proc_text("/proc/loadavg"))[0]
                hdr = f"hang: no serial output for {fix(now - tlast)}s (stopped at +{fix(tlast - t0)}s), load {load}\nlast line: {last_line(buf)}\n\n"
                hdr = concat(hdr, f"box frozen {fix(frozen)}s and suspended {fix(susp + max(0.0, time.time() - clk() - woff))}s in total before this (not counted)\n\n")
                host = host_capture(pid, concat(dump, ".host"))
                regs = monitor(h, "info registers -a", 2.0)
                cpus = monitor(h, "info cpus")
                write_file(dump, concat(concat(concat(hdr, host), cpus), concat(concat("\n", regs), concat(concat("\n", stack_dump(h, regs)), concat(concat("\n", irq_dump(h, cpus)), probe_dump(h, buf))))))
                break
        if now >= deadline:
            if now < t0 + 2 * h.tmo:
                deadline = min(now + h.stall, t0 + 2 * h.tmo)
                kind = "slow"
            else:
                break
        if inp_mark != "" and not inp_sent and inp_mark in buf:
            inp_sent = True
            ti = clk()
            tp = ti
            for ic in inp_cmds:
                monitor(h, ic, 0.3)
                tq = clk()
                g = step_gap(tp, tq, 0.3)
                if g > 0.0:
                    frozen += g
                    tlast += g
                    t0 += g
                    deadline += g
                    notes = concat(notes, f"[harness: box frozen {fix(g)}s during input injection, not counted]\n")
                tp = tq
            notes = concat(notes, f"[harness: {len(inp_cmds)} input commands sent in {fix(clk() - ti)}s]\n")
            tprev = clk()
        if nocount(buf, "sh$ ") > sent and sent < len(sc) and (len(sc[sent]) < 3 or sc[sent][2] in buf):
            how = sc[sent][0]
            line = sc[sent][1]
            sent += 1
            try:
                if how == "k":
                    type_keys(h, line)
                else:
                    e = send(sin, concat(line, "\r"))
                    if e != "":
                        buf += f"[harness: send failed: {e}]"
            except Exception as ex:
                buf += f"[harness: send failed: {ex}]"
            tprev = clk()
        if not shot_ok and "KERNEL OK\n" in buf:
            shot_ok = True
            # Freeze vCPUs before the dumps (inv236 / inv237). The kernel's 5 s wait for 'q' is
            # rdtsc vs tsc_per_ms * 5000; a host suspend can jump guest TSC so the wait expires
            # and qemu_exits while we still dump. monitor stop keeps the vCPUs paused until we
            # cont. putc writes serial before the framebuffer, so KERNEL OK\n can appear mid
            # fb_flush (inv128); if a stopped dump misses the text, briefly cont, stop, retry.
            monitor(h, "stop", 1.0)
            hn = delay_after_ok()
            if hn != "":
                h2 = hnote(buf, notes, hn)
                buf = h2[0]
                notes = h2[1]
            if os.getenv("FORGE_BOOT_PROBE", "") == "1":
            # live check of the hang-dump probe path (os/hang-probe-live): same reads a HANG makes
                buf = concat(buf, concat("\n", probe_dump(h, buf)))
            if FBTEXT[0] != "":
                fbmsg = screenshot(h)
                ntry: int = 1
                while ntry < SHOT_MAX and fb_has_text(fbmsg) == 0 and not ("screendump failed" in fbmsg):
                    monitor(h, "cont", 0.5)
                    time.sleep(0.15)
                    monitor(h, "stop", 1.0)
                    fbmsg = screenshot(h)
                    ntry += 1
            # 'q' is queued on COM1 while the vCPUs are still stopped, then they run again
            e = send(sin, "q")
            if e != "":
                buf += f"[harness: 'q' not delivered: {e}]"
            monitor(h, "cont", 1.0)
            tprev = clk()
        time.sleep(0.05)
    if rc is None:
        __syscall(62, pid, 9, 0)
        w = os.waitpid(pid, 0)
        rc = os.waitstatus_to_exitcode(w[1])
    os.set_blocking(sout, True)
    while len(os.poll([[sout, 1]], 0)) > 0:
        c = os.read(sout, 65536)
        if c == "":
            break
        buf += c
    os.close(sout)
    os.close(sin)
    os.close(inkeep)
    os.close(h.minkeep)
    os.close(h.mfd)
    for sfx in [".in", ".out"]:
        if os.path.exists(concat(h.mon, sfx)):
            os.remove(concat(h.mon, sfx))
    el = clk() - t0
    why = ""
    if kind == "hang":
        why = f"HANG: killed after {fix(el)}s, no serial output after +{fix(tlast - t0)}s, last line \"{last_line(buf)}\", vCPU dump {dump}"
    elif rc == -9:
        why = f"SLOW: killed at the 2x limit ({fix(el)}s of {TMO[0]}s), output still arriving"
    write_file(h.log, f"{buf}\n{notes}[fb] {fbmsg}\nrc={rc}\n[harness] {fix1(el)}s {why}\n")
    # any freeze shows on the result line too, so the gate's freeze count (grep 'box frozen' in the suite log) sees it
    fz = ""
    if frozen > 0.0:
        fz = f"; box frozen {fix(frozen)}s, not counted"
    if kind == "hang":
        old = read_file(dump)
        write_file(dump, concat(concat(old, "\n---- serial output of the hung boot ----\n"), buf))
    res = ""
    wy = ""
    if why != "":
        wy = concat("; ", why)
    for m in split(MARKERS[0], "|"):
        if m != "" and res == "" and not (m in buf):
            res = f"FAIL os/{h.name} (missing: {m}, qemu rc={rc}; {fix(el)}s{wy}{fz})"
    fbt = FBTEXT[0]
    if res == "" and fbt != "":
        parts = split(fbt, "^")
        if not (f"=\"{parts[len(parts) - 1]}\"" in fbmsg):
            res = f"FAIL os/{h.name} (framebuffer: {fbmsg})"
    if res == "" and rc != 33:
        res = f"FAIL os/{h.name} (qemu rc={rc}; {fix(el)}s{wy}{fz})"
    if res == "":
        slow = f"{fix(el)}s"
        if el > h.tmo:
            slow = f"SLOW {fix(el)}s > {TMO[0]}s timeout"
        fbp = ""
        if fbt != "":
            fbp = f" [fb {fbmsg}]"
        res = f"PASS os/{h.name}{fbp} [{slow}{fz}]"
    return [res, kind, why]

def fix1(x):
    t: int = int(x * 10 + 0.5)
    return f"{t // 10}.{t % 10}"

def fb_has_text(msg):
# 1 if screenshot() found the last FBTEXT segment on a decoded row (the ="..." form in the message)
    if FBTEXT[0] == "" or msg == "":
        return 0
    parts = split(FBTEXT[0], "^")
    last = parts[len(parts) - 1]
    needle = concat(concat('="', last), '"')
    return int(needle in msg)

def delay_after_ok():
# FORGE_BOOT_DELAY_AFTER_OK=N (seconds): sleep N s after KERNEL OK and (on the new harness) after
# QEMU monitor `stop`, before the screendump. tests/os/boot-ok-stop.sh uses N=6, longer than the
# kernel's 5 s rdtsc 'q' wait. SIGSTOP of the QEMU process does not reproduce that wait expiring:
# guest TSC is pause-aware and does not jump (a probe stayed at debug-exit 1782 ms after a 6 s
# SIGSTOP). A plain delay with vCPUs still running does: the wait expires, the kernel qemu_exits,
# and the dump finds no ppm — the inv236 failure. After `stop`, the same delay must not expire the
# wait, because the vCPUs are paused.
    s = os.getenv("FORGE_BOOT_DELAY_AFTER_OK", "0")
    n = 0
    try:
        n = int(s)
    except Exception:
        n = 0
    if n <= 0:
        return ""
    time.sleep(float(n))
    return f"[harness: delayed {n}s after KERNEL OK]"

def grab_rows(h):
# one QEMU monitor screendump, decoded to [w, h, rows] (rows are the rstripped text of each 16-pixel cell row)
    if os.path.exists(h.shot):
        os.remove(h.shot)
    monitor(h, f"screendump {h.shot}", 0.5)
    k: int = 0
    while k < 50:
        if os.path.exists(h.shot) and len(read_file(h.shot)) > 0:
            break
        time.sleep(0.1)
        k += 1
    time.sleep(0.3)
    ppm = read_ppm(h.shot)
    f = font(h)
    rows = []
    r: int = 0
    while r < ppm[1] // 16:
        rows.append(rstrip(decode_row(f, ppm, r)))
        r += 1
    return [ppm[0], ppm[1], rows]

def rows_stable(a, b):
# two decoded screendumps agree row for row (the console is no longer being redrawn)
    if len(a) != len(b):
        return 0
    i: int = 0
    while i < len(a):
        if a[i] != b[i]:
            return 0
        i += 1
    return 1

SHOT_MAX = 4

def screenshot(h):
# Screendump race (inv128 O0 efi-loader-gpt): the kernel writes each character to serial before the
# framebuffer, and the newline after KERNEL OK scrolls the console, redrawing every changed cell left to
# right. A single dump taken as soon as the serial line arrived caught row 46 half redrawn ("KERNEL OK"
# followed by the tail of the previous row). The vCPUs are stopped first (see the KERNEL OK path in boot()), so a host suspend cannot expire the 5 s rdtsc wait during these dumps; if the first stopped dump is mid-flush the caller briefly `cont`s and tries again. Dump until two consecutive dumps decode identically (at most SHOT_MAX = 4), then check that settled screen.
# A real rendering bug still fails: its wrong text is stable.
    try:
        g = grab_rows(h)
        n: int = 1
        ok: int = 0
        while n < SHOT_MAX:
            g2 = grab_rows(h)
            n += 1
            if rows_stable(g[2], g2[2]) == 1:
                g = g2
                ok = 1
                break
            g = g2
        w: int = g[0]
        hh: int = g[1]
        rows = g[2]
        how = f" (settled after {n} dumps)"
        if ok == 0:
            how = f" (not settled after {n} dumps)"
        want = split(FBTEXT[0], "^")
        last = want[len(want) - 1]
        hit: int = -1
        i: int = 0
        while i < len(rows):
            if last in rows[i] and (len(want) == 1 or (i > 0 and want[0] in rows[i - 1])):
                hit = i
            i += 1
        if hit < 0:
            return f"{w}x{hh} text not found, last row=\"{rows[len(rows) - 1]}\"{how}"
        pre = ""
        if len(want) > 1:
            pre = f"{w}x{hh} row{hit - 1}=\"{rows[hit - 1]}\" "
        return f"{pre}{w}x{hh} row{hit}=\"{rows[hit]}\"{how}"
    except Exception as ex:
        return f"screendump failed: {ex}"

MARKERS = [""]
FBTEXT = [""]
TMO = [""]

def self_test():
# No QEMU: stall predicate and pipe drain only (regression for the inv118b hang-dump path).
    fail = 0
    if stall_expired(100.0, 30.0, 60.0) == 1 and stall_expired(89.0, 30.0, 60.0) == 0 and stall_expired(90.0, 30.0, 60.0) == 1:
        print("PASS boot-harness stall-expired")
    else:
        print("FAIL boot-harness stall-expired")
        fail = 1
    pr = os.pipe()
    os.set_blocking(pr[0], False)
    os.write(pr[1], "hello\nuser W^X: refused\n")
    r = drain_avail(pr[0], "", 0.0)
    os.close(pr[0])
    os.close(pr[1])
    if rows_stable(["a", "KERNEL OK"], ["a", "KERNEL OK"]) == 1 and rows_stable(["a", "KERNEL OK      ck == front"], ["a", "KERNEL OK"]) == 0 and rows_stable(["a"], ["a", "b"]) == 0:
        print("PASS boot-harness rows-stable")
    else:
        print("FAIL boot-harness rows-stable")
        fail = 1
    if "hello\nuser W^X: refused\n" in r[0] and last_line(r[0]) == "user W^X: refused" and r[1] > 0.0:
        print("PASS boot-harness drain-avail")
    else:
        print("FAIL boot-harness drain-avail")
        fail = 1
    # the stall clock is CLOCK_MONOTONIC (far from the epoch) and drain_avail stamps with it; freeze_gap counts
    # only gaps over 3 s
    c = clk()
    if freeze_gap(10.0, 12.9) == 0.0 and freeze_gap(10.0, 13.5) > 3.4 and freeze_gap(10.0, 13.5) < 3.5 and time.time() - c > 1000000.0 and r[1] <= clk() and r[1] >= c - 60.0:
        print("PASS boot-harness monotonic-clock")
    else:
        print("FAIL boot-harness monotonic-clock")
        fail = 1
    # input injection steps (0.3 s echo wait): 0.31 s and 3.3 s are no freeze; 4.3 s counts 3.95 s, as freeze_gap does
    if step_gap(10.0, 10.31, 0.3) == 0.0 and step_gap(10.0, 13.3, 0.3) == 0.0 and step_gap(10.0, 14.3, 0.3) > 3.94 and step_gap(10.0, 14.3, 0.3) < 3.96:
        print("PASS boot-harness input-freeze")
    else:
        print("FAIL boot-harness input-freeze")
        fail = 1
    pa = probe_addrs("x\nhang probe: kbd_irqs@0xffffffffa1f1a2c8 ps2_rd@0xFFFFFFFFA1F1A2D0\nhang probe: kbd_irqs@0xffffffff80319a58 bad@0xzz\nsh$ ")
    if len(pa) == 1 and pa[0][0] == "kbd_irqs" and pa[0][1] == "0xffffffff80319a58" and hex_int("0000000000000063") == 99 and hex_int("FF") == 255 and len(probe_addrs("no probe")) == 0:
        print("PASS boot-harness hang-probe-parse")
    else:
        print("FAIL boot-harness hang-probe-parse")
        fail = 1
    # inv235: a freeze note at a line boundary gets its own line, so the guest line after it still starts the
    # line (os/kaslr greps ^kexec:); mid-line it waits in the end-of-log notes and the guest line stays whole
    fn = "[harness: box frozen 3.00s, not counted]"
    h1 = hnote("sh: kexec after 5 commands, pid 249\n", "", fn)
    g1 = concat(h1[0], "kexec: new kernel relocatable, 15 relocations\n")
    h2 = hnote("kexec: new kernel reloc", "", fn)
    g2 = concat(h2[0], "atable, 15 relocations\n")
    k1 = 0
    for l in splitlines(g1):
        if startswith(l, "kexec: new kernel relocatable, 15"):
            k1 += 1
    if k1 == 1 and h1[1] == "" and concat(fn, "\n") in g1 and "kexec: new kernel relocatable, 15 relocations\n" in g2 and h2[1] == concat(fn, "\n") and not (fn in g2):
        print("PASS boot-harness note-own-line")
    else:
        print("FAIL boot-harness note-own-line")
        fail = 1
    exit(fail)

def main():
    a = sys.argv
    if len(a) >= 2 and a[1] == "--self-test":
        self_test()
        return
    h = H()
    h.name = a[1]
    h.log = a[2]
    TMO[0] = a[3]
    h.tmo = float(a[3])
    MARKERS[0] = a[4]
    FBTEXT[0] = a[5]
    k: int = 6
    while a[k] != "--":
        k += 1
    h.qargs = a[k + 1:]
    st = os.getenv("FORGE_BOOT_STALL", "60")
    h.stall = float(st)
    # argv[0] is ROOT/build/... (run.sh builds it to build/os/boot); the repo root is the cwd run.sh uses
    h.root = os.getcwd()
    h.mon = f"/tmp/forge-mon-{os.getpid()}"
    ld = os.path.dirname(h.log)
    if ld == "":
        ld = "."
    h.shot = os.path.join(ld, f"{h.name}.ppm")
    r = boot(h, 1)
    res = r[0]
    if r[1] == "hang" and os.getenv("FORGE_BOOT_NO_RETRY", "") != "1":
        r2 = boot(h, 2)
        s2 = "FAIL"
        if startswith(r2[0], "PASS"):
            s2 = "PASS"
        print(f"FLAKY os/{h.name}: first boot {r[2]}; informational retry {s2}")
        res = concat(res, f" [retry {s2}; a HANG always fails, dump kept in {h.log}.hang1]")
    print(res)

main()
