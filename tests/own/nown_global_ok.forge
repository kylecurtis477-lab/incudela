# forge: no-runtime
# nown[T] globals and global arrays of nown[T]: they start none (zero), and each element is a place used only by
# take/replace/swap or a test for none. Owners are made once in unsafe code; everything after that is safe code.
include "../fs/linux.fsi"
struct Node:
    id: u64
    slot: nown[Node]
mem: u64[32]
rq: nown[Node][4]
spare: nown[Node][4]
cur: nown[Node]
calls: u64
@unsafe
def mk(i: u64) -> own[Node]:
    mem[2 * i] = i
    mem[2 * i + 1] = 0
    return own[Node](ptr[Node](addr(mem[2 * i])))
def id_or(o: nown[Node], d: u64) -> u64:
    if o == 0:
        return d
    return o.id
def nxt() -> u64:
    calls = calls + 1
    return calls % 4
def push(i: u64, n: own[Node]) -> u64:
# the old owner of the slot comes back from replace; a full slot reports its id
    return id_or(replace(rq[i], n), 0)
def park(m: mut[Node]) -> u64:
# an element and a nown field behind a mut[T] trade owners
    swap(cur, m.slot)
    return id_or(take(m.slot), 0)
def main() -> u64:
    n = 0
    i = 0
    while i < 4:
        if rq[i] == 0 and spare[i] == 0:
            n = n + 1
        i = i + 1
    put_u64(n * 10 + (cur == 0))
    puts(" slots start none\n")
    s = 0
    for k in range(4):
        s = s + push(k, mk(k + 1))
    s = s * 10 + push(2, mk(9))
    put_u64(s)
    puts(" replace fills elements and returns the old owner\n")
    swap(rq[0], rq[3])
    swap(rq[1], spare[2])
    swap(cur, rq[2])
    put_u64(id_or(take(rq[0]), 0) * 1000 + id_or(take(spare[2]), 0) * 100 + id_or(take(cur), 0) * 10 + (rq[1] == 0))
    puts(" swap between elements, arrays and a global\n")
    calls = 0
    push(nxt(), mk(5))
    x = id_or(take(rq[nxt()]), 7)
    swap(rq[nxt()], spare[nxt()])
    put_u64(calls * 100 + x * 10 + id_or(take(spare[0]), 0))
    puts(" each index is evaluated once\n")
    o: nown[Node] = mk(6)
    swap(cur, o)
    h = mk(10)
    a = park(borrow_mut(h))
    put_u64(a * 100 + id_or(o, 0) * 10 + (cur == 0))
    puts(" swap with a local and with a field through mut[T]\n")
    t = 0
    for k in range(4):
        t = t * 10 + id_or(take(rq[k]), 0)
    put_u64(t + h.id * 10000)
    puts(" drained\n")
    return 0
