# expect: a nown[T] global is a place: use take(g)
# cuditor: no-runtime
include "../fs/linux.cudi"
struct Node:
    id: u64
struct Holder:
    n: u64
    slot: nown[Node]
cell: Node
@unsafe
def make() -> own[Node]:
    return own[Node](ptr[Node](addr(cell)))
def consume(x: own[Node]) -> u64:
    return x.id
def peek(x: ref[Node]) -> u64:
    return x.id
g: nown[Node]
def f() -> u64:
# a nown[T] global starts none and is a place: a plain read would copy its owner
    x = g
    return consume(x)
