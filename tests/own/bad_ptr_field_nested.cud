# expect: cannot modify an owner field through ref[T]
# cuditor: no-runtime
struct Node:
    id: u64
    arr: u64[4]
    next: own[Node]
struct Queue:
    n: u64
    head: own[Node]
def f(p: ref[Queue]) -> u64:
# Stage 3d reads nested owner paths (p.head.next.id); writing under them through a ref[T] stays refused
    p.head.next.id = 1
    return p.head.next.id
