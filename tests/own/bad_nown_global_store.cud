# expect: a nown[T] global is a place
# cuditor: no-runtime
include "../fs/linux.cudi"
struct Node:
    id: u64
    slot: nown[Node]
struct Box:
    n: u64
    head: own[Node]
mem: u64[16]
rq: nown[Node][4]
rq2: nown[Node][4]
cur: nown[Node]
calls: u64
@unsafe
def mk(i: u64) -> own[Node]:
    mem[2 * i] = i
    mem[2 * i + 1] = 0
    return own[Node](ptr[Node](addr(mem[2 * i])))
def drop(o: nown[Node]) -> u64:
    if o == 0:
        return 0
    return o.id
def use(o: own[Node]) -> u64:
    return o.id
def peek(r: ref[Node]) -> u64:
    return r.id
def nxt() -> u64:
    calls = calls + 1
    return calls % 4
def t() -> u64:
    cur = mk(1)
    return 0
