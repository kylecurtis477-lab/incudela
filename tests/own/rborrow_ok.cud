# cuditor: no-runtime
# Stage 3d: borrows of owner-field paths recorded on the root, nested own-field chains for reads, writes and
# take/replace/swap. Owners are made once in unsafe code; everything after that is safe code.
include "../fs/linux.cudi"
struct Node:
    id: u64
    next: own[Node]
    slot: nown[Node]
struct Holder:
    n: u64
    head: own[Node]
struct Local:
    n: u64
    head: own[Node]
mem: u64[24]
hmem: u64[2]
@unsafe
def mk(i: u64, nx: u64) -> own[Node]:
# node i lives at mem[3 * i]: id i, next = node nx, slot none
    mem[3 * i] = i
    mem[3 * i + 1] = u64(addr(mem[3 * nx]))
    mem[3 * i + 2] = 0
    return own[Node](ptr[Node](addr(mem[3 * i])))
@unsafe
def init() -> u64:
# give every node a valid next so own chains never end in a null
    i = 0
    while i < 8:
        mem[3 * i] = i
        mem[3 * i + 1] = u64(addr(mem[3 * ((i + 1) % 8)]))
        i = i + 1
    return 0
@unsafe
def mkh(head: own[Node]) -> own[Holder]:
    hmem[1] = u64(ptr[Node](head))
    return own[Holder](ptr[Holder](addr(hmem)))
def consume(n: own[Node]) -> u64:
    return n.id
def id_or(o: nown[Node], d: u64) -> u64:
    if o == 0:
        return d
    return consume(o)
def peek(r: ref[Node]) -> u64:
# nested read through a ref[T]: r.next.id follows the own field
    return r.id * 10 + r.next.id
def bump(m: mut[Node]) -> u64:
    m.id = m.id + 1
    m.next.id = m.next.id + 2
    return m.id
def via_mut(m: mut[Holder]) -> u64:
# borrows taken from a mut[T] root: shared, then mutable, of fields two levels down
    a = peek(borrow(m.head.next))
    b = bump(borrow_mut(m.head.next))
    m.head.next.next.id = 7
    return a * 100 + b
def run(h: own[Holder], n: own[Node]) -> u64:
    l: Local
    l.head = n
    x = 0
    if h.n == 0:
    # the borrow local is recorded on the root h and released at the end of this block
        s = borrow(h.head)
        x = peek(s) + h.head.id
    put_u64(x)
    puts(" shared borrow of h.head held in a local\n")
    put_u64(bump(borrow_mut(h.head)) * 100 + h.head.id * 10 + h.head.next.id)
    puts(" borrow_mut(h.head) then nested reads\n")
    put_u64(via_mut(borrow_mut(h)))
    puts(" borrows two levels down through mut[T]\n")
    put_u64(h.head.next.next.id)
    puts(" write through the chain is visible\n")
    # take/replace/swap on nested places
    old = replace(h.head.slot, mk(5, 0))
    swap(h.head.slot, h.head.next.slot)
    put_u64(id_or(old, 9) * 100 + id_or(take(h.head.slot), 8) * 10 + id_or(take(h.head.next.slot), 6))
    puts(" replace/swap/take on nested nown places\n")
    # a local struct root: the first field is a Stage 2 slot, the chain continues from it
    put_u64(peek(borrow(l.head.next)) * 10 + l.head.next.id)
    puts(" chain from a local struct field\n")
    return consume(l.head) + id_or(take(h.head.slot), 0)
def main() -> u64:
    init()
    r = run(mkh(mk(1, 2)), mk(4, 3))
    put_u64(r)
    puts(" done\n")
    return 0
