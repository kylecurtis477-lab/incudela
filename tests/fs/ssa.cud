# cuditor: no-runtime
# --fs-ssa (Phase 12.1 step 4d): every comparison kind as a branch and as a value, constants folded into add,
# sub, and, or, xor and cmp (imm32 edges included, 2**31 must stay in %rcx), compares with 0, and loops whose
# values meet in phis. Step 4e: ssa_dead returns 0 from inside a loop and at its end (a register write that is
# overwritten before any read is removed). Step 4h: ssa_keep keeps three values in callee-saved registers across
# two calls (read there directly, not through copies). Step 4i: ssa_move loads w[1] and the constant 7
# straight into %rdi/%rsi (a move whose only reader is the next line's copy writes the copy's register). Step 4j:
# ssa_range adds to its loop values in callee-saved registers in place instead of through %rax and a copy back.
# Step 4k: ssa_range also zeroes s and i straight in their registers (`xor %ebx,%ebx`). Step 4m: ssa_args loads
# its string addresses and p straight into %rdi (a call reads %rax only when an argument goes in %xmm). Step 4n:
# ssa_move stores w[1] and w[2] through the address register itself (`mov %rdx,(%rax)`, no copies first).
# ssa_lcopy compares its loop counters where they live (`cmp %rdi,%r8`): a position inside a loop gets no phi of its
# own, so the copies to %rax before each compare propagate and die.
# The output must be the same under every fs optimizer level.
include "linux.cudi"

def ssa_cmp(a: i64, b: i64, u: u64, v: u64) -> i64:
    r: i64 = 0
    if a == b:
        r += 1
    if a != b:
        r += 2
    if a < b:
        r += 4
    if a >= b:
        r += 8
    if a <= b:
        r += 16
    if a > b:
        r += 32
    if u < v:
        r += 64
    if u >= v:
        r += 128
    if u <= v:
        r += 256
    if u > v:
        r += 512
    if a == 0:
        r += 1024
    if not (a < 7):
        r += 2048
    return r

def ssa_imm(a: i64) -> i64:
    x: i64 = a + 2147483647
    x = x - 2147483648
    x = x + 2147483648
    x = x & 1048575
    x = x | 4096
    x = x ^ -1
    x = x - -5
    if x == -2147483648:
        x += 3
    return x

def ssa_val(a: i64, b: i64) -> i64:
    lt: bool = a < b
    eq: bool = a == b
    n: i64 = 0
    if lt:
        n += 10
    if eq:
        n += 100
    if lt and not eq:
        n += 1000
    return n

def ssa_loop(n: i64) -> i64:
    s: i64 = 0
    i: i64 = 0
    while i < n:
        if i % 3 == 0:
            s += i * 7
        elif i % 3 == 1:
            s -= 5
        else:
            s ^= 255
        i += 1
    return s

def ssa_dead(a: i64, n: i64) -> i64:
    i: i64 = 0
    while i < n:
        if a == i:
            return 0
        i += 1
    if a < 0:
        return 0
    return a * 3

def ssa_copy(a: i64, b: i64, c: i64) -> i64:
    if a > 5:
        return b + c
    if b == c:
        return a - b
    return c

def ssa_keep(a: i64, b: i64) -> i64:
    x: i64 = a * 3
    y: i64 = ssa_copy(x, b, b)
    z: i64 = ssa_copy(y, x, b)
    return x + y + z

def ssa_move(a: i64, b: i64) -> i64:
    w: i64[4]
    w[1] = a
    w[2] = b
    return ssa_copy(w[1], 7, w[1] + w[2])

def ssa_range(n: i64) -> i64:
    s: i64 = 0
    i: i64 = 0
    while i < n:
        s = s + ssa_copy(i, 1, 2) * 3
        i = i + 1
    return s

def ssa_push(a: i64, b: i64) -> i64:
    w: i64[4]
    w[0] = a
    w[1] = b
    w[2] = a - b
    w[3] = 7
    return (a + 3) * (w[b & 3] - a) + (w[(a + b) & 3] ^ (b * 5)) - (a << 2) * w[1]

def ssa_args(p: ptr[u8], n: i64) -> i64:
    puts("args: ")
    puts(p)
    puts(" ")
    put_i64(n * 3)
    nl()
    return n + 1

def ssa_lcopy(n: u64, m: u64) -> u64:
    s: u64 = 0
    i: u64 = 0
    while i < n:
        j: u64 = 0
        while j < m:
            s = s + i * 3 + j
            j = j + 1
        i = i + 1
    return s

def ssa_drop(x: i64):
    ssa_loop(x)

def show(x: i64):
    put_i64(x)
    nl()

def main() -> i64:
    vals: i64 = -3
    while vals <= 3:
        show(ssa_cmp(vals, 0, 5, 9))
        show(ssa_cmp(1, vals, 9, 5))
        show(ssa_cmp(vals, vals, 7, 7))
        show(ssa_imm(vals))
        show(ssa_val(vals, 1))
        vals += 1
    show(ssa_cmp(7, 9, 0, 18446744073709551615))
    show(ssa_cmp(-9223372036854775807, 9223372036854775807, 18446744073709551615, 0))
    show(ssa_imm(-2147483648))
    show(ssa_imm(9223372036854775807 - 2147483647))
    show(ssa_loop(0))
    show(ssa_loop(1))
    show(ssa_loop(100))
    show(ssa_dead(2, 5))
    show(ssa_dead(-4, 5))
    show(ssa_dead(9, 5))
    ssa_drop(4)
    show(ssa_copy(9, 2, 3))
    show(ssa_copy(1, 4, 4))
    show(ssa_copy(1, 4, 6))
    show(ssa_keep(4, 1))
    show(ssa_keep(1, 2))
    show(ssa_move(3, 1))
    show(ssa_move(6, 1))
    show(ssa_range(9))
    show(ssa_push(4, 1))
    show(ssa_push(-3, 6))
    show(ssa_args("two", 2))
    show(ssa_lcopy(3, 4))
    show(ssa_lcopy(0, 9))
    return 0
