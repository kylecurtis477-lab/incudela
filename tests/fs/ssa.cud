# cuditor: no-runtime
# --fs-ssa (Phase 12.1 step 4d): every comparison kind as a branch and as a value, constants folded into add,
# sub, and, or, xor and cmp (imm32 edges included, 2**31 must stay in %rcx), compares with 0, and loops whose
# values meet in phis. Step 4e: ssa_dead returns 0 from inside a loop and at its end (a register write that is
# overwritten before any read is removed). Step 4h: ssa_keep keeps three values in callee-saved registers across
# two calls (read there directly, not through copies). Step 4i: ssa_move loads w[1] and the constant 7
# straight into %rdi/%rsi (a move whose only reader is the next line's copy writes the copy's register). Step 4j:
# ssa_range adds to its loop values in callee-saved registers in place instead of through %rax and a copy back.
# Step 4k: ssa_range also zeroes s and i straight in their registers (`xor %ebx,%ebx`). Step 4m: ssa_args loads
# its string addresses and p straight into %rdi (a call reads %rax only when an argument goes in %xmm). Step 4n:
# ssa_move stores w[1] and w[2] through the address register itself (`mov %rdx,(%rax)`, no copies first).
# ssa_lcopy compares its loop counters where they live (`cmp %rdi,%r8`): a position inside a loop gets no phi of its
# own, so the copies to %rax before each compare propagate and die.
# Step 4o: ssa_cold keeps the values it stores and multiplies in registers across the bounds checks of w[i] and
# w[j] (a failure path never comes back, so the push/pop round-trip around it goes, and with it the call's pad).
# The output must be the same under every fs optimizer level.
include "linux.cudi"

def ssa_cmp(a: i64, b: i64, u: u64, v: u64) -> i64:
    r: i64 = 0
    if a == b:
        r += 1
    if a != b:
        r += 2
    if a < b:
        r += 4
    if a >= b:
        r += 8
    if a <= b:
        r += 16
    if a > b:
        r += 32
    if u < v:
        r += 64
    if u >= v:
        r += 128
    if u <= v:
        r += 256
    if u > v:
        r += 512
    if a == 0:
        r += 1024
    if not (a < 7):
        r += 2048
    return r

def ssa_imm(a: i64) -> i64:
    x: i64 = a + 2147483647
    x = x - 2147483648
    x = x + 2147483648
    x = x & 1048575
    x = x | 4096
    x = x ^ -1
    x = x - -5
    if x == -2147483648:
        x += 3
    return x

def ssa_val(a: i64, b: i64) -> i64:
    lt: bool = a < b
    eq: bool = a == b
    n: i64 = 0
    if lt:
        n += 10
    if eq:
        n += 100
    if lt and not eq:
        n += 1000
    return n

def ssa_loop(n: i64) -> i64:
    s: i64 = 0
    i: i64 = 0
    while i < n:
        if i % 3 == 0:
            s += i * 7
        elif i % 3 == 1:
            s -= 5
        else:
            s ^= 255
        i += 1
    return s

def ssa_dead(a: i64, n: i64) -> i64:
    i: i64 = 0
    while i < n:
        if a == i:
            return 0
        i += 1
    if a < 0:
        return 0
    return a * 3

def ssa_copy(a: i64, b: i64, c: i64) -> i64:
    if a > 5:
        return b + c
    if b == c:
        return a - b
    return c

def ssa_keep(a: i64, b: i64) -> i64:
    x: i64 = a * 3
    y: i64 = ssa_copy(x, b, b)
    z: i64 = ssa_copy(y, x, b)
    return x + y + z

def ssa_move(a: i64, b: i64) -> i64:
    w: i64[4]
    w[1] = a
    w[2] = b
    return ssa_copy(w[1], 7, w[1] + w[2])

def ssa_range(n: i64) -> i64:
    s: i64 = 0
    i: i64 = 0
    while i < n:
        s = s + ssa_copy(i, 1, 2) * 3
        i = i + 1
    return s

def ssa_push(a: i64, b: i64) -> i64:
    w: i64[4]
    w[0] = a
    w[1] = b
    w[2] = a - b
    w[3] = 7
    return (a + 3) * (w[b & 3] - a) + (w[(a + b) & 3] ^ (b * 5)) - (a << 2) * w[1]

def ssa_args(p: ptr[u8], n: i64) -> i64:
    puts("args: ")
    puts(p)
    puts(" ")
    put_i64(n * 3)
    nl()
    return n + 1

def ssa_lcopy(n: u64, m: u64) -> u64:
    s: u64 = 0
    i: u64 = 0
    while i < n:
        j: u64 = 0
        while j < m:
            s = s + i * 3 + j
            j = j + 1
        i = i + 1
    return s

def ssa_cold(a: i64, i: i64, j: i64) -> i64:
# step 4y/4z: store-reload and add $0,%rsp folds are checked by run_tests shapes on this file.
# step 4x: short-circuit `i < j and j < 3` keeps setCC/setne at the merge (fold refuses targets that
# consume the test's flags); safe setCC/movzbl/test/je elsewhere become jCC
    w: i64[4]
    w[0] = a
    w[1] = a + 1
    w[2] = 3
    w[3] = 4
    w[i] = a * 5 + j
    t: i64 = (a + 1) * w[j]
    u: i64 = (a + 2) * (i < j and j < 3)
    if a > 100:
        if i > 0:
            t = t + 1
        else:
            t = t - 1
        ud2()
    return t + w[i] - w[j] + u

def ssa_rax(a: i64, b: i64) -> i64:
# step 4p: copies into %rax for an add or an imul by a constant become one lea or three-operand imul
    s: i64 = a + 5
    t: i64 = a + b
    u: i64 = b * 24
    v: i64 = a - 9
    w: i64 = b + b
    return s * 1000000000 + t * 1000000 + u * 1000 + v + w

def ssa_rpush(a: i64, b: i64, c: i64) -> i64:
# step 4p: the left operand pushed across the call is pushed straight from its register
    return (a + c) * 3 - ssa_imm(b) * (a - ssa_imm(c))

def ssa_mul(a: u64, t: u64) -> u64:
# step 4q: unsigned mul by a constant whose high half is unread becomes three-operand imul (same low 64 bits)
    return t * 1000 - a

def ssa_ppcall(a: i64, b: i64) -> i64:
# step 4q: a callee-saved value pushed across a call with an alignment pad comes back from the register
    x: i64 = a
    y: i64 = ssa_imm(b)
    return x - y + a

def ssa_shift(a: u64) -> u64:
# step 4r: a shift by a constant uses an immediate count (no mov $N,%rcx / sh* %cl,%rax)
    return (a << 3) | (a >> 6) | (a << 12)

def ssa_sar(a: i64) -> i64:
# step 4t: arithmetic shift by a constant also uses an immediate count (sar $N, not mov/sar %cl)
    return (a >> 3) | (a >> 7)

def ssa_andtest(a: u64) -> u64:
# step 4s: and into %rax that only feeds a zero-test keeps the and's flags (no test %rax,%rax)
    if (a & 1) != 0:
        return a + 3
    return a + 9

def ssa_aluimm(a: i64) -> i64:
# step 4u: add/and/or by a constant after a call still folds to an immediate op (rcx_lo)
    x: i64 = a + 1
    y: i64 = (a & 255) | 128
    return ssa_imm(x) + ssa_imm(y)

def ssa_mulrax_id(a: u64) -> u64:
    return a

def ssa_mulrax(a: u64) -> u64:
# step 4v: a call's return in %rax multiplied by a constant with an unread high half is imul $N,%rax
    return ssa_mulrax_id(a) * 10

def ssa_andset(a: u64) -> i64:
# step 4w: and by a constant whose value only feeds a setcc becomes test (same flags, %rax kept)
    t: i64 = (a & 63) != 0
    return t + a

def ssa_drop(x: i64):
    ssa_loop(x)

def show(x: i64):
    put_i64(x)
    nl()

def main() -> i64:
    vals: i64 = -3
    while vals <= 3:
        show(ssa_cmp(vals, 0, 5, 9))
        show(ssa_cmp(1, vals, 9, 5))
        show(ssa_cmp(vals, vals, 7, 7))
        show(ssa_imm(vals))
        show(ssa_val(vals, 1))
        vals += 1
    show(ssa_cmp(7, 9, 0, 18446744073709551615))
    show(ssa_cmp(-9223372036854775807, 9223372036854775807, 18446744073709551615, 0))
    show(ssa_imm(-2147483648))
    show(ssa_imm(9223372036854775807 - 2147483647))
    show(ssa_loop(0))
    show(ssa_loop(1))
    show(ssa_loop(100))
    show(ssa_dead(2, 5))
    show(ssa_dead(-4, 5))
    show(ssa_dead(9, 5))
    ssa_drop(4)
    show(ssa_copy(9, 2, 3))
    show(ssa_copy(1, 4, 4))
    show(ssa_copy(1, 4, 6))
    show(ssa_keep(4, 1))
    show(ssa_keep(1, 2))
    show(ssa_move(3, 1))
    show(ssa_move(6, 1))
    show(ssa_range(9))
    show(ssa_push(4, 1))
    show(ssa_push(-3, 6))
    show(ssa_args("two", 2))
    show(ssa_lcopy(3, 4))
    show(ssa_lcopy(0, 9))
    show(ssa_cold(5, 1, 2))
    show(ssa_cold(-7, 3, 0))
    show(ssa_rax(3, 4))
    show(ssa_rax(-2147483648, 9))
    show(ssa_rpush(5, 7, 2))
    show(ssa_mul(3, 4))
    show(ssa_mul(-5, 1000000))
    show(ssa_ppcall(9, 2))
    show(ssa_ppcall(-4, 7))
    show(ssa_shift(5))
    show(ssa_shift(4294967295))
    show(ssa_sar(-100))
    show(ssa_sar(64))
    show(ssa_andtest(0))
    show(ssa_andtest(1))
    show(ssa_aluimm(5))
    show(ssa_aluimm(-3))
    show(ssa_mulrax(5))
    show(ssa_mulrax(7))
    show(ssa_andset(0))
    show(ssa_andset(5))
    show(ssa_andtest(2))
    return 0
