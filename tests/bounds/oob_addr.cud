# cuditor: no-runtime
# addr(i) taken before the loop lets a call write i inside it, so while i < n: proves nothing: s[i] keeps its check
include "../fs/linux.cudi"

def bump(q: ptr[u64]):
    q[0] = q[0] + 1

def last(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    q = addr(i)
    while i < n:
        bump(q)
        t += s[i]
    return t

def main() -> i64:
    a: u64[4]
    put_u64(last(a[:]))
    nl()
    return 0
