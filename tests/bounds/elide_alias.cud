# cuditor: no-runtime
# bounds-check elision through length aliases (n = len(s)), while v < n: guards and range() lower bounds
# (tests/bounds/run.sh checks each function's check count in the asm; pos_* drop every check, neg_* keep one)
include "../fs/linux.cudi"

def pos_range_alias(s: slice[u64]) -> u64:
    n = len(s)
    for k in range(n):
        s[k] = k
    return n

def pos_while(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    while i < n:
        t += s[i]
        i += 1
    return t

def pos_while_len(s: slice[u64]) -> u64:
    t: u64 = 0
    i: u64 = 0
    while i < len(s):
        t += s[i]
        i += 1
    return t

def pos_nested_while(s: slice[u64]) -> u64:
    n = len(s)
    c: u64 = 0
    i: u64 = 2
    while i < n:
        if s[i] != 0:
            c += 1
            j = i * i
            while j < n:
                s[j] = 0
                j += i
        i += 1
    return c

def pos_lo(p: slice[u64]) -> u64:
    t: u64 = 0
    for i in range(1, len(p)):
        t += p[i - 1]
    return t

def neg_reassign(s: slice[u64]) -> u64:
    n = len(s)
    n += 1
    t: u64 = 0
    for k in range(n):
        t += s[k]
    return t

def neg_cond_def(s: slice[u64], c: u64) -> u64:
    n: u64 = 0
    if c != 0:
        n = len(s)
    t: u64 = 0
    for k in range(n):
        t += s[k]
    return t

def neg_write_before(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    while i < n:
        i += 1
        t += s[i]
    return t

def neg_nested(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    while i < n:
        for k in range(2):
            t += s[i] + k
        i += 1
    return t

def neg_lo(p: slice[u64]) -> u64:
    t: u64 = 0
    for i in range(1, len(p)):
        t += p[i - 2]
    return t

def neg_le(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    while i <= n:
        t += s[i]
        i += 1
    return t

def neg_param_write(s: slice[u64]) -> u64:
    n = len(s)
    s = s[1:]
    t: u64 = 0
    for k in range(n):
        t += s[k]
    return t

def bump(q: ptr[u64]):
    q[0] = q[0] + 1

def neg_addr(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    i: u64 = 0
    q = addr(i)
    while i < n:
        bump(q)
        t += s[i]
    return t

def neg_alias_for(s: slice[u64]) -> u64:
    n = len(s)
    t: u64 = 0
    for n in range(2):
        t += n
    for k in range(n):
        t += s[k]
    return t

def neg_alias_addr(s: slice[u64]) -> u64:
    n = len(s)
    q = addr(n)
    t: u64 = 0
    for k in range(n):
        t += s[k]
    return t

def neg_while_array() -> u64:
    b: u64[4]
    t: u64 = 0
    i: u64 = 0
    while i < len(b):
        t += b[i]
        i += 1
    return t

def neg_big(p: slice[u64]) -> u64:
    t: u64 = 0
    for i in range(1, len(p)):
        t += p[i - 18446744073709551615]
    return t

A: u64[40]

def main() -> i64:
    t = pos_range_alias(A[:])
    t += pos_while(A[:])
    t += pos_while_len(A[2:])
    t += pos_lo(A[:])
    t += neg_cond_def(A[:], 1)
    t += neg_nested(A[:])
    t += pos_nested_while(A[:])
    put_u64(t)
    nl()
    return 0
