# tools/syssoak.cud: host soak harness for item 7 batches 2 and 4 (docs/BUILD_PLAN.md).
# Reads a guest serial log, writes a stable results file, and checks it. No QEMU.
#   syssoak --record IN.log OUT.txt
#   syssoak --check OUT.txt [MIN]
#   syssoak --check-checkpoint OUT.txt [MIN]
#   syssoak --resume OUT.txt
#   syssoak --self-test
# The live short boot (16 seeds x 100 calls of sysfuzz) is tests/os/syssoak.sh.
# tests/os/syssoak-long.sh is a 1-tick budget boot that must checkpoint after the
# first seed. A multi-hour session uses a larger budget (360000 ticks is one
# hour) or budget 0; feed that log to --record and resume with --resume. This
# tool does not itself run a multi-hour soak or inject faults.
import sys

HDR = "# syssoak-results v1\n"
COLS = "# seed n calls errors distinct cap_ok cap_n ns_ok ns_n canary pid result\n"

def is_digit(ch):
    return ch >= "0" and ch <= "9"

def take_u(s, i):
# [value, new_i] of the next decimal integer, skipping non-digits; [-1, i] if none
    n = len(s)
    while i < n and not is_digit(s[i]):
        i += 1
    if i >= n:
        return [-1, i]
    v = 0
    while i < n and is_digit(s[i]):
        v = v * 10 + int(s[i])
        i += 1
    return [v, i]

def rec_new(seed, n):
    return {"seed": seed, "n": n, "calls": 0, "errors": 0, "distinct": 0,
            "cap_ok": 0, "cap_n": 0, "ns_ok": 0, "ns_n": 0, "canary": -1, "pid": -1,
            "result": ""}

def parse_log(text):
# returns [records, summary, checkpoint]
# summary is {seeds, pass, fail, n, pass_line} or None
# checkpoint is {next, done, fail, budget, elapsed} or None
    recs = []
    pending = {}
    last_seed = -1
    summary = None
    pass_line = 0
    checkpoint = None
    for raw in text.split("\n"):
        line = raw.strip()
        if line.startswith("sysfuzz: seed "):
            a = take_u(line, 14)
            b = take_u(line, a[1])
            c = take_u(line, b[1])
            d = take_u(line, c[1])
            e = take_u(line, d[1])
            f = take_u(line, e[1])
            g = take_u(line, f[1])
            h = take_u(line, g[1])
            if a[0] < 0:
                continue
            r = rec_new(a[0], b[0])
            r["calls"] = b[0]
            r["distinct"] = c[0]
            r["errors"] = d[0]
            r["cap_ok"] = e[0]
            r["cap_n"] = f[0]
            r["ns_ok"] = g[0]
            r["ns_n"] = h[0]
            pending[a[0]] = r
            last_seed = a[0]
        elif line.startswith("sysfuzz: canary intact "):
            a = take_u(line, 23)
            b = take_u(line, a[1])
            if last_seed >= 0 and last_seed in pending and a[0] >= 0:
                pending[last_seed]["canary"] = a[0]
                if b[0] >= 0:
                    pending[last_seed]["pid"] = b[0]
        elif line == "sysfuzz: PASS" or line == "sysfuzz: FAIL":
            pass
        elif line.startswith("syssoak: seed "):
            a = take_u(line, 14)
            b = take_u(line, a[1])
            res = "FAIL"
            if line.endswith(" result PASS"):
                res = "PASS"
            elif " result PASS" in line:
                res = "PASS"
            if a[0] < 0:
                continue
            if a[0] in pending:
                r = pending[a[0]]
            else:
                r = rec_new(a[0], b[0])
            if b[0] >= 0:
                r["n"] = b[0]
            r["result"] = res
            recs.append(r)
            if a[0] in pending:
                del pending[a[0]]
        elif line.startswith("syssoak: checkpoint next "):
            a = take_u(line, 24)
            b = take_u(line, a[1])
            c = take_u(line, b[1])
            d = take_u(line, c[1])
            e = take_u(line, d[1])
            if a[0] >= 0 and b[0] >= 0:
                checkpoint = {"next": a[0], "done": b[0], "fail": c[0], "budget": d[0], "elapsed": e[0]}
        elif line.startswith("syssoak: ") and " seeds, " in line and " PASS, " in line and " FAIL, " in line:
            a = take_u(line, 9)
            b = take_u(line, a[1])
            c = take_u(line, b[1])
            d = take_u(line, c[1])
            if a[0] >= 0 and b[0] >= 0 and c[0] >= 0:
                summary = {"seeds": a[0], "pass": b[0], "fail": c[0], "n": d[0], "pass_line": 0}
        elif line == "syssoak: PASS":
            pass_line = 1
        elif line == "syssoak: CHECKPOINT":
            pass_line = 2
        elif line == "syssoak: FAIL":
            pass_line = -1
    if summary is not None:
        summary["pass_line"] = pass_line
    elif checkpoint is not None:
        summary = {"seeds": len(recs), "pass": 0, "fail": 0, "n": 0, "pass_line": pass_line}
        i = 0
        while i < len(recs):
            if recs[i]["result"] == "PASS":
                summary["pass"] += 1
            else:
                summary["fail"] += 1
            if recs[i]["n"] > 0:
                summary["n"] = recs[i]["n"]
            i += 1
        if checkpoint["fail"] >= 0:
            summary["fail"] = checkpoint["fail"]
        if checkpoint["done"] >= 0:
            summary["pass"] = checkpoint["done"]
            if checkpoint["fail"] >= 0:
                summary["seeds"] = checkpoint["done"] + checkpoint["fail"]
    return [recs, summary, checkpoint]

def format_results(recs, summary, checkpoint):
    lines = [HDR, COLS]
    i = 0
    while i < len(recs):
        r = recs[i]
        lines.append(str(r["seed"]) + " " + str(r["n"]) + " " + str(r["calls"]) + " " + str(r["errors"])
                     + " " + str(r["distinct"]) + " " + str(r["cap_ok"]) + " " + str(r["cap_n"])
                     + " " + str(r["ns_ok"]) + " " + str(r["ns_n"]) + " " + str(r["canary"])
                     + " " + str(r["pid"]) + " " + r["result"] + "\n")
        i += 1
    if summary is not None:
        lines.append("# summary seeds=" + str(summary["seeds"]) + " pass=" + str(summary["pass"])
                     + " fail=" + str(summary["fail"]) + " n=" + str(summary["n"])
                     + " line=" + str(summary["pass_line"]) + "\n")
    if checkpoint is not None:
        lines.append("# checkpoint next=" + str(checkpoint["next"]) + " done=" + str(checkpoint["done"])
                     + " fail=" + str(checkpoint["fail"]) + " budget=" + str(checkpoint["budget"])
                     + " elapsed=" + str(checkpoint["elapsed"]) + "\n")
    return "".join(lines)

def parse_results(text):
    recs = []
    summary = None
    checkpoint = None
    for raw in text.split("\n"):
        line = raw.strip()
        if line == "" or line.startswith("# syssoak-results") or line.startswith("# seed "):
            continue
        if line.startswith("# summary "):
            a = take_u(line, 10)
            b = take_u(line, a[1])
            c = take_u(line, b[1])
            d = take_u(line, c[1])
            e = take_u(line, d[1])
            summary = {"seeds": a[0], "pass": b[0], "fail": c[0], "n": d[0], "pass_line": e[0]}
            continue
        if line.startswith("# checkpoint "):
            a = take_u(line, 13)
            b = take_u(line, a[1])
            c = take_u(line, b[1])
            d = take_u(line, c[1])
            e = take_u(line, d[1])
            checkpoint = {"next": a[0], "done": b[0], "fail": c[0], "budget": d[0], "elapsed": e[0]}
            continue
        parts = line.split(" ")
        if len(parts) != 12:
            return [[], None, None, "bad results line: " + line]
        r = rec_new(int(parts[0]), int(parts[1]))
        r["calls"] = int(parts[2])
        r["errors"] = int(parts[3])
        r["distinct"] = int(parts[4])
        r["cap_ok"] = int(parts[5])
        r["cap_n"] = int(parts[6])
        r["ns_ok"] = int(parts[7])
        r["ns_n"] = int(parts[8])
        r["canary"] = int(parts[9])
        r["pid"] = int(parts[10])
        r["result"] = parts[11]
        recs.append(r)
    return [recs, summary, checkpoint, ""]

def recs_intact(recs):
    i = 0
    while i < len(recs):
        r = recs[i]
        if r["result"] != "PASS":
            return "seed " + str(r["seed"]) + " is " + r["result"]
        if r["canary"] != 1 or r["pid"] != 1:
            return "seed " + str(r["seed"]) + " canary/pid not intact"
        if r["cap_n"] != 0 and r["cap_ok"] != r["cap_n"]:
            return "seed " + str(r["seed"]) + " capability sweep incomplete"
        if r["ns_n"] != 0 and r["ns_ok"] != r["ns_n"]:
            return "seed " + str(r["seed"]) + " ENOSYS sweep incomplete"
        i += 1
    return ""

def check(recs, summary, checkpoint, min_seeds):
    if checkpoint is not None:
        return "incomplete soak (checkpoint next " + str(checkpoint["next"]) + ")"
    if summary is None:
        return "missing summary"
    if len(recs) < min_seeds:
        return "only " + str(len(recs)) + " seed records, want at least " + str(min_seeds)
    if summary["seeds"] != len(recs):
        return "summary seeds " + str(summary["seeds"]) + " != " + str(len(recs)) + " records"
    if summary["pass"] + summary["fail"] != summary["seeds"]:
        return "summary pass+fail does not equal seeds"
    if summary["fail"] != 0 or summary["pass"] != summary["seeds"] or summary["pass_line"] != 1:
        return "soak did not PASS (" + str(summary["pass"]) + " PASS, " + str(summary["fail"]) + " FAIL)"
    return recs_intact(recs)

def check_checkpoint(recs, summary, checkpoint, min_seeds):
    if checkpoint is None:
        return "missing checkpoint"
    if summary is None:
        return "missing summary"
    if len(recs) < min_seeds:
        return "only " + str(len(recs)) + " seed records, want at least " + str(min_seeds)
    if checkpoint["fail"] != 0 or summary["fail"] != 0 or summary["pass_line"] != 2:
        return "checkpoint is not clean (" + str(summary["pass"]) + " PASS, " + str(summary["fail"]) + " FAIL)"
    if checkpoint["done"] != len(recs):
        return "checkpoint done " + str(checkpoint["done"]) + " != " + str(len(recs)) + " records"
    if len(recs) > 0 and checkpoint["next"] != recs[len(recs) - 1]["seed"] + 1:
        return "checkpoint next " + str(checkpoint["next"]) + " is not the seed after the last record"
    return recs_intact(recs)

def record_status(recs, summary, checkpoint):
    if checkpoint is not None:
        err = check_checkpoint(recs, summary, checkpoint, 1)
        if err != "":
            return err
        return ""
    return check(recs, summary, checkpoint, 1)

GOOD = "\n".join([
    "sysfuzz: seed 1, 100 calls over 12 syscall numbers (34 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 1, pid unchanged 1",
    "sysfuzz: PASS",
    "syssoak: seed 1 n 100 result PASS",
    "sysfuzz: seed 2, 100 calls over 11 syscall numbers (40 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 1, pid unchanged 1",
    "sysfuzz: PASS",
    "syssoak: seed 2 n 100 result PASS",
    "syssoak: 2 seeds, 2 PASS, 0 FAIL, 100 calls each",
    "syssoak: PASS"]) + "\n"

OLD = "\n".join(["KERNEL OK", "debug-exit 10 ms after KERNEL OK"]) + "\n"

BAD = "\n".join([
    "sysfuzz: seed 1, 100 calls over 12 syscall numbers (34 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 1, pid unchanged 1",
    "sysfuzz: PASS",
    "syssoak: seed 1 n 100 result PASS",
    "sysfuzz: seed 2, 100 calls over 11 syscall numbers (40 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 0, pid unchanged 1",
    "sysfuzz: FAIL",
    "syssoak: seed 2 n 100 result FAIL",
    "syssoak: 2 seeds, 1 PASS, 1 FAIL, 100 calls each",
    "syssoak: FAIL"]) + "\n"

CP = "\n".join([
    "syssoak: start 1, 16 seeds, 100 calls each, budget 1 ticks",
    "sysfuzz: seed 1, 100 calls over 12 syscall numbers (34 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 1, pid unchanged 1",
    "sysfuzz: PASS",
    "syssoak: seed 1 n 100 result PASS",
    "syssoak: checkpoint next 2 done 1 fail 0 budget 1 elapsed 80",
    "syssoak: CHECKPOINT"]) + "\n"

BAD_CP = "\n".join([
    "syssoak: start 1, 16 seeds, 100 calls each, budget 1 ticks",
    "sysfuzz: seed 1, 100 calls over 12 syscall numbers (34 errors); 29/29 undeclared-capability calls EACCES, 20/20 unknown numbers ENOSYS",
    "sysfuzz: canary intact 0, pid unchanged 1",
    "sysfuzz: FAIL",
    "syssoak: seed 1 n 100 result FAIL",
    "syssoak: checkpoint next 2 done 0 fail 1 budget 1 elapsed 80",
    "syssoak: FAIL"]) + "\n"

def self_test():
    fail = 0
    p = parse_log(GOOD)
    err = check(p[0], p[1], p[2], 2)
    body = format_results(p[0], p[1], p[2])
    if err != "" or p[1]["pass"] != 2 or p[0][0]["errors"] != 34 or p[0][1]["canary"] != 1 or p[2] is not None:
        print("syssoak --self-test: good log refused: " + err)
        fail = 1
    else:
        print("syssoak --self-test: good log recorded 2 PASS")
    q = parse_results(body)
    err2 = q[3]
    if err2 == "":
        err2 = check(q[0], q[1], q[2], 2)
    if err2 != "":
        print("syssoak --self-test: written results failed --check: " + err2)
        fail = 1
    p2 = parse_log(OLD)
    err3 = check(p2[0], p2[1], p2[2], 1)
    if err3 == "":
        print("syssoak --self-test: old-tree log (no syssoak lines) was accepted")
        fail = 1
    else:
        print("syssoak --self-test: old-tree log refused (" + err3 + ")")
    p3 = parse_log(BAD)
    err4 = check(p3[0], p3[1], p3[2], 2)
    if err4 == "":
        print("syssoak --self-test: a FAIL seed was accepted")
        fail = 1
    else:
        print("syssoak --self-test: FAIL seed refused (" + err4 + ")")
    p4 = parse_log(CP)
    err5 = check(p4[0], p4[1], p4[2], 1)
    err6 = check_checkpoint(p4[0], p4[1], p4[2], 1)
    body4 = format_results(p4[0], p4[1], p4[2])
    q4 = parse_results(body4)
    err7 = q4[3]
    if err7 == "":
        err7 = check_checkpoint(q4[0], q4[1], q4[2], 1)
    nxt = -1
    if q4[2] is not None:
        nxt = q4[2]["next"]
    if err5 == "" or err6 != "" or err7 != "" or nxt != 2 or p4[2] is None or p4[2]["elapsed"] != 80:
        print("syssoak --self-test: clean checkpoint mishandled (full=" + err5 + ", cp=" + err6 + ", written=" + err7 + ")")
        fail = 1
    else:
        print("syssoak --self-test: clean checkpoint recorded, full --check refused, resume 2")
    p5 = parse_log(BAD_CP)
    err8 = check_checkpoint(p5[0], p5[1], p5[2], 1)
    if err8 == "":
        print("syssoak --self-test: a FAIL checkpoint was accepted")
        fail = 1
    else:
        print("syssoak --self-test: FAIL checkpoint refused (" + err8 + ")")
    if fail != 0:
        print("syssoak: FAIL")
        sys.exit(1)
    print("syssoak: PASS")

def usage():
    sys.stderr.write("usage: syssoak --record IN.log OUT.txt | syssoak --check OUT.txt [MIN] | syssoak --check-checkpoint OUT.txt [MIN] | syssoak --resume OUT.txt | syssoak --self-test\n")
    sys.exit(2)

def main():
    a = sys.argv[1:]
    if len(a) == 1 and a[0] == "--self-test":
        self_test()
        return
    if len(a) == 3 and a[0] == "--record":
        p = parse_log(read_file(a[1]))
        write_file(a[2], format_results(p[0], p[1], p[2]))
        err = record_status(p[0], p[1], p[2])
        if err != "":
            sys.stderr.write("syssoak --record: " + err + "\n")
            sys.exit(1)
        if p[2] is not None:
            print("syssoak: recorded " + str(len(p[0])) + " seeds, checkpoint next " + str(p[2]["next"]) + " to " + a[2])
        else:
            print("syssoak: recorded " + str(len(p[0])) + " seeds to " + a[2])
        return
    if (len(a) == 2 or len(a) == 3) and a[0] == "--check":
        mn = 1
        if len(a) == 3:
            mn = int(a[2])
        q = parse_results(read_file(a[1]))
        err = q[3]
        if err == "":
            err = check(q[0], q[1], q[2], mn)
        if err != "":
            sys.stderr.write("syssoak --check: " + err + "\n")
            sys.exit(1)
        print("syssoak: " + str(len(q[0])) + " seeds PASS")
        return
    if (len(a) == 2 or len(a) == 3) and a[0] == "--check-checkpoint":
        mn = 1
        if len(a) == 3:
            mn = int(a[2])
        q = parse_results(read_file(a[1]))
        err = q[3]
        if err == "":
            err = check_checkpoint(q[0], q[1], q[2], mn)
        if err != "":
            sys.stderr.write("syssoak --check-checkpoint: " + err + "\n")
            sys.exit(1)
        print("syssoak: " + str(len(q[0])) + " seeds PASS, checkpoint next " + str(q[2]["next"]))
        return
    if len(a) == 2 and a[0] == "--resume":
        q = parse_results(read_file(a[1]))
        if q[3] != "" or q[2] is None:
            sys.stderr.write("syssoak --resume: no checkpoint in " + a[1] + "\n")
            sys.exit(1)
        err = check_checkpoint(q[0], q[1], q[2], 1)
        if err != "":
            sys.stderr.write("syssoak --resume: " + err + "\n")
            sys.exit(1)
        print(str(q[2]["next"]))
        return
    usage()

main()
