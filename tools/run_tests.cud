def t_ast_roundtrip():
    r = os.run(["sh", "-c", "tests/ast/roundtrip.sh selfhost/compiler.cud selfhost/prelude.cud tools/*.cud tests/*.cud tests/runtime/*.cud tests/fs/*.cud tests/unit/*.cud tests/testblocks/*.cud tests/bounds/*.cud tests/nonnull/*.cud tests/unsafe/*.cud tests/own/*.cud tests/defer/*.cud tests/generic/*.cud tests/atomic/*.cud std/*.cudi examples/*/*.cud examples/*/*.cudi"])
    passthru(r)
    if r[0] == 0:
        return 0
    return 1

def t_cases():
    fail = 0
    for t in glob_dir("tests", ".cud"):
        base = os.path.basename(t)
        if base.startswith("mod_"):
            continue
        r = os.run(["./cuditor", t, "-o", "build/t_bin"])
        if r[0] != 0:
            say("FAIL " + t)
            fail = 1
            continue
        r2 = os.run(["build/t_bin", "a", "b"])
        exp = read_file(t[:-4] + ".expected")
        if r2[1] == exp:
            say("PASS " + t)
        else:
            say("FAIL " + t)
            fail = 1
    return fail

def t_runtime():
    fail = 0
    for t in glob_dir("tests/runtime", ".cud"):
        r = os.run(["./cuditor", t, "-o", "build/t_bin"])
        if r[0] != 0:
            say("FAIL " + t)
            fail = 1
            continue
        r2 = os.run(["build/t_bin"], merge=True)
        got = r2[1] + "exit " + str(r2[0]) + "\n"
        exp = read_file(t[:-4] + ".expected")
        if got == exp:
            say("PASS " + t)
        else:
            say("FAIL " + t)
            fail = 1
    return fail

def t_errors():
    fail = 0
    for t in glob_dir("tests/errors", ".cud"):
        r = os.run(["timeout", "20", "build/cudc", t, "build/t_err.s"], merge=True)
        m = chomp(r[1])
        if r[0] == 0:
            say("FAIL " + t + " (no error)")
            fail = 1
        else:
            if m.find("error: line") >= 0:
                say("PASS " + t + ": " + m)
            else:
                say("FAIL " + t)
                fail = 1
    return fail

def t_typeerrors():
    fail = 0
    for t in glob_dir("tests/typeerrors", ".cud"):
        r = os.run(["build/cudc", t, "build/t_err.s"], merge=True)
        write_file("build/t_err.txt", r[1])
        if r[0] == 0:
            say("FAIL " + t + " (no error)")
            fail = 1
        else:
            exp = read_file(t[:-4] + ".expected")
            if r[1] == exp:
                first = chomp(r[1]).split("\n")[0]
                say("PASS " + t + ": " + first)
            else:
                say("FAIL " + t)
                fail = 1
    return fail

def t_diag():
    fail = 0
    for t in glob_dir("tests/diag", ".cud"):
        r = os.run(["build/cudc", t, "build/t_err.s", "--diagnostics=json"], merge=True)
        write_file("build/t_diag.json", r[1])
        if r[0] == 0:
            say("FAIL " + t + " (no error)")
            fail = 1
        else:
            exp = read_file(t[:-4] + ".json")
            if r[1] == exp:
                say("PASS " + t)
            else:
                say("FAIL " + t)
                fail = 1
    return fail

def t_diag_schema():
    fail = 0
    if have_cmd("python3"):
        r = os.run(["python3", "-c", "import json,sys,glob\nfor f in glob.glob(\"tests/diag/*.json\"):\n    for l in open(f):\n        d=json.loads(l); assert d[\"version\"]==1 and d[\"code\"][0]==\"E\" and d[\"line\"]>0 and d[\"col\"]>0 and isinstance(d[\"fixits\"],list), f"])
        passthru(r)
        if r[0] == 0:
            say("PASS diag-json-schema")
        else:
            say("FAIL diag-json-schema")
            fail = 1
    return fail

def t_diag_input():
    r = os.run(["build/cudc", "build/no_such_input.cud", "build/t_inc.s", "--diagnostics=json"], merge=True)
    if r[1].find('"code":"E0001"') >= 0:
        say("PASS diag-json-input-missing")
        return 0
    say("FAIL diag-json-input-missing")
    return 1

def t_os_artifacts():
    fail = 0
    r = os.run(["sh", "-c", "./cuditor examples/kernel/build.cud -o build/kernel-build && build/kernel-build && ./cuditor examples/efi/build.cud -o build/efi-build && build/efi-build"])
    if r[0] != 0:
        say("FAIL os-artifacts-build (fas/fld artifact checks would be skipped)")
        fail = 1
    r2 = os.run(["sh", "-c", "mkdir -p build/os && build/cudc tests/os/boot.cud build/os/boot.s"])
    passthru(r2)
    if r2[0] != 0:
        say("FAIL os-boot-harness-asm")
        fail = 1
    return fail

def t_bench():
    fail = 0
    r = os.run(["./cuditor", "tools/bench.cud", "-o", "build/bench"])
    if r[0] != 0:
        say("FAIL bench-build")
        return 1
    for c in ["ok", "slow", "ratio", "window"]:
        r2 = os.run(["build/bench", "check", "--history", "tests/bench/" + c + ".tsv", "--baseline", "tests/bench/base.tsv"], merge=True)
        got = r2[1] + "exit " + str(r2[0]) + "\n"
        exp = read_file("tests/bench/" + c + ".expected")
        if got == exp:
            say("PASS bench-check-" + c)
        else:
            say("FAIL bench-check-" + c)
            fail = 1
    r3 = os.run(["build/bench", "check", "--history", "tests/bench/window.tsv", "--baseline", "tests/bench/base.tsv", "--window", "1"], merge=True)
    got3 = r3[1] + "exit " + str(r3[0]) + "\n"
    if got3 == read_file("tests/bench/window1.expected"):
        say("PASS bench-check-window1")
    else:
        say("FAIL bench-check-window1")
        fail = 1
    r4 = os.run(["tests/bench/tree.sh", "build/bench"])
    passthru(r4)
    if r4[0] != 0:
        fail = 1
    return fail

def t_ast_json():
    r = os.run(["build/cudc", "tests/tuples.cud", "build/t_ast.json", "--emit=ast-json"])
    passthru(r)
    if r[0] != 0:
        say("FAIL ast-json-schema")
        return 1
    r2 = os.run(["python3", "-c", "import json;d=json.load(open(\"build/t_ast.json\"));assert d[\"forge_ast\"]==1 and d[\"root\"][\"k\"]==\"Module\""])
    passthru(r2)
    if r2[0] == 0:
        say("PASS ast-json-schema")
        return 0
    say("FAIL ast-json-schema")
    return 1

# t_fs_shapes keeps the awk oracles from the reference so the shape checks cannot
# drift; the file loops are the same cudc/fas/fld/run sequence as run_tests.sh.
def t_fs_shapes():
    r = os.run(["/bin/sh", "-c", "fn=$(sed -n \"/^t_fs_shapes() {$/,/^}$/p\" run_tests.sh); eval \"$fn\"; t_fs_shapes"])
    passthru(r)
    if r[0] == 0:
        return 0
    return 1

def t_fsfuzz():
    fail = 0
    r = os.run(["./cuditor", "tools/fsfuzz.cud", "-o", "build/fsfuzz-tool"])
    if r[0] != 0:
        say("FAIL fs-opt-fuzz")
        return 1
    r2 = os.run(["build/fsfuzz-tool", "--seed", "1", "--n", "20"], merge=True)
    write_file("build/t_fsfuzz.log", r2[1])
    if r2[0] == 0:
        say("PASS fs-opt-fuzz")
    else:
        say("FAIL fs-opt-fuzz")
        os.write(1, r2[1])
        fail = 1
    r3 = os.run(["build/fsfuzz-tool", "--combos", "--seed", "7", "--n", "3"], merge=True)
    write_file("build/t_fscombos.log", r3[1])
    if r3[0] == 0:
        say("PASS fs-opt-combos")
    else:
        say("FAIL fs-opt-combos")
        os.write(1, r3[1])
        fail = 1
    return fail

def t_optgate():
    fail = 0
    fl = ["", "--fs-opt", "--fs-live", "--fs-temps", "--fs-ssa"]
    for t in glob_dir("tests/optgate", ".cud"):
        for f in fl:
            cmd = ["build/cudc", t, "build/t_og.s"] + flags()
            if f != "":
                cmd.append(f)
            r = os.run(cmd)
            ok = 0
            if r[0] == 0:
                r2 = os.run(["build/fas", "-o", "build/t_og.o", "build/t_og.s"])
                if r2[0] == 0:
                    r3 = os.run(["build/fld", "-o", "build/t_og", "build/t_og.o"])
                    if r3[0] == 0:
                        r4 = os.run(["build/t_og"])
                        if r4[1] == read_file(t[:-4] + ".expected"):
                            ok = 1
            if ok == 1:
                say("PASS optgate" + f + " " + t)
            else:
                say("FAIL optgate" + f + " " + t)
                fail = 1
    return fail

def t_optcov():
    r = os.run(["./cuditor", "tools/optcov.cud", "-o", "build/optcov-tool"])
    if r[0] != 0:
        say("FAIL optimizer-coverage")
        return 1
    r2 = os.run(["build/optcov-tool", "--check"], merge=True)
    write_file("build/t_optcov.log", r2[1])
    if r2[0] == 0:
        say("PASS optimizer-coverage")
        return 0
    say("FAIL optimizer-coverage")
    os.write(1, r2[1])
    return 1

def t_cdiv():
    cmd = ["build/cudc", "tests/fs/cdiv.cud", "build/t_cd.s"] + flags() + ["--fs-opt"]
    r = os.run(cmd)
    if r[0] == 0:
        a = os.run(["sh", "-c", "awk '/^c_i64_7:/,/ret$/' build/t_cd.s | grep -c '    idiv '"])
        b = os.run(["sh", "-c", "awk '/^c_u64_641:/,/ret$/' build/t_cd.s | grep -c '    div '"])
        if chomp(a[1]) == "3" and chomp(b[1]) == "3":
            say("PASS fs-opt-cdiv-shape")
            return 0
    say("FAIL fs-opt-cdiv-shape")
    return 1

def t_float_global():
    write_file("build/t_fgk.cud", "# cuditor: " + "no-runtime\nK = 3\nx: f64 = K\n")
    r = os.run(["build/cudc", "build/t_fgk.cud", "build/t_fgk.s"], merge=True)
    if r[1].find("a float global's initializer must be a float or integer literal") >= 0:
        say("PASS fs-float-global-literal-only")
        return 0
    say("FAIL fs-float-global-literal-only")
    return 1

def t_input_missing():
    fail = 0
    write_file("build/t_inc.cud", "include \"no_such_file.cudi\"\n")
    r = os.run(["build/cudc", "build/t_inc.cud", "build/t_inc.s", "--freestanding"], merge=True)
    write_file("build/t_inc.txt", r[1])
    if r[0] == 1 and r[1].find("error: cannot read include file ") >= 0 and r[1].find("no_such_file.cudi") >= 0:
        say("PASS include-missing")
    else:
        say("FAIL include-missing (rc=" + str(r[0]) + ")")
        fail = 1
    r2 = os.run(["build/cudc", "build/no_such_input.cud", "build/t_inc.s"], merge=True)
    write_file("build/t_inc.txt", r2[1])
    if r2[0] == 1 and r2[1].find("error: cannot read input file") >= 0:
        say("PASS input-missing")
    else:
        say("FAIL input-missing (rc=" + str(r2[0]) + ")")
        fail = 1
    return fail

def t_forge_run_tests():
    return run_script("tests/forge-run-tests/run.sh")

