def all_items():
    out = []
    out.append(["01", "A", "t_cases"])
    out.append(["02", "A", "t_runtime"])
    out.append(["03", "E", "t_errors"])
    out.append(["04", "E", "t_typeerrors"])
    out.append(["05", "E", "t_diag"])
    out.append(["06", "E", "t_diag_schema"])
    out.append(["07", "E", "t_diag_input"])
    out.append(["08", "R", "t_ast_roundtrip"])
    out.append(["09", "M", "t_ast_semantic"])
    out.append(["10", "G", "t_grammar"])
    out.append(["11", "F", "t_fmt"])
    out.append(["12", "S", "t_os_artifacts"])
    out.append(["13", "S", "t_fas"])
