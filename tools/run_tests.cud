def selected_items():
    only = env("RUN_TESTS_ONLY")
    inner = 0
    if nonempty("FORGE_RUN_TESTS_INNER"):
        inner = 1
    out = []
    for it in all_items():
        if item_wanted(it[2], only, inner) == 1:
            out.append(it)
    return out

def unique_lanes(items):
    seen = []
    for it in items:
        l = it[1]
        if l != "S" and l != "alone":
            found = 0
            for s in seen:
                if s == l:
                    found = 1
            if found == 0:
                seen.append(l)
    return sorted(seen)

def run_lane(items, lane, par, serial):
    fail = 0
    for it in items:
        if it[1] != lane:
            continue
        n = it[0]
        f = it[2]
        if serial != 0:
            rc = dispatch(f)
            if rc != 0:
                fail = 1
        else:
        # capture this item like the shell: stdout+stderr to $P/$n.log, rc to $P/$n.rc
            r = os.run(["build/forge-run-tests", "--item", f], merge=True)
            write_file(par + "/" + n + ".log", r[1])
            write_file(par + "/" + n + ".rc", str(r[0]) + "\n")
            if r[0] != 0:
                fail = 1
    return fail

def run_os_section():
    fail = 0
    cnt = chomp(os.run(["grep", "-vc", "^#", "tests/os/expected-results.txt"])[1])
    if nonempty("SKIP_OS"):
        say("SKIP tests/os (SKIP_OS set: the " + cnt + " OS results were not run, so this run is not a gate pass)")
        return 0
    if have_cmd("qemu-system-x86_64") and have_cmd("grub-mkrescue"):
        r = os.run(["tests/os/run.sh"], merge=True)
        write_file("build/os-results.txt", r[1])
        os.write(1, r[1])
        if r[1].find("\nFAIL") >= 0 or r[1].startswith("FAIL"):
            fail = 1
        names = chomp(os.run(["grep", "-v", "^#", "tests/os/expected-results.txt"])[1]).split("\n")
        miss = ""
        for n in names:
            if n == "":
                continue
            ok = 0
            for line in r[1].split("\n"):
                if line == "PASS " + n or line == "FAIL " + n or line.startswith("PASS " + n + " ") or line.startswith("FAIL " + n + " "):
                    ok = 1
            if ok == 0:
                miss = miss + " " + n
        if miss == "":
            say("PASS os/result-count (" + cnt + " results reported)")
        else:
            say("FAIL os/result-count (missing:" + miss + ")")
            fail = 1
        return fail
    say("FAIL tests/os (qemu-system-x86_64 or grub-mkrescue missing: build/ostools reinstalls them; SKIP_OS=1 skips on purpose)")
    return 1

def main():
    me = sys.argv[0]
    if me.find("/") >= 0:
        os.chdir(os.path.dirname(me) + "/..")
    else:
        os.chdir("..")
    if not os.path.isdir("build"):
        os.mkdir("build")
    # --item NAME: run one item and exit with its status (used by the parallel lane capture)
    if len(sys.argv) >= 3 and sys.argv[1] == "--item":
        return dispatch(sys.argv[2])
    items = selected_items()
    fail = 0
    par = par_dir()
    os.run(["rm", "-rf", par])
    os.run(["mkdir", "-p", par])
    if nonempty("RUN_TESTS_SERIAL"):
        for it in items:
            rc = dispatch(it[2])
            if rc != 0:
                write_file(par + "/fail", "")
                fail = 1
    else:
        self = me
        pids = []
        for lane in unique_lanes(items):
            pid = os.fork()
            if pid == 0:
                run_lane(items, lane, par, 0)
                os._exit(0)
            pids.append(pid)
        run_lane(items, "S", par, 0)
        for pid in pids:
            os.waitpid(pid)
        run_lane(items, "alone", par, 0)
        for it in items:
            n = it[0]
            l = it[1]
            f = it[2]
            logp = par + "/" + n + ".log"
            rcp = par + "/" + n + ".rc"
            if os.path.isfile(logp):
                os.write(1, read_file(logp))
            rc = ""
            if os.path.isfile(rcp):
                rc = chomp(read_file(rcp))
            if rc == "":
                say("FAIL run-tests/" + f + " (no exit status; log: " + logp + ")")
                write_file(par + "/fail", "")
                fail = 1
            elif rc != "0":
                say("# " + f + " (lane " + l + ") exited " + rc + ", log: " + logp)
                write_file(par + "/fail", "")
                fail = 1
    if os.path.isfile(par + "/fail"):
        fail = 1
    if run_os_section() != 0:
        fail = 1
    return fail

exit(main())
