# tools/run_tests.cud: Cuditor port of the repo-root run_tests.sh (kept as the
# reference; tests/forge-run-tests/run.sh checks both give the same stdout,
# stderr and exit code). Reservation 6, batch 2 (docs/BUILD_PLAN.md). Built to
# build/forge-run-tests (the binary lives in build/, so the repo is the parent
# of its directory). Honour SKIP_OS, RUN_TESTS_SERIAL, CUDC_FLAGS, and the
# optional RUN_TESTS_ONLY (space-separated item names) and FORGE_RUN_TESTS_INNER
# (omit t_forge_run_tests so a comparison can run inside the suite). RUN_TESTS_PAR
# is the per-item log dir (default build/par; INNER defaults to build/par-inner).
# The kernel
# unsafe cap is unchanged.
import os
import sys

def say(s):
    os.write(1, s + "\n")

def env(name):
    v = os.getenv(name)
    if v is None:
        return ""
    return v

def nonempty(name):
    return env(name) != ""

def par_dir():
    v = env("RUN_TESTS_PAR")
    if v != "":
        return v
    if nonempty("FORGE_RUN_TESTS_INNER"):
        return "build/par-inner"
    return "build/par"

def flags():
    out = []
    for w in env("CUDC_FLAGS").split(" "):
        if w != "":
            out.append(w)
    return out

def chomp(s):
    n = len(s)
    while n > 0 and s[n - 1] == "\n":
        n = n - 1
    if n == len(s):
        return s
    i = 0
    t = ""
    while i < n:
        t = t + s[i]
        i = i + 1
    return t

def read_file(path):
    f = open(path)
    t = f.read()
    return t

def write_file(path, t):
    f = open(path, "w")
    f.write(t)

def have_cmd(name):
    r = os.run(["sh", "-c", "command -v " + name + " >/dev/null 2>&1"])
    return r[0] == 0

def passthru(r):
    os.write(1, r[1])
    os.write(2, r[2])
    return r[0]

def run_script(path):
    r = os.run([path])
    passthru(r)
    if r[0] == 0:
        return 0
    return 1

def glob_dir(dir, suffix):
    out = []
    for n in sorted(os.listdir(dir)):
        if n.endswith(suffix):
            out.append(dir + "/" + n)
    return out

def item_wanted(name, only, inner):
    if inner != 0 and name == "t_forge_run_tests":
        return 0
    if only == "":
        return 1
    pad = " " + only + " "
    if pad.find(" " + name + " ") >= 0:
        return 1
    return 0

